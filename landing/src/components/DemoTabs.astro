<script>
  const TYPING_MS = 1200;
  const MSG_GAP   = 700;

  // Track pending timeouts so we can cancel them when switching tabs
  let pendingTimeouts: ReturnType<typeof setTimeout>[] = [];

  function scrollIfNeeded(chatBody: HTMLElement, el: HTMLElement) {
    const bodyBottom = chatBody.scrollTop + chatBody.clientHeight;
    const elBottom   = el.offsetTop + el.offsetHeight;
    if (elBottom > bodyBottom - 16) {
      // Long message (taller than 55% of chat area) → scroll to TOP of message
      if (el.offsetHeight > chatBody.clientHeight * 0.55) {
        chatBody.scrollTop = Math.max(0, el.offsetTop - 20);
      } else {
        chatBody.scrollTop = elBottom - chatBody.clientHeight + 16;
      }
    }
  }

  function animateChat(panel: HTMLElement) {
    // Cancel every pending timeout from any previous animation run
    pendingTimeouts.forEach(clearTimeout);
    pendingTimeouts = [];

    const chatBody = panel.querySelector<HTMLElement>('.chat-body');
    if (!chatBody) return;

    // Remove leftover typing indicators and hide all messages (display:none → no space taken)
    chatBody.querySelectorAll('.typing-indicator').forEach(el => el.remove());
    const msgs = Array.from(chatBody.querySelectorAll<HTMLElement>('.chat-msg'));
    msgs.forEach(m => m.classList.remove('msg-visible'));
    // Safe to reset scroll now: hidden messages take no space, content height ≈ 0
    chatBody.scrollTop = 0;

    let t = 300;

    msgs.forEach((msg, i) => {
      const isAI       = !!msg.querySelector('.avatar-ai');
      const prevIsUser = i > 0 && !!msgs[i - 1].querySelector('.avatar-user');

      if (isAI && prevIsUser) {
        const showAt   = t;
        const revealAt = t + TYPING_MS;

        pendingTimeouts.push(setTimeout(() => {
          const ind = document.createElement('div');
          ind.className = 'typing-indicator';
          ind.innerHTML = `<div class="chat-avatar avatar-ai">AI</div>
            <div class="typing-dots">
              <div class="typing-dot"></div><div class="typing-dot"></div><div class="typing-dot"></div>
            </div>`;
          chatBody.insertBefore(ind, msg);
          scrollIfNeeded(chatBody, ind);
        }, showAt));

        pendingTimeouts.push(setTimeout(() => {
          chatBody.querySelectorAll('.typing-indicator').forEach(el => el.remove());
          msg.classList.add('msg-visible');
          scrollIfNeeded(chatBody, msg);
        }, revealAt));

        t = revealAt + MSG_GAP + 150;
      } else {
        pendingTimeouts.push(setTimeout(() => {
          msg.classList.add('msg-visible');
          scrollIfNeeded(chatBody, msg);
        }, t));
        t += MSG_GAP;
      }
    });
  }

  // Tab switching
  document.querySelectorAll<HTMLButtonElement>('.tab-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const id = btn.dataset.tab!;
      document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
      document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
      btn.classList.add('active');
      const panel = document.getElementById('tab-' + id)!;
      panel.classList.add('active');
      animateChat(panel);
    });
  });

  // Animate the first active tab on page load
  // Handle both cases: script runs before or after DOMContentLoaded
  function initFirstTab() {
    const first = document.querySelector<HTMLElement>('.tab-panel.active');
    if (first) animateChat(first);
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFirstTab);
  } else {
    initFirstTab();
  }
</script>
