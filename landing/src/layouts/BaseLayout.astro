---
export interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'Semantix — Hỏi Dữ Liệu Bằng Tiếng Việt, Nhận Kết Quả Ngay Lập Tức',
  description = 'Semantix là nền tảng AI phân tích dữ liệu cho doanh nghiệp Việt Nam. Kết nối database, hỏi bằng ngôn ngữ tự nhiên, nhận biểu đồ và insight tức thì — không cần SQL.',
} = Astro.props;
const path = Astro.url.pathname;
---
<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/styles/global.css" />
</head>
<body>

<!-- NAV -->
<nav>
  <div class="nav-inner">
    <a href="/" class="logo">
      <div class="logo-icon">
        <svg viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M9 2L15 5.5V12.5L9 16L3 12.5V5.5L9 2Z" fill="white" fill-opacity="0.9"/>
          <path d="M9 6L12 7.5V10.5L9 12L6 10.5V7.5L9 6Z" fill="white" fill-opacity="0.5"/>
        </svg>
      </div>
      <span class="logo-text">Semantix</span>
    </a>
    <ul class="nav-links">
      <li><a href="/solutions" class={path.startsWith('/solutions') ? 'nav-active' : ''}>Giải Pháp</a></li>
      <li><a href="/pricing"   class={path.startsWith('/pricing')   ? 'nav-active' : ''}>Bảng Giá</a></li>
      <li><a href="/blog"      class={path.startsWith('/blog')      ? 'nav-active' : ''}>Blog</a></li>
      <li><a href="/about"     class={path.startsWith('/about')     ? 'nav-active' : ''}>Về Chúng Tôi</a></li>
      <li><a href="/docs">Tài Liệu</a></li>
    </ul>
    <div class="nav-cta">
      <a href="/" class="btn btn-ghost" style="font-size:13px">Demo</a>
      <a href="/pricing" class="btn btn-primary">Dùng Thử Miễn Phí</a>
    </div>
  </div>
</nav>

<!-- BACK TO TOP -->
<button id="back-to-top" title="Lên đầu trang"
  style="position:fixed;bottom:28px;right:28px;z-index:200;width:44px;height:44px;border-radius:50%;
         background:var(--primary);color:white;border:none;cursor:pointer;box-shadow:0 4px 16px rgba(79,70,229,.4);
         display:flex;align-items:center;justify-content:center;opacity:0;pointer-events:none;
         transition:opacity .25s,transform .25s;transform:translateY(8px)">
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="18 15 12 9 6 15"/></svg>
</button>

<slot />

<!-- FOOTER -->
<footer>
  <div class="footer-grid">
    <div class="footer-brand">
      <a href="/" class="logo">
        <div class="logo-icon">
          <svg viewBox="0 0 18 18" fill="none"><path d="M9 2L15 5.5V12.5L9 16L3 12.5V5.5L9 2Z" fill="white" fill-opacity="0.9"/><path d="M9 6L12 7.5V10.5L9 12L6 10.5V7.5L9 6Z" fill="white" fill-opacity="0.5"/></svg>
        </div>
        <span class="logo-text">Semantix</span>
      </a>
      <div class="footer-tagline">Nền tảng AI phân tích dữ liệu cho doanh nghiệp Việt Nam. Hỏi bằng tiếng Việt — nhận kết quả ngay.</div>
    </div>
    <div class="footer-col">
      <h4>Sản Phẩm</h4>
      <ul>
        <li><a href="/solutions">Giải Pháp</a></li>
        <li><a href="/pricing">Bảng Giá</a></li>
        <li><a href="/about">Về Chúng Tôi</a></li>
        <li><a href="/docs/vi/free-trial/">Dùng Thử Miễn Phí</a></li>
      </ul>
    </div>
    <div class="footer-col">
      <h4>Tài Nguyên</h4>
      <ul>
        <li><a href="/blog">Blog</a></li>
        <li><a href="/docs/vi/getting-started/">Tài Liệu</a></li>
        <li><a href="/docs/vi/support/faqs.html">FAQ</a></li>
        <li><a href="mailto:hello@semantix.vn">Liên Hệ</a></li>
      </ul>
    </div>
    <div class="footer-col">
      <h4>Kết Nối</h4>
      <ul>
        <li><a href="mailto:hello@semantix.vn">hello@semantix.vn</a></li>
        <li><a href="#">Zalo OA</a></li>
        <li><a href="#">LinkedIn</a></li>
        <li><a href="#">Chính sách bảo mật</a></li>
      </ul>
    </div>
  </div>
  <div class="footer-bottom">
    <span>© 2025 Semantix. All rights reserved.</span>
    <span>Made in Vietnam 🇻🇳</span>
  </div>
</footer>

<script>
  // Back to top
  const topBtn = document.getElementById('back-to-top')!;
  topBtn.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
  window.addEventListener('scroll', () => {
    const show = window.scrollY > 400;
    topBtn.style.opacity       = show ? '1' : '0';
    topBtn.style.pointerEvents = show ? 'auto' : 'none';
    topBtn.style.transform     = show ? 'translateY(0)' : 'translateY(8px)';
  });

  // Nav active highlight
  const sections = document.querySelectorAll<HTMLElement>('section[id]');
  const navLinks  = document.querySelectorAll<HTMLAnchorElement>('.nav-links a[href^="#"]');
  const secObserver = new IntersectionObserver(entries => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        navLinks.forEach(link => {
          const active = link.getAttribute('href') === '#' + entry.target.id;
          link.style.color      = active ? 'var(--dark)' : '';
          link.style.background = active ? 'var(--surface)' : '';
        });
      }
    });
  }, { rootMargin: '-30% 0px -65% 0px' });
  sections.forEach(s => secObserver.observe(s));

  // Scroll fade-in (cards, steps)
  const fadeEls = document.querySelectorAll<HTMLElement>('.feature-card, .comp-card, .testimonial, .step');
  const fadeObs = new IntersectionObserver(entries => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        (entry.target as HTMLElement).style.opacity   = '1';
        (entry.target as HTMLElement).style.transform = 'translateY(0)';
        fadeObs.unobserve(entry.target);
      }
    });
  }, { threshold: 0.1 });
  fadeEls.forEach(el => {
    el.style.opacity    = '0';
    el.style.transform  = 'translateY(20px)';
    el.style.transition = 'opacity .5s ease, transform .5s ease';
    fadeObs.observe(el);
  });
</script>

</body>
</html>
