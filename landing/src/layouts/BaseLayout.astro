---
import { SITE_NAME, ORG, DEFAULT_OG_IMAGE, DOCS_URL } from '../consts';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  jsonLd?: Record<string, any>[];
}
const {
  title = 'Tuấn LA Lab — Data & AI cho người Việt',
  description = 'Tuấn LA Lab — nơi Lê Anh Tuấn gỡ từng khái niệm data cho dân công sở Việt bằng chuyện thật, và xây Semantix để biến tư duy đó thành công cụ.',
  image = DEFAULT_OG_IMAGE,
  type = 'website',
  jsonLd = [],
} = Astro.props;
const path = Astro.url.pathname;

// SEO: canonical + OG image cần origin tuyệt đối (đặt `site` trong astro.config.mjs).
const site = Astro.site ?? new URL('https://semantix.vn');
const canonical = new URL(path, site).href;
const ogImage = new URL(image, site).href;

// JSON-LD nền cho mọi trang. Trang con truyền thêm (Article/Breadcrumb…) qua prop `jsonLd`.
const allLd: Record<string, any>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: ORG.name,
    url: site.href,
    logo: new URL(ORG.logo, site).href,
    email: ORG.email,
    ...(ORG.sameAs.length ? { sameAs: ORG.sameAs } : {}),
  },
  { '@context': 'https://schema.org', '@type': 'WebSite', name: SITE_NAME, url: site.href, inLanguage: 'vi-VN' },
  ...jsonLd,
];
---
<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta name="robots" content="index,follow" />
  <link rel="alternate" type="application/rss+xml" title="Tuấn LA Lab — Blog" href="/rss.xml" />

  <!-- Open Graph -->
  <meta property="og:type" content={type} />
  <meta property="og:site_name" content={SITE_NAME} />
  <meta property="og:locale" content="vi_VN" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/styles/global.css" />

  {allLd.map((obj) => (
    <script type="application/ld+json" is:inline set:html={JSON.stringify(obj)} />
  ))}
</head>
<body>

<!-- NAV -->
<nav>
  <div class="nav-inner">
    <a href="/" class="logo">
      <div class="logo-icon"><span class="logo-mono">LA</span></div>
      <span class="logo-text">Tuấn <span style="color:var(--primary)">LA</span> Lab</span>
    </a>
    <button class="nav-toggle" id="nav-toggle" type="button" aria-label="Mở menu" aria-expanded="false" aria-controls="nav-menu">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
    </button>
    <div class="nav-menu" id="nav-menu">
      <ul class="nav-links">
        <li><a href="/blog"      class={path.startsWith('/blog')      ? 'nav-active' : ''}>Blog</a></li>
        <li><a href="/video"     class={path.startsWith('/video')     ? 'nav-active' : ''}>Video</a></li>
        <li><a href="/semantix"  class={path.startsWith('/semantix') || path.startsWith('/solutions') || path.startsWith('/pricing') ? 'nav-active' : ''}>Semantix</a></li>
        <li><a href="/about"     class={path.startsWith('/about')     ? 'nav-active' : ''}>Về Mình</a></li>
        <li><a href={DOCS_URL} target="_blank" rel="noopener">Tài Liệu</a></li>
      </ul>
      <div class="nav-cta">
        <a href="/video" class="btn btn-ghost" style="font-size:13px">Xem Video</a>
        <a href="/semantix" class="btn btn-primary">Dùng Thử Semantix</a>
      </div>
    </div>
  </div>
</nav>

<!-- BACK TO TOP -->
<button id="back-to-top" title="Lên đầu trang"
  style="position:fixed;bottom:28px;right:28px;z-index:200;width:44px;height:44px;border-radius:50%;
         background:var(--primary);color:white;border:none;cursor:pointer;box-shadow:0 4px 16px rgba(120,58,191,.4);
         display:flex;align-items:center;justify-content:center;opacity:0;pointer-events:none;
         transition:opacity .25s,transform .25s;transform:translateY(8px)">
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="18 15 12 9 6 15"/></svg>
</button>

<slot />

<!-- FOOTER -->
<footer>
  <div class="footer-grid">
    <div class="footer-brand">
      <a href="/" class="logo">
        <div class="logo-icon"><span class="logo-mono">LA</span></div>
        <span class="logo-text">Tuấn LA Lab</span>
      </a>
      <div class="footer-tagline">Data &amp; AI cho người Việt. Mỗi tuần một khái niệm data — gỡ gọn bằng chuyện thật. Bởi Lê Anh Tuấn.</div>
    </div>
    <div class="footer-col">
      <h4>Nội Dung</h4>
      <ul>
        <li><a href="/blog">Blog</a></li>
        <li><a href="/video">Video</a></li>
        <li><a href="/blog/tu-dien-thuat-ngu">Từ điển thuật ngữ</a></li>
      </ul>
    </div>
    <div class="footer-col">
      <h4>Semantix (sản phẩm)</h4>
      <ul>
        <li><a href="/semantix">Giới thiệu</a></li>
        <li><a href="/pricing">Bảng Giá</a></li>
        <li><a href={DOCS_URL} target="_blank" rel="noopener">Tài Liệu</a></li>
        <li><a href="/docs/vi/free-trial/">Dùng Thử</a></li>
      </ul>
    </div>
    <div class="footer-col">
      <h4>Kết Nối</h4>
      <ul>
        <li><a href="https://www.youtube.com/@mastergoogletools" target="_blank" rel="noopener">YouTube</a></li>
        <li><a href="/rss.xml" target="_blank" rel="noopener">RSS</a></li>
        <li><a href="mailto:hello@semantix.vn">hello@semantix.vn</a></li>
        <li><a href="#">Zalo OA</a></li>
        <li><a href="/about">Về mình</a></li>
      </ul>
    </div>
  </div>
  <div class="footer-bottom">
    <span>© 2026 Tuấn LA Lab · Lê Anh Tuấn.</span>
    <span>Made in Vietnam 🇻🇳</span>
  </div>
</footer>

<script>
  // Back to top
  const topBtn = document.getElementById('back-to-top')!;
  topBtn.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
  window.addEventListener('scroll', () => {
    const show = window.scrollY > 400;
    topBtn.style.opacity       = show ? '1' : '0';
    topBtn.style.pointerEvents = show ? 'auto' : 'none';
    topBtn.style.transform     = show ? 'translateY(0)' : 'translateY(8px)';
  });

  // Nav active highlight
  const sections = document.querySelectorAll<HTMLElement>('section[id]');
  const navLinks  = document.querySelectorAll<HTMLAnchorElement>('.nav-links a[href^="#"]');
  const secObserver = new IntersectionObserver(entries => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        navLinks.forEach(link => {
          const active = link.getAttribute('href') === '#' + entry.target.id;
          link.style.color      = active ? 'var(--dark)' : '';
          link.style.background = active ? 'var(--surface)' : '';
        });
      }
    });
  }, { rootMargin: '-30% 0px -65% 0px' });
  sections.forEach(s => secObserver.observe(s));

  // Scroll fade-in (cards, steps)
  const fadeEls = document.querySelectorAll<HTMLElement>('.feature-card, .comp-card, .testimonial, .step');
  const fadeObs = new IntersectionObserver(entries => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        (entry.target as HTMLElement).style.opacity   = '1';
        (entry.target as HTMLElement).style.transform = 'translateY(0)';
        fadeObs.unobserve(entry.target);
      }
    });
  }, { threshold: 0.1 });
  fadeEls.forEach(el => {
    el.style.opacity    = '0';
    el.style.transform  = 'translateY(20px)';
    el.style.transition = 'opacity .5s ease, transform .5s ease';
    fadeObs.observe(el);
  });

  // Mobile menu (hamburger) toggle
  const navEl = document.querySelector('nav');
  const navToggle = document.getElementById('nav-toggle');
  const closeMenu = () => {
    navEl?.classList.remove('open');
    navToggle?.setAttribute('aria-expanded', 'false');
  };
  navToggle?.addEventListener('click', () => {
    const open = navEl?.classList.toggle('open') ?? false;
    navToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
  });
  document.querySelectorAll('#nav-menu a').forEach(a => a.addEventListener('click', closeMenu));
  window.addEventListener('keydown', e => { if (e.key === 'Escape') closeMenu(); });
  window.addEventListener('resize', () => { if (window.innerWidth > 768) closeMenu(); });
</script>

</body>
</html>
