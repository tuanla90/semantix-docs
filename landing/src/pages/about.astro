---
import BaseLayout from '../layouts/BaseLayout.astro';

const YT = 'https://www.youtube.com/@mastergoogletools';

// Niềm tin nghề - rút từ chính cách mình làm việc, không phải tính năng sản phẩm.
const beliefs = [
  {
    icon: `<svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="#783ABF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>`,
    title: 'Đừng tin số đứng một mình',
    desc: 'Một con số đứng một mình thì chưa nói lên gì. Chưa rõ tính kiểu nào, lọc ra sao, dữ liệu đã sạch chưa, kiểu gì cũng có người hiểu sai. Mình nghĩ việc của dân data không phải bê số ra, mà là gắn lại ngữ cảnh đằng sau nó.',
  },
  {
    icon: `<svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="#783ABF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>`,
    title: 'Cứ làm cái đơn giản trước',
    desc: 'Hồi mới vào nghề mình hay sính mô hình phức tạp cho đẹp vài phần trăm. Một anh sếp cũ chỉ cho một câu: rule đơn giản với đủ dữ liệu là đã đúng chín mươi phần trăm rồi. Từ đó mình luôn bắt đầu bằng cái dễ hiểu nhất.',
  },
  {
    icon: `<svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="#783ABF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>`,
    title: 'Công cụ cũ vẫn có chỗ hay',
    desc: 'Excel, Power BI, Superset, mình mê và xài chán chê từng cái. Nên mình không dìm chúng xuống để khen sản phẩm của mình. Mình giữ lại chỗ chúng làm tốt, chỉ tự xây đúng phần còn thiếu.',
  },
  {
    icon: `<svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="#783ABF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>`,
    title: 'Dạy được mới là hiểu thật',
    desc: 'Mình xuất thân đi dạy. Giải thích một khái niệm cho người ngoài ngành mà họ gật đầu, lúc đó mình mới chắc là mình hiểu. Blog và video của mình đều ra đời từ phép thử đó.',
  },
];

// Hành trình nghề - mốc & thành tích thật (đã được user đồng ý nêu tên công ty).
const milestones = [
  { year: 'Khởi đầu', text: 'Dân sư phạm: dạy Vật lý lớp 12 (100% học sinh đỗ tốt nghiệp) và lập CLB Guitar ở ĐH Sư phạm Hà Nội. Mê chuyện "giải thích cho người khác hiểu" - thứ theo mình tới tận giờ.' },
  { year: 'BigSchool', text: 'Từ Business Analyst lên COO: quản team sản phẩm 30 người, dựng hạ tầng dữ liệu & báo cáo bằng Google Sheets + SQL, cải tiến quy trình +200%, tự động hoá báo cáo tiết kiệm 25 giờ/tháng. Đây cũng là gốc của kênh Master Google Tools.' },
  { year: 'Viettel', text: 'Rẽ hẳn sang dữ liệu (Data Analyst / Data Science): xây Data Mining Platform, hệ AntiSpam và AI-targeted Marketing, fraud detection bằng ML; góp phần xây Viettel User Profile System - hàng nghìn đặc trưng cho 65 triệu người dùng; dựng hệ BI tự động cho Viettel Construction, tiết kiệm tối thiểu 1 triệu USD/năm. Đào tạo Scala/Spark & SQL/Metabase cho gần 100 nhân sự.' },
  { year: 'Teko', text: 'Trưởng nhóm BI / Data Stewards trong hệ sinh thái VNLIFE-VNPAY. Mình làm Project Owner hệ Tracking tự dựng (kiểu Google Tag Manager): báo cáo từ hệ này khớp số đơn hàng ở backend khoảng 98%, trong khi Google Analytics và các nền tảng quảng cáo chỉ khớp tầm 60% khi đo đa kênh. Nhờ vậy team biết chính xác kênh nào thật sự mang về đơn, thay vì tin con số mà mỗi nền tảng tự nhận về mình. Cùng đó là hệ kiểm tra data quality và tự động hoá ETL giúp dựng kho dữ liệu nhanh gấp 30 lần. Ở vai trò DA, mình hỗ trợ thêm cho Customer Data Platform và Datamart của VNPAY. Báo cáo full-funnel bằng Growth Accounting, Cohort, RFM, HEART.' },
  { year: 'Hôm nay', text: 'Trưởng nhóm BI ở một ngân hàng - đang POC semantic layer, đúng hạt giống của Semantix. Song song: kênh Master Google Tools, tư vấn chuyển đổi số cho SME (Google Sheets → AppSheet → Nocobase), và tự tay xây Semantix.' },
];

// Đi dạy - hồ sơ công khai, nêu thẳng tên + link làm bảo chứng.
const teaching = [
  { place: 'Vietmoz', course: 'GA4 Advanced', href: 'https://vietmoz.edu.vn/ga4-advanced/' },
  { place: 'MCI Vietnam', course: 'BI với Google Workspace', href: 'https://www.mcivietnam.com/course-detail/khoa-hoc-business-intelligence-with-google-workspace-advanced-track/' },
  { place: 'Gitiho', course: 'App quản lý chi tiêu tích hợp AI', href: 'https://gitiho.com/khoa-hoc/tao-app-quan-ly-chi-tieu-chuyen-nghiep-tich-hop-ai-chatbot' },
  { place: 'gpems', course: 'BigQuery thực chiến: From Zero to Hero', href: 'https://gpems.net/course/khoa-hoc-bigquery-thuc-chien-from-zero-to-hero-81' },
];
---
<BaseLayout title="Về mình - Lê Anh Tuấn · Tuấn LA Lab" description="Mình là Lê Anh Tuấn - gần 10 năm làm dữ liệu & tự động hoá tại BigSchool, Viettel, Teko; nay trưởng nhóm BI ngân hàng. Đây là hành trình nghề, niềm tin, và lý do mình xây Semantix.">

<style>
  .page-hero { padding: 120px 24px 72px; background: linear-gradient(160deg,#0F172A 0%,#2D1B4E 60%,#0F172A 100%); text-align: center; }
  .page-hero h1 { font-size: clamp(32px,4.5vw,52px); font-weight: 900; color: #fff; letter-spacing: -1.2px; line-height: 1.1; margin-bottom: 16px; }
  .page-hero p  { font-size: 18px; color: #94A3B8; max-width: 620px; margin: 0 auto; line-height: 1.65; }

  /* Intro */
  .mission-section { padding: 96px 24px; background: var(--white); }
  .mission-inner { max-width: 900px; margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: start; }
  @media(max-width:720px){ .mission-inner { grid-template-columns: 1fr; gap: 48px; } }
  .mission-quote {
    font-size: clamp(22px, 2.6vw, 30px); font-weight: 800; color: var(--dark);
    letter-spacing: -0.6px; line-height: 1.3;
    border-left: 4px solid var(--primary); padding-left: 24px;
  }
  .mission-body { font-size: 15.5px; color: var(--muted); line-height: 1.75; }
  .mission-body p + p { margin-top: 16px; }

  /* Stats bar */
  .stats-bar { background: var(--primary); padding: 40px 24px; }
  .stats-bar-inner { max-width: 900px; margin: 0 auto; display: flex; gap: 0; justify-content: space-around; flex-wrap: wrap; gap: 24px; }
  .stat-bar-item { text-align: center; }
  .stat-bar-num  { font-size: 36px; font-weight: 900; color: #fff; letter-spacing: -1px; }
  .stat-bar-label { font-size: 13px; color: rgba(255,255,255,.7); margin-top: 4px; font-weight: 500; }

  /* Beliefs */
  .values-section { padding: 96px 24px; background: var(--surface); }
  .values-grid { max-width: 1000px; margin: 48px auto 0; display: grid; grid-template-columns: repeat(2,1fr); gap: 24px; }
  @media(max-width:640px){ .values-grid { grid-template-columns: 1fr; } }
  .value-card { background: var(--white); border: 1px solid var(--border); border-radius: 16px; padding: 28px; }
  .value-icon { margin-bottom: 14px; line-height: 0; }
  .value-icon svg { width: 30px; height: 30px; display: block; }
  .value-title { font-size: 17px; font-weight: 700; color: var(--dark); margin-bottom: 10px; }
  .value-desc  { font-size: 14.5px; color: var(--muted); line-height: 1.65; }

  /* Timeline */
  .timeline-section { padding: 96px 24px; background: var(--white); }
  .timeline { max-width: 700px; margin: 48px auto 0; display: flex; flex-direction: column; gap: 0; }
  .tl-item { display: grid; grid-template-columns: 84px 1fr; column-gap: 32px; padding-bottom: 36px; position: relative; }
  .tl-item:last-child { padding-bottom: 0; }
  .tl-item:not(:last-child)::before {
    content: ''; position: absolute; left: 97px; top: 11px; bottom: -2px;
    width: 2px; background: var(--border);
  }
  .tl-year { font-size: 13px; font-weight: 800; color: var(--primary); padding-top: 3px; text-align: right; white-space: nowrap; }
  .tl-dot {
    width: 12px; height: 12px; border-radius: 50%; background: var(--primary);
    border: 2px solid var(--white); box-shadow: 0 0 0 2px var(--primary);
    position: absolute; left: 92px; top: 4px;
  }
  .tl-text { font-size: 15px; color: var(--dark-2); line-height: 1.72; padding-top: 1px; }

  /* Teaching */
  .teach-section { padding: 96px 24px; background: var(--surface); }
  .teach-sub { max-width: 660px; margin: 10px auto 0; text-align: center; font-size: 15.5px; color: var(--muted); line-height: 1.7; }
  .teach-sub a { color: var(--primary); font-weight: 600; text-decoration: none; }
  .teach-grid { max-width: 1000px; margin: 40px auto 0; display: grid; grid-template-columns: repeat(4,1fr); gap: 18px; }
  @media(max-width:820px){ .teach-grid { grid-template-columns: repeat(2,1fr); } }
  @media(max-width:480px){ .teach-grid { grid-template-columns: 1fr; } }
  .teach-card { display: flex; flex-direction: column; gap: 6px; padding: 22px; border-radius: 14px; background: var(--white); border: 1px solid var(--border); text-decoration: none; transition: box-shadow .2s, transform .2s; }
  .teach-card:hover { box-shadow: 0 10px 28px rgba(120,58,191,.12); transform: translateY(-3px); }
  .teach-place { font-size: 16px; font-weight: 800; color: var(--dark); }
  .teach-course { font-size: 13.5px; color: var(--muted); line-height: 1.55; flex: 1; }
  .teach-go { font-size: 13px; font-weight: 600; color: var(--primary); margin-top: 6px; }

  /* Semantix */
  .founder-section { padding: 96px 24px; background: var(--white); }
  .founder-card {
    max-width: 700px; margin: 40px auto 0;
    background: var(--surface); border: 1px solid var(--border); border-radius: 20px;
    padding: 36px;
  }
  .founder-bio  { font-size: 15.5px; color: var(--dark-2); line-height: 1.75; }
  .founder-bio + .founder-bio { margin-top: 14px; }
  .founder-bio a { color: var(--primary); font-weight: 700; text-decoration: none; }
  .founder-bio a:hover { text-decoration: underline; }

  /* CTA */
  .about-cta { padding: 80px 24px; background: linear-gradient(135deg, var(--primary-dark), #2D1B4E); text-align: center; }
  .about-cta h2 { font-size: clamp(26px,3.5vw,40px); font-weight: 800; color: var(--white); letter-spacing: -0.8px; margin-bottom: 14px; }
  .about-cta p  { font-size: 17px; color: #94A3B8; margin-bottom: 36px; }
</style>

<!-- Hero -->
<div class="page-hero">
  <div class="badge" style="margin-bottom:20px"><span class="badge-dot"></span>Lê Anh Tuấn · Tuấn LA Lab</div>
  <h1>Hơn 10 năm mình đọc số<br/>để biết chỗ nào đang hỏng</h1>
  <p>Từ nhân viên phân tích đến trưởng nhóm BI, mình tin một điều đơn giản: con số mà bỏ quên ngữ cảnh là rất dễ làm người ta hiểu sai. Trang này kể lại hành trình đó, và vì sao mình bắt tay xây Semantix.</p>
</div>

<!-- Intro -->
<section class="mission-section">
  <div class="mission-inner">
    <div>
      <div class="section-label" style="text-align:left">Mình là ai</div>
      <div class="mission-quote" style="margin-top:16px">
        "Con số trần trụi sẽ nói dối khi mình quên mất ngữ cảnh."
      </div>
    </div>
    <div class="mission-body">
      <p>Mình là <strong>Lê Anh Tuấn</strong> - gần 10 năm làm dữ liệu và tự động hoá, đi qua <strong>BigSchool</strong>, <strong>Viettel</strong> và <strong>Teko</strong>, giờ là trưởng nhóm BI ở một ngân hàng.</p>
      <p>Mình cũng dựng kênh <a href={YT} target="_blank" rel="noopener" style="color:var(--primary);font-weight:600">Master Google Tools</a> để chia sẻ cách làm chủ hệ Google - Sheets, Apps Script, AppSheet, Looker Studio, BigQuery, GA4 - và đi dạy ở vài nơi.</p>
      <p>Tất cả những năm đó dẫn mình tới một niềm tin nghề, và tới <strong>Semantix</strong> - công cụ mình đang tự xây. Trang này kể lại hành trình ấy.</p>
    </div>
  </div>
</section>

<!-- Stats bar -->
<div class="stats-bar">
  <div class="stats-bar-inner">
    <div class="stat-bar-item"><div class="stat-bar-num">10+</div><div class="stat-bar-label">năm trong nghề dữ liệu</div></div>
    <div class="stat-bar-item"><div class="stat-bar-num">3</div><div class="stat-bar-label">tập đoàn đã đi qua</div></div>
    <div class="stat-bar-item"><div class="stat-bar-num">4</div><div class="stat-bar-label">nơi đứng lớp dạy data</div></div>
    <div class="stat-bar-item"><div class="stat-bar-num">150+</div><div class="stat-bar-label">bài blog đã viết</div></div>
  </div>
</div>

<!-- Beliefs -->
<section class="values-section">
  <div class="section-label">Niềm Tin Nghề</div>
  <h2 class="section-title">Những điều mình tin</h2>
  <div class="values-grid">
    {beliefs.map(v => (
      <div class="value-card">
        <div class="value-icon" set:html={v.icon}></div>
        <div class="value-title">{v.title}</div>
        <div class="value-desc">{v.desc}</div>
      </div>
    ))}
  </div>
</section>

<!-- Timeline -->
<section class="timeline-section">
  <div class="section-label">Hành Trình</div>
  <h2 class="section-title">Hơn 10 năm sống với dữ liệu</h2>
  <div class="timeline">
    {milestones.map(m => (
      <div class="tl-item">
        <div class="tl-year">{m.year}</div>
        <div class="tl-dot"></div>
        <div class="tl-text">{m.text}</div>
      </div>
    ))}
  </div>
</section>

<!-- Teaching -->
<section class="teach-section">
  <div class="section-label">Dạy & Chia Sẻ</div>
  <h2 class="section-title">Không chỉ làm - mình còn đi dạy</h2>
  <p class="teach-sub">Kênh <a href={YT} target="_blank" rel="noopener">Master Google Tools</a> mỗi tuần một thủ thuật data, cùng các khoá mình đứng lớp:</p>
  <div class="teach-grid">
    {teaching.map(t => (
      <a href={t.href} target="_blank" rel="noopener" class="teach-card">
        <div class="teach-place">{t.place}</div>
        <div class="teach-course">{t.course}</div>
        <div class="teach-go">Xem khoá →</div>
      </a>
    ))}
  </div>
</section>

<!-- Semantix -->
<section class="founder-section">
  <div class="section-label">Sản Phẩm</div>
  <h2 class="section-title">Mình đang xây Semantix</h2>
  <div class="founder-card">
    <p class="founder-bio">Mình xài đủ các công cụ xịn nhất rồi mà vẫn thấy thiếu một mảnh cho doanh nghiệp Việt: người chủ muốn hỏi dữ liệu của chính mình thì cứ phải nhờ một người biết SQL ngồi giữa. <strong>Semantix</strong> là thứ mình đang xây để gỡ đúng chỗ đó: hỏi dữ liệu bằng tiếng Việt, có một <strong>semantic layer</strong> làm lõi để AI hiểu đúng ngữ cảnh, và chạy thẳng trên hạ tầng của bạn.</p>
    <p class="founder-bio">Sản phẩm còn trẻ và mình hoàn thiện nó mỗi tuần. <a href="/semantix">Xem Semantix →</a></p>
  </div>
</section>

<!-- CTA -->
<section class="about-cta">
  <h2>Đi cùng mình nhé</h2>
  <p>Mỗi tuần một khái niệm data. Đọc blog, xem video, hoặc thử công cụ mình đang xây.</p>
  <div class="cta-buttons">
    <a href="/blog" class="btn btn-white">Đọc blog</a>
    <a href={YT} target="_blank" rel="noopener" class="btn btn-ghost-white">Theo dõi kênh</a>
  </div>
</section>

</BaseLayout>
