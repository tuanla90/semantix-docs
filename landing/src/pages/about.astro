---
import BaseLayout from '../layouts/BaseLayout.astro';

const values = [
  {
    icon: '🎯',
    title: 'Dữ liệu cho mọi người',
    desc: 'Không chỉ data team. Tôi tin mọi người trong tổ chức — từ manager đến nhân viên sales — đều có quyền tự truy cập dữ liệu mà không phải phụ thuộc vào ai.',
  },
  {
    icon: '🔒',
    title: 'Dữ liệu không rời khỏi của bạn',
    desc: 'Semantix không lưu trữ dữ liệu kinh doanh của bạn. Truy vấn chạy trực tiếp trên database của bạn. Đây là nguyên tắc không thể thương lượng.',
  },
  {
    icon: '🌏',
    title: 'Xây cho thị trường Việt Nam',
    desc: 'Ngôn ngữ, nghiệp vụ, văn hóa doanh nghiệp Việt Nam là trọng tâm của Semantix — không phải một tool nước ngoài được Việt hóa bề ngoài.',
  },
  {
    icon: '⚡',
    title: 'Chất lượng qua tốc độ',
    desc: 'Một câu hỏi phải có câu trả lời trong vòng 5 giây. Nếu AI trả lời sai, tôi coi đó là lỗi cần sửa — không phải lý do để chấp nhận.',
  },
];

const milestones = [
  { year: '2024', text: 'Sau nhiều năm tư vấn BI cho doanh nghiệp vừa và nhỏ, tôi thấy rõ một khoảng trống: người chủ không tự hỏi được dữ liệu của chính mình nếu không có người biết SQL ngồi giữa — và không công cụ nào tôi từng dùng lấp được nó.' },
  { year: '2025', text: 'Quyết định tự xây Semantix. Đứng trên vai những engine tôi đã đi qua — Excel, Power BI, Superset — giữ lại điểm mạnh của từng cái, rồi đặt Semantic Layer làm lõi ngay từ dòng code đầu tiên.' },
  { year: '2026', text: 'Những khách hàng đầu tiên dùng thử với dữ liệu thật: hỏi bằng tiếng Việt, self-host trên hạ tầng của họ, đa nhà cung cấp AI (BYOK).' },
  { year: 'Hôm nay', text: 'Semantix còn trẻ. Tôi học từ mỗi người dùng mỗi tuần và hoàn thiện dần — hướng tới đúng một điều: để người chủ tự trả lời được câu hỏi của mình, không cần ai hỏi hộ.' },
];

const founder = {
  name: 'Lê Anh Tuấn',
  role: 'Người sáng lập Semantix',
  avatar: 'T',
};
---
<BaseLayout title="Về mình — Lê Anh Tuấn · Tuấn LA Lab" description="Mình là Lê Anh Tuấn, hơn 10 năm làm data — từ analyst đến trưởng nhóm BI. Đây là hành trình, niềm tin nghề, và lý do mình xây Semantix.">

<style>
  .page-hero { padding: 120px 24px 72px; background: linear-gradient(160deg,#0F172A 0%,#2D1B4E 60%,#0F172A 100%); text-align: center; }
  .page-hero h1 { font-size: clamp(32px,4.5vw,52px); font-weight: 900; color: #fff; letter-spacing: -1.2px; line-height: 1.1; margin-bottom: 16px; }
  .page-hero p  { font-size: 18px; color: #94A3B8; max-width: 600px; margin: 0 auto; line-height: 1.65; }

  /* Mission */
  .mission-section { padding: 96px 24px; background: var(--white); }
  .mission-inner { max-width: 900px; margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: start; }
  @media(max-width:720px){ .mission-inner { grid-template-columns: 1fr; gap: 48px; } }
  .mission-quote {
    font-size: clamp(22px, 2.6vw, 30px); font-weight: 800; color: var(--dark);
    letter-spacing: -0.6px; line-height: 1.3;
    border-left: 4px solid var(--primary); padding-left: 24px;
  }
  .mission-body { font-size: 15.5px; color: var(--muted); line-height: 1.75; }
  .mission-body p + p { margin-top: 16px; }

  /* Stats bar */
  .stats-bar { background: var(--primary); padding: 40px 24px; }
  .stats-bar-inner { max-width: 900px; margin: 0 auto; display: flex; gap: 0; justify-content: space-around; flex-wrap: wrap; gap: 24px; }
  .stat-bar-item { text-align: center; }
  .stat-bar-num  { font-size: 36px; font-weight: 900; color: #fff; letter-spacing: -1px; }
  .stat-bar-label { font-size: 13px; color: rgba(255,255,255,.65); margin-top: 4px; font-weight: 500; }

  /* Values */
  .values-section { padding: 96px 24px; background: var(--surface); }
  .values-grid { max-width: 1000px; margin: 48px auto 0; display: grid; grid-template-columns: repeat(2,1fr); gap: 24px; }
  @media(max-width:640px){ .values-grid { grid-template-columns: 1fr; } }
  .value-card { background: var(--white); border: 1px solid var(--border); border-radius: 16px; padding: 28px; }
  .value-icon { font-size: 28px; margin-bottom: 14px; }
  .value-title { font-size: 17px; font-weight: 700; color: var(--dark); margin-bottom: 10px; }
  .value-desc  { font-size: 14.5px; color: var(--muted); line-height: 1.65; }

  /* Timeline */
  .timeline-section { padding: 96px 24px; background: var(--white); }
  .timeline { max-width: 640px; margin: 48px auto 0; display: flex; flex-direction: column; gap: 0; }
  .tl-item { display: grid; grid-template-columns: 64px 1fr; column-gap: 36px; padding-bottom: 36px; position: relative; }
  .tl-item:last-child { padding-bottom: 0; }
  .tl-item:not(:last-child)::before {
    content: ''; position: absolute; left: 81px; top: 11px; bottom: -2px;
    width: 2px; background: var(--border);
  }
  .tl-year { font-size: 13px; font-weight: 800; color: var(--primary); padding-top: 3px; text-align: right; white-space: nowrap; }
  .tl-dot {
    width: 12px; height: 12px; border-radius: 50%; background: var(--primary);
    border: 2px solid var(--white); box-shadow: 0 0 0 2px var(--primary);
    position: absolute; left: 76px; top: 4px;
  }
  .tl-text { font-size: 15px; color: var(--dark-2); line-height: 1.72; padding-top: 1px; }

  /* Founder */
  .founder-section { padding: 96px 24px; background: var(--surface); }
  .founder-card {
    max-width: 640px; margin: 48px auto 0;
    background: var(--white); border: 1px solid var(--border); border-radius: 20px;
    padding: 36px; display: flex; gap: 28px; align-items: flex-start;
  }
  @media(max-width:560px){
    .founder-card { flex-direction: column; align-items: center; text-align: center; gap: 20px; padding: 28px; }
  }
  .founder-avatar {
    flex-shrink: 0; width: 80px; height: 80px; border-radius: 50%;
    background: #F3EDFB; color: #783ABF; font-size: 30px; font-weight: 800;
    display: flex; align-items: center; justify-content: center;
  }
  .founder-name { font-size: 20px; font-weight: 800; color: var(--dark); letter-spacing: -0.4px; }
  .founder-role { font-size: 14px; color: var(--primary); font-weight: 600; margin: 4px 0 14px; }
  .founder-bio  { font-size: 14.5px; color: var(--muted); line-height: 1.7; }
  .founder-bio + .founder-bio { margin-top: 12px; }
  .founder-bio a { color: var(--primary); font-weight: 600; text-decoration: none; border-bottom: 1px solid var(--border); }
  .founder-bio a:hover { border-bottom-color: var(--primary); }

  /* CTA */
  .about-cta { padding: 80px 24px; background: linear-gradient(135deg, var(--primary-dark), #2D1B4E); text-align: center; }
  .about-cta h2 { font-size: clamp(26px,3.5vw,40px); font-weight: 800; color: var(--white); letter-spacing: -0.8px; margin-bottom: 14px; }
  .about-cta p  { font-size: 17px; color: #94A3B8; margin-bottom: 36px; }
</style>

<!-- Hero -->
<div class="page-hero">
  <div class="badge" style="margin-bottom:20px"><span class="badge-dot"></span>Lê Anh Tuấn · Tuấn LA Lab</div>
  <h1>Hơn 10 năm mình đọc số<br/>để biết chỗ nào đang hỏng</h1>
  <p>Từ analyst đến trưởng nhóm BI, mình tin một điều: con số trần trụi sẽ nói dối khi ta quên mất ngữ cảnh. Đây là hành trình, niềm tin nghề, và lý do mình xây Semantix.</p>
</div>

<!-- Mission -->
<section class="mission-section">
  <div class="mission-inner">
    <div>
      <div class="section-label" style="text-align:left">Sứ Mệnh</div>
      <div class="mission-quote" style="margin-top:16px">
        "Đưa sức mạnh của dữ liệu đến tay mọi người trong tổ chức Việt Nam."
      </div>
    </div>
    <div class="mission-body">
      <p>Suốt nhiều năm tư vấn dữ liệu cho doanh nghiệp Việt, tôi thấy đi thấy lại cùng một vòng lặp: <strong>câu hỏi của người chủ → nhờ người biết SQL → chờ → nhận lại con số đã cũ</strong>. Trong khi đó, quyết định kinh doanh không thể chờ.</p>
      <p>Vấn đề không phải thiếu dữ liệu. Vấn đề là AI không thể hiểu "doanh thu" của từng công ty có nghĩa khác nhau — và không có công cụ nào giúp định nghĩa điều đó một lần, dùng mãi.</p>
      <p>Semantix được xây dựng để giải quyết chính xác vấn đề đó — bằng một tầng định nghĩa nghiệp vụ gọi là <strong>Semantic Layer</strong>.</p>
    </div>
  </div>
</section>

<!-- Stats bar -->
<div class="stats-bar">
  <div class="stats-bar-inner">
    <div class="stat-bar-item"><div class="stat-bar-num">5s</div><div class="stat-bar-label">từ câu hỏi đến kết quả</div></div>
    <div class="stat-bar-item"><div class="stat-bar-num">10+</div><div class="stat-bar-label">nguồn dữ liệu kết nối</div></div>
    <div class="stat-bar-item"><div class="stat-bar-num">4+</div><div class="stat-bar-label">nhà cung cấp AI · BYOK</div></div>
    <div class="stat-bar-item"><div class="stat-bar-num">0</div><div class="stat-bar-label">byte dữ liệu lưu ngoài</div></div>
  </div>
</div>

<!-- Values -->
<section class="values-section">
  <div class="section-label">Giá Trị Cốt Lõi</div>
  <h2 class="section-title">Những điều tôi tin</h2>
  <div class="values-grid">
    {values.map(v => (
      <div class="value-card">
        <div class="value-icon">{v.icon}</div>
        <div class="value-title">{v.title}</div>
        <div class="value-desc">{v.desc}</div>
      </div>
    ))}
  </div>
</section>

<!-- Timeline -->
<section class="timeline-section">
  <div class="section-label">Hành Trình</div>
  <h2 class="section-title">Từ ý tưởng đến sản phẩm</h2>
  <div class="timeline">
    {milestones.map(m => (
      <div class="tl-item">
        <div class="tl-year">{m.year}</div>
        <div class="tl-dot"></div>
        <div class="tl-text">{m.text}</div>
      </div>
    ))}
  </div>
</section>

<!-- Founder -->
<section class="founder-section">
  <div class="section-label">Người Sáng Lập</div>
  <h2 class="section-title">Người xây Semantix</h2>
  <div class="founder-card">
    <div class="founder-avatar">{founder.avatar}</div>
    <div>
      <div class="founder-name">{founder.name}</div>
      <div class="founder-role">{founder.role}</div>
      <p class="founder-bio">
        10+ năm làm dữ liệu — từ analyst tại một tập đoàn viễn thông đầu ngành, trưởng nhóm Data Analyst tại một công ty công nghệ trong hệ sinh thái e-commerce, đến trưởng nhóm BI tại một ngân hàng. Giảng viên các khoá GA4, BI &amp; ứng dụng AI tại <a href="https://vietmoz.edu.vn/ga4-advanced/" target="_blank" rel="noopener">Vietmoz</a>, <a href="https://www.mcivietnam.com/course-detail/khoa-hoc-business-intelligence-with-google-workspace-advanced-track/" target="_blank" rel="noopener">MCI Vietnam</a> và <a href="https://gitiho.com/khoa-hoc/tao-app-quan-ly-chi-tieu-chuyen-nghiep-tich-hop-ai-chatbot" target="_blank" rel="noopener">Gitiho</a>.
      </p>
      <p class="founder-bio">Tôi xây Semantix một mình — để giải đúng cái bài toán tôi gặp mỗi ngày: giúp người chủ tự hỏi được dữ liệu của chính mình, không cần ai đứng giữa.</p>
    </div>
  </div>
</section>

<!-- CTA -->
<section class="about-cta">
  <h2>Đi cùng mình nhé</h2>
  <p>Mỗi tuần một khái niệm data. Đọc blog, xem video, hoặc thử công cụ mình đang xây.</p>
  <div class="cta-buttons">
    <a href="/blog" class="btn btn-white">Đọc blog</a>
    <a href="https://www.youtube.com/@mastergoogletools" target="_blank" rel="noopener" class="btn btn-ghost-white">Theo dõi kênh</a>
  </div>
</section>

</BaseLayout>
