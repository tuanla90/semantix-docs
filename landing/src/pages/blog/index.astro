---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const all = await getCollection('blog');

// Anchor each series at its FIRST part (Phần 1 = earliest date) so the series
// keeps its original position in the timeline, while parts read in order 1 → N.
const seriesAnchor = new Map<string, number>();
for (const p of all) {
  if (p.data.series) {
    const t = p.data.pubDate.valueOf();
    const cur = seriesAnchor.get(p.data.series);
    seriesAnchor.set(p.data.series, cur === undefined ? t : Math.min(cur, t));
  }
}
const sortKey = (p: typeof all[number]) =>
  p.data.series ? seriesAnchor.get(p.data.series)! : p.data.pubDate.valueOf();

const posts = all.sort((a, b) => {
  const ka = sortKey(a), kb = sortKey(b);
  if (kb !== ka) return kb - ka;                                   // newest first
  // Same series (shared anchor): order by part ascending
  return (a.data.seriesOrder ?? 0) - (b.data.seriesOrder ?? 0);
});

const featured = posts.filter(p => p.data.featured);
// "Tất cả bài viết" = every post (featured included), in the grouped order above.
const rest = posts;

const categories = [...new Set(posts.map(p => p.data.category))];

function formatDate(date: Date) {
  return date.toLocaleDateString('vi-VN', { day: '2-digit', month: '2-digit', year: 'numeric' });
}

// Chuỗi tìm kiếm không dấu (khớp được cả khi gõ thiếu dấu): title + mô tả + danh mục.
function searchKey(p: typeof all[number]) {
  return `${p.data.title} ${p.data.description} ${p.data.category}`
    .toLowerCase()
    .normalize('NFD').replace(/[̀-ͯ]/g, '')
    .replace(/đ/g, 'd');
}
---
<BaseLayout title="Blog — Semantix" description="Kiến thức thực chiến về Data Analytics, AI, và cách đưa dữ liệu vào quyết định kinh doanh cho doanh nghiệp Việt Nam.">

<style>
  .blog-hero { padding: 120px 24px 72px; background: linear-gradient(160deg,#0F172A 0%,#2D1B4E 60%,#0F172A 100%); text-align: center; }
  .blog-hero h1 { font-size: clamp(32px,4.5vw,52px); font-weight: 900; color: #fff; letter-spacing: -1.2px; line-height: 1.1; margin-bottom: 16px; }
  .blog-hero p  { font-size: 18px; color: #94A3B8; max-width: 540px; margin: 0 auto; }
  .glo-cta { display: inline-flex; align-items: center; gap: 6px; margin-top: 22px; padding: 9px 18px;
    border-radius: 100px; font-size: 14px; font-weight: 600; text-decoration: none; color: #DDD0F0;
    background: rgba(148,96,212,.15); border: 1px solid rgba(148,96,212,.3); transition: background .15s, color .15s; }
  .glo-cta:hover { background: rgba(148,96,212,.28); color: #fff; }

  .blog-body { max-width: 1180px; margin: 0 auto; padding: 56px 24px 96px; }

  .blog-sec-label { font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 1.5px; margin-bottom: 24px; text-align: left; }

  /* ===== Featured slider ===== */
  .featured-section { margin-bottom: 72px; }
  .featured-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 24px; }
  .featured-head .blog-sec-label { color: var(--primary); margin-bottom: 0; }
  .featured-nav { display: flex; gap: 8px; }
  .fnav {
    width: 38px; height: 38px; border-radius: 50%; border: 1px solid var(--border);
    background: var(--white); color: var(--dark-3); cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    transition: background .15s, color .15s, border-color .15s, opacity .15s;
  }
  .fnav:hover { background: var(--primary); border-color: var(--primary); color: #fff; }
  .fnav:disabled { opacity: .35; cursor: default; background: var(--white); color: var(--dark-3); border-color: var(--border); }

  .featured-track {
    display: flex; gap: 24px; overflow-x: auto; scroll-snap-type: x mandatory;
    scroll-behavior: smooth; padding: 4px 4px 16px; margin: -4px -4px 0;
    scrollbar-width: none;
  }
  .featured-track::-webkit-scrollbar { display: none; }

  .fslide {
    flex: 0 0 clamp(300px, 42%, 460px); scroll-snap-align: start;
    background: var(--white); border: 1px solid var(--border); border-radius: 20px;
    overflow: hidden; display: flex; flex-direction: column;
    text-decoration: none; transition: box-shadow .2s, transform .2s;
  }
  .fslide:hover { box-shadow: 0 16px 48px rgba(120,58,191,.14); transform: translateY(-4px); }
  .fslide-cover { position: relative; height: 200px; background: var(--surface); }
  .fslide-cover img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .fslide-body { padding: 22px 26px 26px; display: flex; flex-direction: column; gap: 10px; flex: 1; }
  .fslide-cat { font-size: 11px; font-weight: 700; color: var(--primary); text-transform: uppercase; letter-spacing: 1px; }
  .fslide-title { font-size: 21px; font-weight: 800; color: var(--dark); letter-spacing: -0.4px; line-height: 1.3; }
  .fslide-desc  { font-size: 14px; color: var(--muted); line-height: 1.65; flex: 1; }
  .fslide-meta  { display: flex; gap: 12px; align-items: center; padding-top: 14px; border-top: 1px solid var(--border); font-size: 12.5px; }
  .fslide-author { font-weight: 600; color: var(--dark-2); }
  .fslide-dot { color: var(--muted-light); }
  .fslide-read { color: var(--muted-light); margin-left: auto; }

  /* ===== All posts grid ===== */
  .posts-section .blog-sec-label { color: var(--muted); }
  .posts-grid {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(270px, 1fr));
    gap: 24px;
  }
  .post-card {
    background: var(--white); border: 1px solid var(--border); border-radius: 16px;
    overflow: hidden; display: flex; flex-direction: column;
    text-decoration: none; transition: box-shadow .2s, transform .2s, border-color .2s;
  }
  .post-card:hover { box-shadow: 0 12px 36px rgba(15,23,42,.10); transform: translateY(-3px); border-color: #DDD0F0; }
  .pc-cover { position: relative; height: 150px; background: var(--surface); }
  .pc-cover img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .pc-body { padding: 16px 20px 20px; display: flex; flex-direction: column; gap: 8px; flex: 1; }
  .pc-cat { font-size: 10.5px; font-weight: 700; color: var(--primary); text-transform: uppercase; letter-spacing: .8px; }
  .pc-title { font-size: 16.5px; font-weight: 700; color: var(--dark); line-height: 1.4; letter-spacing: -0.2px; }
  .pc-desc  { font-size: 13px; color: var(--muted); line-height: 1.6; flex: 1;
              display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .pc-meta  { display: flex; gap: 8px; align-items: center; padding-top: 12px; border-top: 1px solid var(--border); font-size: 11.5px; color: var(--muted-light); }
  .pc-dot   { color: var(--border); }

  .no-results { text-align: center; color: var(--muted); padding: 48px 0; font-size: 15px; display: none; }

  /* Search */
  .search-wrap { position: relative; max-width: 520px; margin-bottom: 16px; }
  .search-icon { position: absolute; left: 16px; top: 50%; transform: translateY(-50%); color: var(--muted-light); pointer-events: none; }
  #blog-search {
    width: 100%; padding: 13px 44px 13px 46px; border-radius: 12px;
    border: 1px solid var(--border); background: var(--white); color: var(--dark);
    font-size: 15px; font-family: inherit; outline: none;
    transition: border-color .15s, box-shadow .15s;
  }
  #blog-search::placeholder { color: var(--muted-light); }
  #blog-search:focus { border-color: var(--primary); box-shadow: 0 0 0 3px rgba(120,58,191,.12); }
  #blog-search::-webkit-search-cancel-button { display: none; }
  #blog-search-clear {
    position: absolute; right: 10px; top: 50%; transform: translateY(-50%);
    width: 28px; height: 28px; border: none; background: transparent; cursor: pointer;
    color: var(--muted-light); border-radius: 50%; display: flex; align-items: center; justify-content: center;
    transition: background .15s, color .15s;
  }
  #blog-search-clear:hover { background: var(--surface); color: var(--dark); }

  /* Categories */
  .categories-bar { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 40px; }
  .cat-chip {
    padding: 7px 16px; border-radius: 100px; font-size: 13px; font-weight: 600;
    background: var(--surface); border: 1px solid var(--border); color: var(--dark-3);
    cursor: pointer; transition: background .15s, color .15s, border-color .15s;
    font-family: inherit;
  }
  .cat-chip:hover { border-color: var(--primary); color: var(--primary); }
  .cat-chip.active { background: var(--primary); border-color: var(--primary); color: #fff; }

  /* Newsletter */
  .newsletter { background: var(--surface); border: 1px solid var(--border); border-radius: 20px; padding: 48px; text-align: center; margin-top: 72px; }
  .newsletter h3 { font-size: 22px; font-weight: 800; color: var(--dark); letter-spacing: -0.4px; margin-bottom: 10px; }
  .newsletter p  { font-size: 15px; color: var(--muted); margin-bottom: 28px; }
  .newsletter-form { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
  .newsletter-input {
    padding: 12px 20px; border-radius: 10px; border: 1px solid var(--border);
    font-size: 15px; width: 280px; background: var(--white); color: var(--dark);
    outline: none;
  }
  .newsletter-input:focus { border-color: var(--primary); }

  @media(max-width:640px){
    .fslide { flex: 0 0 84%; }
    .posts-grid { grid-template-columns: 1fr 1fr; gap: 16px; }
  }
  @media(max-width:440px){
    .posts-grid { grid-template-columns: 1fr; }
  }
</style>

<!-- Hero -->
<div class="blog-hero">
  <div class="badge" style="margin-bottom:20px"><span class="badge-dot"></span>Kiến Thức Thực Chiến</div>
  <h1>Blog Semantix</h1>
  <p>Data Analytics, AI, và cách đưa dữ liệu vào quyết định kinh doanh — viết cho người làm, không phải người nghiên cứu.</p>
  <a href="/blog/tu-dien-thuat-ngu/" class="glo-cta">📖 Từ điển thuật ngữ</a>
</div>

<div class="blog-body">

  <!-- Search -->
  <div class="search-wrap">
    <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
    <input id="blog-search" type="search" autocomplete="off" placeholder="Tìm bài viết theo tiêu đề, chủ đề… (gõ có dấu hay không đều được)" aria-label="Tìm bài viết" />
    <button id="blog-search-clear" type="button" aria-label="Xoá tìm kiếm" hidden>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
  </div>

  <!-- Category chips -->
  <div class="categories-bar">
    <button class="cat-chip active" data-cat="*" type="button">Tất cả</button>
    {categories.map(c => <button class="cat-chip" data-cat={c} type="button">{c}</button>)}
  </div>

  <!-- Featured slider -->
  {featured.length > 0 && (
    <div class="featured-section">
      <div class="featured-head">
        <div class="blog-sec-label">Bài Viết Nổi Bật</div>
        <div class="featured-nav">
          <button class="fnav" data-dir="-1" type="button" aria-label="Trước">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><polyline points="15 18 9 12 15 6"/></svg>
          </button>
          <button class="fnav" data-dir="1" type="button" aria-label="Sau">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><polyline points="9 18 15 12 9 6"/></svg>
          </button>
        </div>
      </div>
      <div class="featured-track" id="featured-track">
        {featured.map(post => (
          <a href={`/blog/${post.slug}/`} class="fslide" data-category={post.data.category} data-search={searchKey(post)}>
            <div class="fslide-cover">
              {post.data.cover && <img src={post.data.cover} alt={post.data.coverAlt ?? post.data.title} loading="lazy" />}
            </div>
            <div class="fslide-body">
              <div class="fslide-cat">{post.data.category}</div>
              <div class="fslide-title">{post.data.title}</div>
              <div class="fslide-desc">{post.data.description}</div>
              <div class="fslide-meta">
                <span class="fslide-author">{post.data.author}</span>
                <span class="fslide-dot">·</span>
                <span>{formatDate(post.data.pubDate)}</span>
                <span class="fslide-read">{post.data.readTime} phút đọc</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  )}

  <!-- All posts grid -->
  {rest.length > 0 && (
    <div class="posts-section">
      <div class="blog-sec-label">Tất Cả Bài Viết</div>
      <div class="posts-grid">
        {rest.map(post => (
          <a href={`/blog/${post.slug}/`} class="post-card" data-category={post.data.category} data-search={searchKey(post)}>
            <div class="pc-cover">
              {post.data.cover && <img src={post.data.cover} alt={post.data.coverAlt ?? post.data.title} loading="lazy" />}
            </div>
            <div class="pc-body">
              <div class="pc-cat">{post.data.category}</div>
              <div class="pc-title">{post.data.title}</div>
              <div class="pc-desc">{post.data.description}</div>
              <div class="pc-meta">
                <span>{formatDate(post.data.pubDate)}</span>
                <span class="pc-dot">·</span>
                <span>{post.data.readTime} phút</span>
              </div>
            </div>
          </a>
        ))}
      </div>
      <div class="no-results" id="no-results">Không tìm thấy bài viết phù hợp. Thử từ khoá khác hoặc chọn “Tất cả”.</div>
    </div>
  )}

  <!-- Newsletter -->
  <div class="newsletter">
    <h3>Nhận bài viết mới qua email</h3>
    <p>Mỗi tuần một bài — thực chiến, không spam.</p>
    <div class="newsletter-form">
      <input type="email" id="nl-email" class="newsletter-input" placeholder="email@company.com" />
      <button type="button" id="nl-submit" class="btn btn-primary" style="padding:12px 24px">Đăng Ký</button>
    </div>
    <p id="nl-msg" style="display:none;font-size:13px;color:var(--primary);margin-top:10px"></p>
  </div>

</div>

<script>
  /* ---- Newsletter: chưa có backend → mở email đăng ký qua mailto ---- */
  const nlEmail = document.getElementById('nl-email') as HTMLInputElement | null;
  const nlSubmit = document.getElementById('nl-submit');
  const nlMsg = document.getElementById('nl-msg') as HTMLElement | null;
  nlSubmit?.addEventListener('click', () => {
    const v = nlEmail?.value.trim() ?? '';
    if (!v || !v.includes('@')) { nlEmail?.focus(); return; }
    const subject = encodeURIComponent('Đăng ký nhận bài viết Semantix');
    const body = encodeURIComponent('Cho mình đăng ký nhận bài mới qua email: ' + v);
    window.location.href = `mailto:hello@semantix.vn?subject=${subject}&body=${body}`;
    if (nlMsg) { nlMsg.textContent = 'Đang mở email để gửi đăng ký — gửi giúp mình nhé!'; nlMsg.style.display = 'block'; }
  });

  /* ---- Filter: category chips + search box (combined) ---- */
  const chips = document.querySelectorAll<HTMLButtonElement>('.cat-chip');
  const featuredSection = document.querySelector<HTMLElement>('.featured-section');
  const grid = document.querySelector<HTMLElement>('.posts-grid');
  const noResults = document.querySelector<HTMLElement>('#no-results');
  const searchInput = document.querySelector<HTMLInputElement>('#blog-search');
  const searchClear = document.querySelector<HTMLButtonElement>('#blog-search-clear');

  let currentCat = '*';
  let currentQuery = '';

  // Bỏ dấu + lowercase để khớp không phụ thuộc dấu tiếng Việt (đồng bộ với searchKey ở server)
  function normalize(s: string) {
    return s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/đ/g, 'd').trim();
  }

  function isVisible(el: HTMLElement) { return el.style.display !== 'none'; }

  function apply() {
    document.querySelectorAll<HTMLElement>('[data-category]').forEach(card => {
      const catOK = currentCat === '*' || card.dataset.category === currentCat;
      const searchOK = currentQuery === '' || (card.dataset.search ?? '').includes(currentQuery);
      card.style.display = (catOK && searchOK) ? '' : 'none';
    });
    // Ẩn slider "Nổi bật" khi đang lọc danh mục hoặc đang tìm
    if (featuredSection) featuredSection.style.display = (currentCat === '*' && currentQuery === '') ? '' : 'none';
    // Hiện thông báo rỗng nếu lưới không còn card nào
    if (grid && noResults) {
      const anyVisible = [...grid.children].some(c => isVisible(c as HTMLElement));
      noResults.style.display = anyVisible ? 'none' : 'block';
    }
  }

  chips.forEach(chip => {
    chip.addEventListener('click', () => {
      chips.forEach(c => c.classList.remove('active'));
      chip.classList.add('active');
      currentCat = chip.dataset.cat ?? '*';
      apply();
    });
  });

  if (searchInput) {
    searchInput.addEventListener('input', () => {
      currentQuery = normalize(searchInput.value);
      if (searchClear) searchClear.hidden = searchInput.value === '';
      apply();
    });
  }
  if (searchClear && searchInput) {
    searchClear.addEventListener('click', () => {
      searchInput.value = '';
      currentQuery = '';
      searchClear.hidden = true;
      searchInput.focus();
      apply();
    });
  }

  /* ---- Featured slider ---- */
  const track = document.querySelector<HTMLElement>('#featured-track');
  const navBtns = document.querySelectorAll<HTMLButtonElement>('.fnav');

  if (track) {
    const step = () => {
      const first = track.querySelector<HTMLElement>('.fslide');
      const gap = parseFloat(getComputedStyle(track).columnGap || '24') || 24;
      return first ? first.offsetWidth + gap : track.clientWidth * 0.8;
    };

    const updateNav = () => {
      const maxScroll = track.scrollWidth - track.clientWidth - 2;
      navBtns.forEach(btn => {
        const dir = Number(btn.dataset.dir);
        btn.disabled = dir < 0 ? track.scrollLeft <= 2 : track.scrollLeft >= maxScroll;
      });
    };

    navBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        track.scrollBy({ left: Number(btn.dataset.dir) * step(), behavior: 'smooth' });
      });
    });
    track.addEventListener('scroll', updateNav, { passive: true });
    window.addEventListener('resize', updateNav);
    updateNav();

    /* Auto-advance; loops back to start; pauses on hover */
    let paused = false;
    track.addEventListener('mouseenter', () => paused = true);
    track.addEventListener('mouseleave', () => paused = false);
    setInterval(() => {
      if (paused || featuredSection?.style.display === 'none') return;
      const maxScroll = track.scrollWidth - track.clientWidth - 2;
      if (track.scrollLeft >= maxScroll) {
        track.scrollTo({ left: 0, behavior: 'smooth' });
      } else {
        track.scrollBy({ left: step(), behavior: 'smooth' });
      }
    }, 4500);
  }
</script>

</BaseLayout>
