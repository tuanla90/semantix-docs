---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const featured = posts.filter(p => p.data.featured);
const rest = posts.filter(p => !p.data.featured);

const categories = [...new Set(posts.map(p => p.data.category))];

function formatDate(date: Date) {
  return date.toLocaleDateString('vi-VN', { day: '2-digit', month: '2-digit', year: 'numeric' });
}
---
<BaseLayout title="Blog — Semantix" description="Kiến thức thực chiến về Data Analytics, AI, và cách đưa dữ liệu vào quyết định kinh doanh cho doanh nghiệp Việt Nam.">

<style>
  .blog-hero { padding: 120px 24px 72px; background: linear-gradient(160deg,#0F172A 0%,#1E1B4B 60%,#0F172A 100%); text-align: center; }
  .blog-hero h1 { font-size: clamp(32px,4.5vw,52px); font-weight: 900; color: #fff; letter-spacing: -1.2px; line-height: 1.1; margin-bottom: 16px; }
  .blog-hero p  { font-size: 18px; color: #94A3B8; max-width: 540px; margin: 0 auto; }

  .blog-body { max-width: 1080px; margin: 0 auto; padding: 72px 24px 96px; }

  /* Featured */
  .featured-label { font-size: 12px; font-weight: 700; color: var(--primary); text-transform: uppercase; letter-spacing: 1.5px; margin-bottom: 24px; }
  .featured-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(420px, 1fr)); gap: 32px; margin-bottom: 72px; }
  @media(max-width:640px){ .featured-grid { grid-template-columns: 1fr; } }

  .featured-card {
    background: var(--white); border: 1px solid var(--border); border-radius: 20px;
    padding: 36px; display: flex; flex-direction: column; gap: 16px;
    transition: box-shadow .2s, transform .2s;
    text-decoration: none;
  }
  .featured-card:hover { box-shadow: 0 12px 40px rgba(79,70,229,.12); transform: translateY(-3px); }
  .fc-cover { width: calc(100% + 72px); margin: -36px -36px 4px; height: 180px; object-fit: cover; border-radius: 20px 20px 0 0; display: block; }
  .fc-category { font-size: 12px; font-weight: 700; color: var(--primary); text-transform: uppercase; letter-spacing: 1px; }
  .fc-title { font-size: 22px; font-weight: 800; color: var(--dark); letter-spacing: -0.4px; line-height: 1.3; }
  .fc-desc  { font-size: 14.5px; color: var(--muted); line-height: 1.65; flex: 1; }
  .fc-meta  { display: flex; gap: 16px; align-items: center; padding-top: 16px; border-top: 1px solid var(--border); }
  .fc-author { font-size: 13px; font-weight: 600; color: var(--dark-2); }
  .fc-date   { font-size: 12px; color: var(--muted-light); }
  .fc-read   { font-size: 12px; color: var(--muted-light); margin-left: auto; }

  /* All posts */
  .posts-label { font-size: 12px; font-weight: 700; color: var(--muted); text-transform: uppercase; letter-spacing: 1.5px; margin-bottom: 24px; }
  .posts-list { display: flex; flex-direction: column; gap: 1px; background: var(--border); border-radius: 16px; overflow: hidden; border: 1px solid var(--border); }
  .post-row {
    background: var(--white); padding: 24px 28px;
    display: grid; grid-template-columns: 1fr auto;
    gap: 24px; align-items: center;
    text-decoration: none;
    transition: background .15s;
  }
  .post-row:hover { background: var(--surface); }
  .pr-cat   { font-size: 11px; font-weight: 700; color: var(--primary); text-transform: uppercase; letter-spacing: 1px; margin-bottom: 6px; }
  .pr-title { font-size: 16px; font-weight: 700; color: var(--dark); margin-bottom: 6px; line-height: 1.4; }
  .pr-desc  { font-size: 13px; color: var(--muted); line-height: 1.5; }
  .pr-right { text-align: right; flex-shrink: 0; }
  .pr-date  { font-size: 12px; color: var(--muted-light); margin-bottom: 4px; }
  .pr-read  { font-size: 12px; color: var(--muted-light); }

  /* Categories */
  .categories-bar { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 40px; }
  .cat-chip {
    padding: 6px 16px; border-radius: 100px; font-size: 13px; font-weight: 600;
    background: var(--surface); border: 1px solid var(--border); color: var(--dark-3);
    cursor: default;
  }

  /* Newsletter */
  .newsletter { background: var(--surface); border: 1px solid var(--border); border-radius: 20px; padding: 48px; text-align: center; margin-top: 72px; }
  .newsletter h3 { font-size: 22px; font-weight: 800; color: var(--dark); letter-spacing: -0.4px; margin-bottom: 10px; }
  .newsletter p  { font-size: 15px; color: var(--muted); margin-bottom: 28px; }
  .newsletter-form { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
  .newsletter-input {
    padding: 12px 20px; border-radius: 10px; border: 1px solid var(--border);
    font-size: 15px; width: 280px; background: var(--white); color: var(--dark);
    outline: none;
  }
  .newsletter-input:focus { border-color: var(--primary); }
</style>

<!-- Hero -->
<div class="blog-hero">
  <div class="badge" style="margin-bottom:20px"><span class="badge-dot"></span>Kiến Thức Thực Chiến</div>
  <h1>Blog Semantix</h1>
  <p>Data Analytics, AI, và cách đưa dữ liệu vào quyết định kinh doanh — viết cho người làm, không phải người nghiên cứu.</p>
</div>

<div class="blog-body">

  <!-- Category chips -->
  <div class="categories-bar">
    <div class="cat-chip">Tất cả</div>
    {categories.map(c => <div class="cat-chip">{c}</div>)}
  </div>

  <!-- Featured posts -->
  {featured.length > 0 && (
    <>
      <div class="featured-label">Bài Viết Nổi Bật</div>
      <div class="featured-grid">
        {featured.map(post => (
          <a href={`/blog/${post.slug}/`} class="featured-card">
            {post.data.cover && <img class="fc-cover" src={post.data.cover} alt={post.data.coverAlt ?? post.data.title} />}
            <div class="fc-category">{post.data.category}</div>
            <div class="fc-title">{post.data.title}</div>
            <div class="fc-desc">{post.data.description}</div>
            <div class="fc-meta">
              <div>
                <div class="fc-author">{post.data.author}</div>
                <div class="fc-date">{formatDate(post.data.pubDate)}</div>
              </div>
              <div class="fc-read">{post.data.readTime} phút đọc</div>
            </div>
          </a>
        ))}
      </div>
    </>
  )}

  <!-- All posts list -->
  {rest.length > 0 && (
    <>
      <div class="posts-label">Tất Cả Bài Viết</div>
      <div class="posts-list">
        {rest.map(post => (
          <a href={`/blog/${post.slug}/`} class="post-row">
            <div>
              <div class="pr-cat">{post.data.category}</div>
              <div class="pr-title">{post.data.title}</div>
              <div class="pr-desc">{post.data.description}</div>
            </div>
            <div class="pr-right">
              <div class="pr-date">{formatDate(post.data.pubDate)}</div>
              <div class="pr-read">{post.data.readTime} phút</div>
            </div>
          </a>
        ))}
      </div>
    </>
  )}

  <!-- Newsletter -->
  <div class="newsletter">
    <h3>Nhận bài viết mới qua email</h3>
    <p>Mỗi tuần một bài — thực chiến, không spam.</p>
    <div class="newsletter-form">
      <input type="email" class="newsletter-input" placeholder="email@company.com" />
      <button class="btn btn-primary" style="padding:12px 24px">Đăng Ký</button>
    </div>
  </div>

</div>

</BaseLayout>
