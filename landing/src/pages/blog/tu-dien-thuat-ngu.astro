---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { computeUsage, shortLabel } from '../../lib/glossary-usage';

// Từ điển thuật ngữ Data / BI / AI — sắp xếp A–Z.
// Mỗi mục: t = thuật ngữ, ab = dạng đầy đủ (viết tắt), vi = nghĩa tiếng Việt,
// slug = bài định nghĩa chính (tùy chọn), match = các cụm cần tìm (cả tiếng Việt;
// bỏ trống → mặc định [t, ab]). "Xuất hiện trong" được tính tự động từ nội dung blog.
type Term = { t: string; ab?: string; vi: string; slug?: string; match?: string[] };

const terms: Term[] = [
  { t: 'ABC inventory', match: ['abc inventory', 'phân tầng abc'], slug: 'abc-inventory', vi: 'Phân loại hàng tồn theo giá trị: nhóm A ít mã nhưng giữ phần lớn vốn, nhóm C nhiều mã nhưng giá trị nhỏ — để quản từng nhóm khác nhau.' },
  { t: 'Activation', vi: 'Thời điểm khách lần đầu nhận được giá trị thật từ sản phẩm (chứ không chỉ đăng ký).', slug: 'cohort-behavioral' },
  { t: 'Acquisition', vi: 'Thu hút khách hàng mới (qua quảng cáo, marketing…).', slug: 'growth-accounting' },
  { t: 'Agent (AI)', match: ['agent', 'tác tử'], vi: 'Tác tử AI tự lập kế hoạch nhiều bước và gọi công cụ để hoàn thành nhiệm vụ, thay vì chỉ trả lời một câu.', slug: 'dual-agent-debate' },
  { t: 'AI BI', vi: 'Nền tảng phân tích dữ liệu lấy AI làm lõi: người dùng hỏi bằng ngôn ngữ tự nhiên, hệ thống tự sinh truy vấn và trả lời ngay — thay vì phải qua một analyst trung gian.', slug: 'thue-doi-data-hay-ai-bi' },
  { t: 'Anomaly detection', match: ['anomaly detection', 'phát hiện bất thường'], slug: 'anomaly-detection', vi: 'Phát hiện bất thường: tự động nhận ra điểm số liệu lệch hẳn so với thường lệ (vd doanh thu rớt đột ngột).' },
  { t: 'AOV', ab: 'Average Order Value', vi: 'Giá trị đơn hàng trung bình = tổng doanh thu chia tổng số đơn.' },
  { t: 'ARPU', ab: 'Average Revenue Per User', match: ['arpu'], slug: 'growth-accounting-revenue', vi: 'Doanh thu trung bình trên mỗi người dùng trong một kỳ.' },
  { t: 'Attribution', vi: 'Quy kết doanh thu cho kênh "có công" dẫn tới đơn hàng; mỗi nền tảng tự nhận công nên dễ đếm trùng.', slug: 'marketing-do-roi-ads' },
  { t: 'BI', ab: 'Business Intelligence', vi: 'Trí tuệ doanh nghiệp — kỷ luật biến dữ liệu rời rạc thành quyết định, không chỉ là dashboard đẹp.', slug: 'bi-cho-sme' },
  { t: 'BYOK', ab: 'Bring Your Own Key', vi: 'Tự mang khóa API của mình: doanh nghiệp dùng tài khoản AI riêng để giữ quyền kiểm soát dữ liệu và chi phí.', slug: 'multi-provider-byok' },
  { t: 'Bus-factor', vi: 'Rủi ro khi kiến thức dồn vào một người: người đó nghỉ là cả mảng nghiệp vụ (cách tính số, logic ẩn) biến mất theo.', slug: 'thue-doi-data-hay-ai-bi' },
  { t: 'CAC', ab: 'Customer Acquisition Cost', vi: 'Chi phí trung bình để có được một khách hàng mới.' },
  { t: 'Calculated metric', match: ['calculated metric', 'metric tính toán', 'chỉ số tính toán'], vi: 'Metric tính toán — con số dẫn xuất từ các cột hoặc metric gốc bằng một công thức (vd lợi nhuận gộp = doanh thu − giá vốn), định nghĩa một lần ở tầng dữ liệu để mọi báo cáo dùng chung.', slug: 'tao-metric-tinh-toan' },
  { t: 'CLV:CAC ratio', match: ['clv:cac', 'clv/cac', 'clv > 3', 'clv ≥ 3', 'tỷ số clv:cac'], vi: 'Tỷ số giữa giá trị trọn đời của khách và chi phí thu hút khách đó; ngưỡng lành mạnh thường là CLV ≥ 3×CAC — chi để có khách phải dưới một phần ba giá trị họ đem lại.', slug: 'clv-framework' },
  { t: 'Churn', vi: 'Khách rời bỏ: người dùng hoạt động kỳ trước nhưng kỳ này thì không. Churn rate là tỷ lệ rời bỏ trong kỳ.', slug: 'cohort-retention-pmf' },
  { t: 'Churn prediction', slug: 'churn-prediction', vi: 'Dự đoán khách sắp rời đi dựa trên hành vi, để giữ chân trước khi họ rời.' },
  { t: 'Cohort', vi: 'Nhóm khách gộp theo thời điểm bắt đầu (vd cùng mua tháng 1), rồi theo dõi từng nhóm "già đi" theo thời gian.', slug: 'cohort-analysis' },
  { t: 'Context window', match: ['context window', 'cửa sổ ngữ cảnh'], vi: 'Lượng văn bản tối đa mà một mô hình AI có thể "nhớ" và xử lý trong một lần.', slug: 'toi-uu-chi-phi-token-ai' },
  { t: 'Conversion rate', vi: 'Tỷ lệ chuyển đổi giữa hai bước trong phễu (vd số người thanh toán / số người thêm giỏ).', slug: 'funnel-analysis' },
  { t: 'Confidence band', match: ['confidence band', 'dải tin cậy', 'dải sai số', 'khoảng tin cậy'], vi: 'Dải tin cậy — vùng giá trị mà kết quả dự báo nhiều khả năng rơi vào; loe rộng dần về tương lai vì càng xa càng bất định.', slug: 'time-series-forecast' },
  { t: 'Dashboard', vi: 'Bảng số trực quan tổng hợp nhiều biểu đồ/chỉ số trên một màn hình. Là cái hiển thị, không phải bản chất của BI.' },
  { t: 'Data analyst', vi: 'Chuyên viên phân tích dữ liệu — người biến dữ liệu thô thành insight và báo cáo. Ở VN lương ~18–35 triệu/tháng, khó tuyển và dễ nhảy việc.', slug: 'thue-doi-data-hay-ai-bi' },
  { t: 'Data engineer', vi: 'Kỹ sư dữ liệu — người dựng và vận hành đường ống dẫn dữ liệu (pipeline) để dữ liệu sẵn sàng cho phân tích.', slug: 'thue-doi-data-hay-ai-bi' },
  { t: 'Data governance', match: ['data governance', 'quản trị dữ liệu', 'governance'], vi: 'Quản trị dữ liệu: quy định ai sở hữu con số, ai chịu trách nhiệm khi nó sai, ai được xem gì.', slug: 'data-governance'},
  { t: 'Data lake', match: ['data lake', 'hồ dữ liệu'], vi: 'Hồ dữ liệu — kho lưu dữ liệu thô ở mọi định dạng, biến đổi sau khi cần.' },
  { t: 'Data modeling', match: ['data modeling', 'mô hình hoá dữ liệu', 'mô hình hóa dữ liệu'], vi: 'Cách thiết kế bảng và quan hệ giữa chúng (fact/dimension) — quyết định bạn hỏi được những câu nào.' },
  { t: 'Data warehouse', vi: 'Kho dữ liệu tập trung, tách khỏi hệ thống vận hành, được tối ưu cho phân tích và báo cáo.', slug: 'data-warehouse-sme' },
  { t: 'DAU', ab: 'Daily Active User', vi: 'Số người dùng hoạt động trong một ngày.' },
  { t: 'Descriptive analytics', vi: 'Phân tích mô tả: trả lời "chuyện gì đã xảy ra" — bức ảnh số liệu của quá khứ (doanh thu tháng trước, đơn theo khung giờ).', slug: 'bat-dau-tu-cau-hoi' },
  { t: 'Diagnostic analytics', vi: 'Phân tích chẩn đoán: trả lời "vì sao nó xảy ra" — cắt lát sâu để tìm nguyên nhân đằng sau con số.', slug: 'bat-dau-tu-cau-hoi' },
  { t: 'Docker', match: ['docker', 'container'], vi: 'Công cụ đóng gói phần mềm cùng mọi thứ nó cần vào một "container" chạy giống nhau ở mọi máy chủ — giúp triển khai phần mềm trên hạ tầng nội bộ nhanh và đồng nhất.', slug: 'on-premise-vs-cloud-ai-bi' },
  { t: 'Predictive analytics', vi: 'Phân tích dự đoán: trả lời "sắp tới sẽ ra sao" — ước lượng kết quả tương lai từ dữ liệu quá khứ.', slug: 'tien-hoa-bi' },
  { t: 'Predictive CLV', match: ['predictive clv', 'clv dự đoán'], vi: 'CLV dự đoán — ước lượng giá trị tương lai của một khách: AOV × tần suất mua × tuổi thọ khách × biên lợi nhuận; con số dùng để ra quyết định chi tiêu.', slug: 'clv-framework' },
  { t: 'Prescriptive analytics', vi: 'Phân tích đề xuất: trả lời "nên làm gì cho kịch bản tốt nhất" — gợi ý hành động và mô phỏng kịch bản (what-if), nấc cao nhất của thang trưởng thành phân tích.', slug: 'tien-hoa-bi' },
  { t: 'Analytics maturity', vi: 'Độ trưởng thành phân tích: thang bốn nấc đo năng lực BI — mô tả → chẩn đoán → dự đoán → đề xuất; càng lên cao câu hỏi càng khó và lợi thế càng lớn.', slug: 'tien-hoa-bi' },
  { t: 'Forecasting', vi: 'Dự báo: ước lượng số liệu tương lai (doanh thu, nhu cầu tồn kho) từ dữ liệu quá khứ — lõi của nấc phân tích dự đoán.', slug: 'tien-hoa-bi' },
  { t: 'Dimension', vi: 'Lát cắt để xoay nhìn một metric (theo kênh, theo tháng, theo sản phẩm…).', slug: 'metric-dimension-kpi' },
  { t: 'Embedding', match: ['embedding'], vi: 'Mã hóa văn bản thành dãy số (vector) để máy so sánh ý nghĩa gần/xa, nền tảng cho tìm kiếm theo nghĩa và RAG.' },
  { t: 'ELT', ab: 'Extract, Load, Transform', vi: 'Trích xuất → nạp dữ liệu thô về trước → biến đổi khi cần. Trả quyền phân tích về tay người có câu hỏi.', slug: 'etl-vs-elt' },
  { t: 'ETL', ab: 'Extract, Transform, Load', vi: 'Trích xuất → biến đổi → nạp. Phải biết trước cần gì, nên thường khóa dữ liệu trong tay kỹ sư.', slug: 'etl-vs-elt' },
  { t: 'ETS', ab: 'Exponential Smoothing', match: ['ets', 'làm trơn lũy thừa', 'exponential smoothing'], vi: 'Làm trơn lũy thừa — họ phương pháp dự báo cho kỳ gần đây trọng số lớn hơn kỳ xa; Holt và Holt-Winters đều thuộc họ này.', slug: 'time-series-forecast' },
  { t: 'Export', match: ['export', 'xuất báo cáo', 'xuất powerpoint', 'kết xuất'], vi: 'Xuất báo cáo — kết xuất nội dung (biểu đồ, dashboard) ra một định dạng dùng được bên ngoài như PowerPoint; xuất 1-click giúp slide luôn khớp dữ liệu mới nhất thay vì chép tay.', slug: 'xuat-bao-cao-powerpoint' },
  { t: 'Fact / Dimension', match: ['bảng fact', 'fact table', 'fact / dimension'], vi: 'Bảng fact chứa số đo (doanh thu, số lượng); bảng dimension chứa mô tả để cắt lát (sản phẩm, thời gian, kênh).' },
  { t: 'Fine-tune', vi: 'Huấn luyện thêm một mô hình AI trên dữ liệu riêng để nó hợp ngữ cảnh hơn (khác với RAG là cho tra cứu).' },
  { t: 'Funnel', vi: 'Phễu chuyển đổi — chuỗi bước khách đi qua (xem → thêm giỏ → thanh toán); phân tích để tìm chỗ rò rỉ.', slug: 'funnel-analysis' },
  { t: 'Growth Accounting', vi: 'Kế toán tăng trưởng — "báo cáo lãi/lỗ" cho người dùng: tách thay đổi mỗi kỳ thành mới / quay lại / giữ chân / rời đi.', slug: 'growth-accounting' },
  { t: 'Gross margin', match: ['gross margin', 'lợi nhuận gộp', 'biên gộp', 'biên lợi nhuận gộp'], vi: 'Lợi nhuận gộp = doanh thu − giá vốn hàng bán; biên gộp (%) = lợi nhuận gộp chia doanh thu — phần còn lại sau khi trừ chi phí trực tiếp làm ra sản phẩm.', slug: 'tao-metric-tinh-toan' },
  { t: 'Hallucination', vi: 'Ảo giác AI — mô hình tự tin "bịa" ra thông tin nghe hợp lý nhưng sai.', slug: 'llm-bia-sql' },
  { t: 'Historic CLV', match: ['historic clv', 'clv lịch sử'], vi: 'CLV lịch sử — cộng lợi nhuận một khách đã thực sự đem lại tính đến nay; chắc chắn nhưng nhìn qua gương chiếu hậu, không nói gì về tương lai.', slug: 'clv-framework' },
  { t: 'Holt-Winters', match: ['holt-winters', 'holt winters', 'holt'], vi: 'Phương pháp dự báo (họ ETS) bắt được cả xu hướng lẫn mùa vụ cùng lúc — lựa chọn hợp với hầu hết số liệu kinh doanh có nhịp Tết/cuối tuần.', slug: 'time-series-forecast' },
  { t: 'KPI', ab: 'Key Performance Indicator', vi: 'Chỉ số hiệu suất then chốt — một metric được gắn mục tiêu cụ thể.', slug: 'metric-dimension-kpi' },
  { t: 'Kubernetes', match: ['kubernetes', 'k8s'], vi: 'Hệ điều phối nhiều container trên cụm máy chủ: tự sắp đặt, khởi động lại khi hỏng, co giãn theo tải — xương sống để vận hành phần mềm self-host ở quy mô lớn.', slug: 'on-premise-vs-cloud-ai-bi' },
  { t: 'Lagging indicator', vi: 'Chỉ số báo sau — phản ánh kết quả đã xảy ra (vd doanh thu quý), khó tác động trực tiếp.' },
  { t: 'Leading indicator', vi: 'Chỉ số báo trước — dự báo kết quả tương lai và lái được (vd số khách dùng thử).' },
  { t: 'LLM', ab: 'Large Language Model', vi: 'Mô hình ngôn ngữ lớn — AI được huấn luyện trên lượng văn bản khổng lồ để hiểu và sinh ngôn ngữ.', slug: 'llm-bia-sql' },
  { t: 'LTV / CLV', ab: 'Customer Lifetime Value', vi: 'Giá trị trọn đời của một khách hàng — tổng lợi nhuận kỳ vọng từ họ suốt thời gian gắn bó.', slug: 'cohort-revenue-ltv' },
  { t: 'Market Basket', vi: 'Phân tích giỏ hàng — tìm các sản phẩm hay được mua kèm nhau để bán chéo đúng cách.', match: ['market basket', 'phân tích giỏ hàng'], slug: 'market-basket-ban-kem'},
  { t: 'MAU', ab: 'Monthly Active User', vi: 'Số người dùng (khách hàng) hoạt động trong một tháng.', slug: 'growth-accounting' },
  { t: 'Metric', vi: 'Con số đo được (doanh thu, số đơn, số khách) — khác với dimension là lát cắt.', slug: 'metric-dimension-kpi' },
  { t: 'Moving average', match: ['moving average', 'trung bình trượt'], vi: 'Trung bình trượt — lấy trung bình một cửa sổ vài kỳ liền nhau để san phẳng dao động ngắn hạn, giúp xu hướng nổi lên khỏi nhiễu.', slug: 'time-series-forecast' },
  { t: 'NDR', ab: 'Net Dollar Retention', vi: 'Tỷ lệ giữ doanh thu từ tập khách cũ sau khi cộng phần mở rộng và trừ phần rời bỏ — vượt 100% là khách cũ tự lớn lên.', slug: 'growth-accounting-revenue' },
  { t: 'Net New MAU', vi: 'Tăng ròng người dùng hoạt động trong kỳ = mới + quay lại − rời đi. Chính là con số "+x%" mà dashboard hay khoe.', slug: 'growth-accounting' },
  { t: 'Noise', match: ['noise', 'nhiễu'], vi: 'Nhiễu — dao động ngẫu nhiên còn sót lại trong chuỗi số, không lặp lại và không mang ý nghĩa; cố giải thích từng cú nhiễu là tự lừa mình.', slug: 'time-series-forecast' },
  { t: 'OLAP', ab: 'Online Analytical Processing', slug: 'oltp-vs-olap', vi: 'Hệ thống tối ưu cho phân tích — tổng hợp, cắt lát số liệu nhiều chiều phục vụ báo cáo.' },
  { t: 'OLTP', ab: 'Online Transaction Processing', slug: 'oltp-vs-olap', vi: 'Hệ thống xử lý giao dịch vận hành (bán hàng, đặt đơn) — không nên chạy báo cáo nặng thẳng lên đây.' },
  { t: 'Ollama', match: ['ollama'], vi: 'Công cụ chạy mô hình ngôn ngữ lớn (LLM) ngay trên máy chủ nội bộ: câu hỏi và dữ liệu được model xử lý trong nhà, không gói tin nào rời mạng nội bộ.', slug: 'on-premise-vs-cloud-ai-bi' },
  { t: 'On-premise', vi: 'Triển khai phần mềm trên hạ tầng tự quản của doanh nghiệp, thay vì trên cloud của nhà cung cấp.' },
  { t: 'P&L', ab: 'Profit & Loss', vi: 'Báo cáo lãi/lỗ — tách doanh thu khỏi chi phí để thấy tiền đến từ đâu, đi đâu.' },
  { t: 'Pareto (80/20)', match: ['pareto', '80/20'], vi: 'Quy luật 80/20 — khoảng 20% nguyên nhân thường tạo ra 80% kết quả (vd 20% sản phẩm nuôi 80% lợi nhuận).', slug: 'pareto-80-20' },
  { t: 'PMF', ab: 'Product–Market Fit', vi: 'Mức độ sản phẩm khớp nhu cầu thị trường — thường thấy qua đường cong giữ chân phẳng ra thay vì rơi về 0.', slug: 'cohort-retention-pmf' },
  { t: 'Quick Ratio', vi: 'Tỉ lệ "tăng trên hao" = (khách mới + quay lại) / khách rời đi. Trên 1 là đang lớn, dưới 1 là đang teo.', slug: 'growth-accounting-quick-ratio' },
  { t: 'R²', ab: 'R-squared', match: ['r²', 'r-squared', 'r bình phương', 'hệ số xác định'], vi: 'Hệ số xác định: tỷ lệ % biến động của biến phụ thuộc mà đường khớp hồi quy giải thích được; 0 = vô dụng, 1 = giải thích trọn vẹn.', slug: 'correlation-regression' },
  { t: 'RAG', ab: 'Retrieval-Augmented Generation', vi: 'Sinh có truy hồi — cho AI tra đúng tài liệu/ngữ cảnh trước khi trả lời, để bớt bịa.', slug: 'rag-la-gi' },
  { t: 'Regression', match: ['regression', 'hồi quy'], vi: 'Hồi quy: vẽ một đường khớp qua đám điểm để mô tả quan hệ bằng công thức — định lượng "đổi A một đơn vị thì B đổi bao nhiêu" và dự đoán.', slug: 'correlation-regression' },
  { t: 'Resurrected user', match: ['resurrected', 'khách quay lại', 'quay lại'], vi: 'Khách từng rời đi nay quay lại hoạt động sau một thời gian vắng mặt.', slug: 'growth-accounting' },
  { t: 'Retention', vi: 'Giữ chân — tỷ lệ khách còn hoạt động sau một khoảng thời gian kể từ khi bắt đầu.', slug: 'cohort-retention-pmf' },
  { t: 'RFM', ab: 'Recency, Frequency, Monetary', vi: 'Phân khúc khách theo lần mua gần nhất, tần suất mua và số tiền chi — để bán đúng người.', slug: 'rfm-segmentation' },
  { t: 'RLS', ab: 'Row-Level Security', vi: 'Phân quyền theo hàng — mỗi người chỉ thấy đúng các dòng dữ liệu được phép, ngay tại tầng dữ liệu.', slug: 'row-level-security' },
  { t: 'ROAS', ab: 'Return on Ad Spend', vi: 'Doanh thu thu về trên mỗi đồng chi quảng cáo.', slug: 'marketing-do-roi-ads' },
  { t: 'ROI', ab: 'Return on Investment', vi: 'Tỷ suất hoàn vốn — lợi ích thu được so với chi phí bỏ ra.' },
  { t: 'SaaS', ab: 'Software as a Service', vi: 'Phần mềm cho thuê theo thuê bao (thường hàng tháng), dùng qua internet thay vì mua đứt.' },
  { t: 'Schema', vi: 'Cấu trúc bảng/cột của một cơ sở dữ liệu — AI cần "đọc" schema để biết hỏi vào đâu.' },
  { t: 'Seasonality', vi: 'Tính mùa vụ — quy luật lên xuống lặp lại của số liệu theo thời điểm (Tết, cuối tuần, mùa sale).' },
  { t: 'Self-service analytics', vi: 'Tự phục vụ phân tích — người làm kinh doanh tự hỏi và tự có câu trả lời, không phải chờ đội data.', slug: 'self-service-analytics' },
  { t: 'Semantic Layer', vi: 'Tầng định nghĩa nghiệp vụ dùng chung — nơi "doanh thu", "khách quay lại"… được định nghĩa một lần cho cả tổ chức.', slug: 'semantic-layer' },
  { t: 'Single source of truth', vi: 'Một nguồn sự thật chung — một định nghĩa thống nhất, không phải một database chung.', slug: 'mot-nguon-su-that' },
  { t: 'Slope', match: ['slope', 'độ dốc'], vi: 'Độ dốc (b) của đường hồi quy: đổi biến x một đơn vị thì y đổi đúng b đơn vị — con số trả lời "thêm 1 đơn vị A thì B nhúc nhích bao nhiêu".', slug: 'correlation-regression' },
  { t: 'SQL', ab: 'Structured Query Language', vi: 'Ngôn ngữ truy vấn cơ sở dữ liệu — câu lệnh để lấy và tính toán số liệu.' },
  { t: 'Text-to-SQL', vi: 'Kỹ thuật để AI biến câu hỏi tiếng Việt/ngôn ngữ tự nhiên thành câu lệnh SQL.', slug: 'text-to-sql' },
  { t: 'Time series', match: ['time series', 'chuỗi thời gian'], vi: 'Chuỗi thời gian — dãy số đo cùng một chỉ số qua các mốc thời gian liên tiếp; về khái niệm là tổng của xu hướng + mùa vụ + nhiễu.', slug: 'time-series-forecast' },
  { t: 'Token', vi: 'Đơn vị văn bản mà mô hình AI xử lý và tính phí (một từ tiếng Việt thường là vài token).', slug: 'toi-uu-chi-phi-token-ai' },
  { t: 'Top-line', vi: 'Con số tổng ngoài cùng của báo cáo (thường là doanh thu hoặc tăng trưởng), trước khi bóc tách bên trong.' },
  { t: 'Trend', match: ['trend', 'xu hướng'], vi: 'Xu hướng — chiều đi dài hạn (lên/xuống) của một chỉ số sau khi gạt bỏ mùa vụ và nhiễu; là phần cho biết doanh nghiệp đang lớn hay co lại.', slug: 'time-series-forecast' },
  { t: 'Vanity metric', vi: 'Chỉ số "đẹp mã" (lượt xem, follower) trông oai nhưng không dẫn tới quyết định hành động được.', slug: 'vanity-metrics'},
  { t: 'Vector search', match: ['vector search', 'tìm kiếm theo nghĩa', 'tìm kiếm vector'], vi: 'Tìm kiếm theo độ gần nghĩa (qua embedding) thay vì khớp đúng từ khóa.' },
  { t: 'Vintage analysis', match: ['vintage analysis', 'phân tích theo lứa', 'vintage'], vi: 'Phân tích theo lứa: nhóm đối tượng theo thời điểm hình thành (lứa giải ngân, lứa khách mua lần đầu) rồi so hiệu suất theo tuổi đời — đọc theo cột để tách chất lượng khỏi nhiễu mùa vụ.', slug: 'vintage-analysis' },
  { t: 'Vintage grid', match: ['vintage grid', 'lưới vintage', 'lưới tam giác'], vi: 'Lưới vintage (lưới tam giác): bảng mỗi hàng là một lứa, mỗi cột là một mốc tuổi đời; có dạng tam giác vì lứa mới chưa đủ tuổi. Trong Semantix là một cách hiển thị của Cohort.', slug: 'vintage-analysis' },
  { t: 'Origination', match: ['origination', 'thời điểm hình thành', 'lứa giải ngân'], vi: 'Thời điểm hình thành ("lứa"): mốc một đối tượng ra đời — tháng giải ngân khoản vay, tháng khách mua lần đầu — dùng để gộp thành lứa.', slug: 'vintage-analysis' },
  { t: 'Offset', match: ['offset', 'tuổi đời', 'tháng tuổi'], vi: 'Tuổi đời: số kỳ đã trôi qua kể từ khi đối tượng hình thành (offset 0 = kỳ vừa ra đời). So các lứa ở cùng offset là cách so "táo với táo".', slug: 'vintage-analysis' },
  { t: 'WAU', ab: 'Weekly Active User', match: ['wau'], slug: 'growth-accounting', vi: 'Số người dùng hoạt động trong một tuần.' },
  { t: 'Anchoring', vi: 'Mỏ neo: xu hướng bám vào con số đầu tiên nghe được rồi điều chỉnh quanh nó thay vì đánh giá độc lập.', slug: 'thien-kien-trong-doc-so' },
  { t: 'Causation', vi: 'Nhân quả: quan hệ nguyên nhân–kết quả, khi thay đổi A thì B đổi theo. Khác với tương quan.', slug: 'tuong-quan-nhan-qua' },
  { t: 'Cognitive bias', vi: 'Thành kiến nhận thức: lối tư duy lệch một cách có hệ thống do não xử lý tắt.', slug: 'thien-kien-trong-doc-so' },
  { t: 'Confirmation bias', vi: 'Thiên kiến xác nhận: chỉ tìm và tin bằng chứng ủng hộ điều mình đã tin, làm ngơ bằng chứng ngược.', slug: 'thien-kien-trong-doc-so' },
  { t: 'Confounder', vi: 'Yếu tố gây nhiễu: một biến thứ ba đứng sau đẩy cả A lẫn B cùng lên, khiến chúng trông như liên quan nhân quả.', slug: 'tuong-quan-nhan-qua' },
  { t: 'Correlation', vi: 'Tương quan: mức độ hai con số cùng lên/xuống với nhau; KHÔNG hàm ý cái này gây ra cái kia.', slug: 'tuong-quan-nhan-qua' },
  { t: 'Correlation coefficient', match: ['correlation coefficient', 'hệ số tương quan'], vi: 'Hệ số tương quan (r): con số từ −1 đến +1 đo độ chặt và chiều của quan hệ tuyến tính; gần ±1 là rất chặt, gần 0 là yếu hoặc gần như không có.', slug: 'correlation-regression' },
  { t: 'Extrapolation', match: ['extrapolation', 'ngoại suy'], vi: 'Ngoại suy: dùng đường khớp để đoán ra ngoài vùng dữ liệu đã có; rủi ro vì quan hệ có thể đã cong ở vùng chưa từng quan sát.', slug: 'correlation-regression' },
  { t: 'Linear regression', match: ['linear regression', 'hồi quy tuyến tính'], vi: 'Hồi quy tuyến tính: khớp một đường thẳng (y = a + b·x) qua đám điểm — dạng hồi quy đơn giản và phổ biến nhất.', slug: 'correlation-regression' },
  { t: 'Data-driven', vi: 'Để dữ liệu lái quyết định: bám theo con số và dám đổi quyết định khi số trái với linh cảm.', slug: 'tu-duy-du-lieu-la-gi' },
  { t: 'Data-informed', vi: 'Để dữ liệu soi sáng: dữ liệu là một đầu vào nặng ký bên cạnh kinh nghiệm, được phép cãi lại quyết định ban đầu.', slug: 'tu-duy-du-lieu-la-gi' },
  { t: 'Distribution', vi: 'Phân phối: toàn bộ hình dạng dữ liệu trải ra (thường xem qua histogram) — cho thấy điều mà một con số tóm tắt giấu mất.', slug: 'trung-binh-noi-doi' },
  { t: 'HiPPO', ab: 'Highest Paid Person Opinion', vi: 'Quyết định theo ý người chức/lương cao nhất; số liệu chỉ được trưng ra khi ủng hộ sếp.', slug: 'tu-duy-du-lieu-la-gi' },
  { t: 'Hypothesis', match: ['hypothesis', 'giả thuyết'], vi: 'Giả thuyết: một niềm tin rõ ràng, có thể sai, được nêu trước rồi dùng dữ liệu để phán xử.', slug: 'tu-duy-du-lieu-la-gi' },
  { t: 'Mean', vi: 'Trung bình cộng: cộng hết giá trị rồi chia số lượng; dễ bị giá trị ngoại lai kéo lệch.', slug: 'trung-binh-noi-doi' },
  { t: 'Median', vi: 'Trung vị: giá trị nằm chính giữa khi xếp dữ liệu từ thấp đến cao; ít bị ngoại lai ảnh hưởng nên thường trung thực hơn mean.', slug: 'trung-binh-noi-doi' },
  { t: 'Nghịch lý Simpson', vi: 'Khi gộp các nhóm lại, kết luận đảo chiều so với khi xét từng nhóm riêng (mỗi nhóm A thắng nhưng gộp lại B thắng).', slug: 'trung-binh-noi-doi' },
  { t: 'Outlier', vi: 'Giá trị ngoại lai: điểm dữ liệu lệch hẳn khỏi phần còn lại, đủ sức kéo lệch trung bình.', slug: 'trung-binh-noi-doi' },
  { t: 'Qualitative', vi: 'Định tính: dữ liệu mô tả bằng lời (review, tin nhắn khách), trả lời câu hỏi vì sao.', slug: 'tu-duy-du-lieu-la-gi' },
  { t: 'Quantitative', vi: 'Định lượng: dữ liệu đo bằng con số, trả lời câu hỏi bao nhiêu.', slug: 'tu-duy-du-lieu-la-gi' },
  { t: 'Bảng ảo (virtual table)', match: ['bảng ảo', 'virtual table'], vi: 'Bảng định nghĩa bằng một truy vấn (SQL hoặc gộp UNION) chứ không lưu dữ liệu riêng; được tiêm vào câu hỏi lúc chạy để gộp + làm sạch dữ liệu ngay tại nguồn, không copy.', slug: 'bang-ao-gop-du-lieu' },
  { t: 'CTE', ab: 'Common Table Expression', vi: 'Bảng tạm có tên trong một câu truy vấn (mệnh đề WITH), giúp tách logic cho dễ đọc và tái dùng.', slug: 'bang-ao-gop-du-lieu' },
  { t: 'Database', vi: 'Cơ sở dữ liệu: kho lưu dữ liệu có cấu trúc, có ràng buộc và truy vấn được — khác bảng tính ở quy mô, quan hệ và phân quyền.', slug: 'khi-nao-len-database' },
  { t: 'Enum', vi: 'Danh sách giá trị cố định cho một trường (vd trạng thái đơn: chờ / đang giao / hoàn tất / hủy).', slug: 'nocobase-semantix' },
  { t: 'Metadata', vi: 'Siêu dữ liệu: dữ liệu mô tả về dữ liệu (tên bảng/cột, kiểu, quan hệ, nhãn hiển thị).', slug: 'nocobase-semantix' },
  { t: 'No-code', vi: 'Dựng phần mềm/ứng dụng bằng giao diện kéo-thả, không cần viết code.', slug: 'khi-nao-len-database' },
  { t: 'NocoBase', vi: 'Nền tảng database no-code: dựng cơ sở dữ liệu bằng kéo-thả và lưu sẵn định nghĩa nghiệp vụ (nhãn, kiểu, enum, quan hệ) trong metadata — Semantix đọc lại được toàn bộ.', slug: 'nocobase-semantix' },
  { t: 'Relational database', vi: 'Cơ sở dữ liệu quan hệ: dữ liệu nằm ở nhiều bảng nối nhau qua khóa chung (đơn ↔ khách ↔ sản phẩm).', slug: 'khi-nao-len-database' },
  { t: 'Spreadsheet', vi: 'Bảng tính (Excel, Google Sheets): lưới ô kèm công thức — tiện và linh hoạt, nhưng không phải một database.' },
  { t: 'UNION', vi: 'Gộp các dòng từ nhiều bảng/truy vấn lại thành một tập kết quả chung.', slug: 'bang-ao-gop-du-lieu' },
  { t: 'A/B test', vi: 'Thí nghiệm chia ngẫu nhiên hai nhóm (A và B) để so xem thay đổi nào hiệu quả hơn.', slug: 'funnel-analysis' },
  { t: 'AI Analytics', vi: 'Phân tích dữ liệu bằng AI: hỏi bằng ngôn ngữ tự nhiên, AI trả về số và biểu đồ.', slug: 'ai-questions' },
  { t: 'AI-native', vi: 'Sản phẩm thiết kế lấy AI làm lõi ngay từ đầu, không phải gắn thêm về sau.', slug: 'vs-thoughtspot' },
  { t: 'Affiliate', vi: 'Tiếp thị liên kết: trả hoa hồng cho người giới thiệu ra đơn.' },
  { t: 'Analyst', vi: 'Chuyên viên phân tích dữ liệu.', slug: 'bi-analyst-dinh-nghia-metric' },
  { t: 'API', ab: 'Application Programming Interface', vi: 'Giao diện để các phần mềm gọi dữ liệu/chức năng của nhau (vd gọi dịch vụ AI).', slug: 'multi-provider-byok' },
  { t: 'Cart abandonment', vi: 'Bỏ giỏ hàng: khách thêm vào giỏ nhưng không hoàn tất thanh toán.', slug: 'gio-hang-bo-quen' },
  { t: 'Cloud', vi: 'Điện toán đám mây: hạ tầng máy chủ thuê qua internet, trả theo mức dùng.', slug: 'data-warehouse-sme' },
  { t: 'CMGR', ab: 'Compound Monthly Growth Rate', vi: 'Tốc độ tăng trưởng kép theo tháng.', slug: 'growth-accounting-thuc-chien' },
  { t: 'COO', ab: 'Chief Operating Officer', vi: 'Giám đốc vận hành.', slug: 'coo-bao-cao-tuc-thi' },
  { t: 'CRM', ab: 'Customer Relationship Management', vi: 'Phần mềm quản lý quan hệ khách hàng.' },
  { t: 'Cross-sell', vi: 'Bán chéo: gợi khách mua thêm sản phẩm liên quan.', slug: 'rfm-segmentation' },
  { t: 'CTR', ab: 'Click-Through Rate', vi: 'Tỷ lệ nhấp: số lần nhấp chia số lần hiển thị (quảng cáo).' },
  { t: 'DAX', ab: 'Data Analysis Expressions', vi: 'Ngôn ngữ công thức riêng của Power BI.', slug: 'semantix-vs-power-bi' },
  { t: 'Data residency', vi: 'Nơi cư trú của dữ liệu: dữ liệu được lưu và xử lý ở đâu, theo quy định nào.', slug: 'multi-provider-byok' },
  { t: 'Drill-down', vi: 'Khoan sâu: bấm vào một con số tổng để xem chi tiết từng lớp bên dưới.', slug: 'tien-hoa-bi' },
  { t: 'Drop-off', vi: 'Tỷ lệ rớt khỏi một bước trong phễu (số người không đi tiếp).', slug: 'funnel-analysis' },
  { t: 'Entity', vi: 'Thực thể nghiệp vụ (khách hàng, đơn hàng, sản phẩm) được mô hình hóa trong semantic layer.', slug: 'semantic-layer-vs-chatbot-database' },
  { t: 'ERP', ab: 'Enterprise Resource Planning', vi: 'Phần mềm quản trị tổng thể nguồn lực và vận hành doanh nghiệp.' },
  { t: 'Expansion revenue', vi: 'Doanh thu mở rộng: phần khách cũ chi thêm (nâng gói, mua thêm).', slug: 'growth-accounting-revenue' },
  { t: 'F&B', ab: 'Food & Beverage', vi: 'Ngành ăn uống (nhà hàng, quán, chuỗi).', slug: 'chuoi-fnb-8-chi-nhanh' },
  { t: 'Flash sale', vi: 'Đợt giảm giá chớp nhoáng theo khung giờ.' },
  { t: 'Heatmap', vi: 'Biểu đồ nhiệt: dùng đậm/nhạt màu để thể hiện độ lớn của giá trị.' },
  { t: 'Histogram', vi: 'Biểu đồ phân phối: cho thấy số liệu tụ ở đâu và lệch ra sao.', slug: 'rfm-nang-cao' },
  { t: 'Holdout', vi: 'Nhóm đối chứng cố ý không tác động, để đo hiệu quả thật của chiến dịch.' },
  { t: 'Insight', vi: 'Hiểu biết hành động được rút ra từ dữ liệu (khác với con số mô tả thuần).' },
  { t: 'Join', vi: 'Nối hai bảng theo khóa chung; nối sai quan hệ làm số bị nhân bản.', slug: 'semantic-layer-vs-chatbot-database' },
  { t: 'KOC', ab: 'Key Opinion Consumer', vi: 'Người tiêu dùng có sức ảnh hưởng, hay review và bán hàng.' },
  { t: 'License', vi: 'Giấy phép sử dụng phần mềm trả phí (thường theo người dùng hoặc theo bản cài).' },
  { t: 'Lift', vi: 'Phần kết quả tăng thêm nhờ một chiến dịch, so với khi không làm gì.' },
  { t: 'LookML', vi: 'Ngôn ngữ định nghĩa mô hình dữ liệu của Looker.' },
  { t: 'Long tail', vi: 'Cái đuôi dài: rất nhiều mục giá trị nhỏ, cộng lại vẫn đáng kể.', slug: 'pareto-80-20' },
  { t: 'Margin', match: ['margin', 'biên lợi nhuận'], vi: 'Biên lợi nhuận: phần lời còn lại trên mỗi đồng doanh thu sau chi phí.', slug: 'dashboard-doanh-thu-fnb' },
  { t: 'ML', ab: 'Machine Learning', vi: 'Học máy: máy tự rút quy luật từ dữ liệu thay vì lập trình tay từng luật.' },
  { t: 'Model (AI)', match: ['model', 'mô hình'], vi: 'Mô hình AI đã huấn luyện: nhận đầu vào và sinh ra đầu ra.' },
  { t: 'MRR', ab: 'Monthly Recurring Revenue', vi: 'Doanh thu định kỳ (thuê bao) hàng tháng.', slug: 'cohort-retention-pmf' },
  { t: 'Negative churn', vi: 'Churn âm: khách cũ chi thêm đủ nhiều để lấn át phần doanh thu rời bỏ.', slug: 'growth-accounting-revenue' },
  { t: 'NRR', ab: 'Net Revenue Retention', vi: 'Tỷ lệ giữ doanh thu từ tập khách cũ (cộng mở rộng, trừ rời bỏ) — biến thể theo doanh thu của NDR.', slug: 'growth-accounting-revenue' },
  { t: 'Onboarding', vi: 'Dẫn dắt khách/người dùng mới làm quen để nhanh nhận được giá trị.' },
  { t: 'Open-source', vi: 'Mã nguồn mở: phần mềm công khai mã, dùng/sửa miễn phí nhưng tốn người vận hành.', slug: 'vs-metabase-superset' },
  { t: 'Pipeline', vi: 'Đường ống dữ liệu: quy trình tự động đưa dữ liệu từ nguồn về kho.', slug: 'etl-vs-elt' },
  { t: 'Pivot table', vi: 'Bảng tổng hợp xoay chiều trong bảng tính: kéo trường vào hàng/cột để tổng hợp số liệu.' },
  { t: 'POS', ab: 'Point of Sale', vi: 'Phần mềm/máy bán hàng tại quầy.', slug: 'chuoi-fnb-8-chi-nhanh' },
  { t: 'Prompt', vi: 'Đoạn văn bản (chỉ dẫn + ngữ cảnh) nạp cho mô hình AI để nó trả lời.', slug: 'toi-uu-chi-phi-token-ai' },
  { t: 'Quintile', vi: 'Chia tệp khách thành 5 phần bằng nhau để chấm điểm (dùng trong RFM).', slug: 'rfm-nang-cao' },
  { t: 'Segment', vi: 'Phân khúc: nhóm khách/đơn theo tiêu chí chung để xử lý khác nhau.', slug: 'rfm-segmentation' },
  { t: 'Self-hosted', vi: 'Tự chạy phần mềm trên hạ tầng của mình (tương tự on-premise).' },
  { t: 'Sell-through', vi: 'Tốc độ bán ra so với lượng nhập/tồn trong một khoảng thời gian.' },
  { t: 'SKU', ab: 'Stock Keeping Unit', vi: 'Đơn vị lưu kho: mã định danh từng loại hàng để theo dõi tồn kho và doanh số.', slug: 'hop-nhat-da-kenh' },
  { t: 'SME', ab: 'Small and Medium Enterprise', vi: 'Doanh nghiệp vừa và nhỏ.', slug: 'bi-cho-sme' },
  { t: 'TCO', ab: 'Total Cost of Ownership', vi: 'Tổng chi phí thật khi sở hữu một công cụ, gồm cả chi phí ẩn (người vận hành, hạ tầng…).', slug: 'vs-metabase-superset' },
  { t: 'Up-sell', vi: 'Bán nâng cấp: gợi khách lên phiên bản/gói cao hơn.' },
  { t: 'Vendor lock-in', vi: 'Khóa nhà cung cấp: rời đi tốn kém tới mức bạn ở lại dù nó không còn tốt nhất.', slug: 'multi-provider-byok' },
  { t: 'Win-back', vi: 'Giành lại khách cũ đã rời bỏ.', slug: 'rfm-nang-cao' },
  { t: 'MoM', ab: 'Month-over-Month', match: ['mom', 'month-over-month'], vi: 'So sánh với kỳ liền trước (tháng này vs tháng trước) — nhạy mùa vụ nên dễ đánh lừa nếu không kèm YoY.', slug: 'doc-tang-truong-mom-yoy' },
  { t: 'CAGR', ab: 'Compound Annual Growth Rate', match: ['cagr', 'tăng trưởng kép'], vi: 'Tốc độ tăng trưởng kép trung bình mỗi năm; 10%/tháng KHÔNG phải 120%/năm mà ~214%.', slug: 'doc-tang-truong-mom-yoy' },
  { t: 'Dữ liệu cá nhân', ab: 'Personal data', match: ['dữ liệu cá nhân', 'personal data'], vi: 'Thông tin gắn với một người (tên, SĐT, địa chỉ, lịch sử mua); thu thập/dùng phải tuân Nghị định 13/2023.', slug: 'bao-ve-du-lieu-ca-nhan-nghi-dinh-13' },
  { t: 'Sự đồng ý', ab: 'Consent', match: ['sự đồng ý', 'consent'], vi: 'Khách phải được hỏi và đồng ý rõ trước khi bạn thu thập/dùng dữ liệu cá nhân của họ (vd gửi tin marketing).', slug: 'bao-ve-du-lieu-ca-nhan-nghi-dinh-13' },
  { t: 'Nghị định 13', ab: '13/2023/NĐ-CP', match: ['nghị định 13', 'pdpd'], vi: 'Nghị định bảo vệ dữ liệu cá nhân của Việt Nam (hiệu lực 1/7/2023): quy định về sự đồng ý, quyền của chủ thể dữ liệu và nghĩa vụ bảo vệ.', slug: 'bao-ve-du-lieu-ca-nhan-nghi-dinh-13' },
  { t: 'Standard deviation', ab: 'SD / σ', match: ['độ lệch chuẩn', 'standard deviation'], vi: 'Độ lệch chuẩn: đo độ phân tán của dữ liệu quanh trung bình; cùng đơn vị với dữ liệu nên dễ đọc. Mean phải đi kèm nó mới đủ nghĩa.', slug: 'do-lech-chuan' },
  { t: 'Variance', match: ['phương sai', 'variance'], vi: 'Phương sai: trung bình bình phương khoảng cách tới mean; căn bậc hai của nó là độ lệch chuẩn.', slug: 'do-lech-chuan' },
  { t: 'Percentile', match: ['phân vị', 'percentile', 'p90', 'p99'], vi: 'Phân vị: mốc mà một tỉ lệ phần trăm dữ liệu nằm dưới (P90 = 90% trường hợp tốt/nhỏ hơn mức này). Đo thời gian giao/phản hồi nên nhìn P90/P99 thay vì trung bình.', slug: 'phan-vi-percentile' },
  { t: 'Quartile', match: ['tứ phân vị', 'quartile'], vi: 'Tứ phân vị: chia dữ liệu thành 4 phần bằng nhau (Q1=P25, Q2=P50=median, Q3=P75); khoảng giữa Q1–Q3 là IQR.', slug: 'phan-vi-percentile' },
  { t: 'Box plot', match: ['box plot', 'biểu đồ hộp'], vi: 'Biểu đồ hộp: tóm tắt phân phối qua median, tứ phân vị và ngoại lai trên một hình nhỏ gọn.', slug: 'phan-vi-percentile' },
  { t: 'Normal distribution', match: ['phân phối chuẩn', 'normal distribution'], vi: 'Phân phối chuẩn: hình chuông đối xứng quanh mean; khi dữ liệu gần chuẩn thì mean và độ lệch chuẩn mới đáng tin.', slug: 'doc-hinh-dang-phan-phoi' },
  { t: 'Skewness', match: ['skew', 'phân phối lệch', 'lệch phải', 'lệch trái'], vi: 'Độ lệch: phân phối nghiêng về một phía (lệch phải/trái) do vài giá trị lớn kéo đuôi — khi đó mean khác median, nên dùng median.', slug: 'doc-hinh-dang-phan-phoi' },
  { t: 'Bimodal', match: ['hai đỉnh', 'bimodal'], vi: 'Phân phối hai đỉnh: thực ra là hai nhóm khác nhau trộn lẫn (vd khách sỉ và khách lẻ) — dấu hiệu cần tách nhóm ra phân tích riêng.', slug: 'doc-hinh-dang-phan-phoi' },
  { t: 'Percentage point', ab: 'ppt', match: ['điểm phần trăm', 'percentage point'], vi: 'Điểm phần trăm: đơn vị chênh lệch giữa hai tỉ lệ. Từ 10% lên 12% là +2 điểm phần trăm (nhưng +20% tương đối) — trộn hai khái niệm là sai.', slug: 'phan-tram-vs-diem-phan-tram' },
  { t: 'Weighted average', match: ['trung bình có trọng số', 'weighted average', 'trọng số'], vi: 'Trung bình có trọng số: bình quân nhưng cân theo cỡ mỗi nhóm (số đơn, số khách) — bình quân các tỉ lệ của nhóm khác cỡ mà không cân là sai.', slug: 'trung-binh-co-trong-so' },
  { t: 'Chart junk', match: ['chart junk', 'chart-junk'], vi: 'Rác trang trí trên biểu đồ (3D, gradient loè loẹt, lưới đậm, nền ảnh) không mang thông tin — làm loãng thông điệp.', slug: 'chart-junk-toi-gian' },
  { t: 'Data-ink ratio', match: ['data-ink', 'data ink'], vi: 'Tỉ lệ "mực dành cho dữ liệu": phần nét vẽ thật sự biểu diễn số liệu trên tổng nét vẽ; càng cao biểu đồ càng sạch nghĩa (Tufte).', slug: 'chart-junk-toi-gian' },
  { t: 'Scatter', ab: 'Scatter plot', match: ['scatter', 'phân tán'], vi: 'Biểu đồ phân tán: mỗi điểm là một quan sát đặt theo hai trục, để nhìn quan hệ giữa hai biến.', slug: 'chon-dung-bieu-do' },
  { t: 'Threshold', match: ['ngưỡng', 'threshold'], vi: 'Ngưỡng: mức ranh giới để đánh dấu/cảnh báo khi một chỉ số vượt lên hoặc tụt xuống, giúp mắt biết chỗ cần nhìn.', slug: 'dashboard-hanh-dong-duoc' },
  { t: 'Baseline (dự báo)', match: ['baseline', 'dự báo ngây thơ'], vi: 'Dự báo cơ sở "ngây thơ" (vd kỳ sau bằng kỳ này, hoặc bằng cùng kỳ năm trước) — mốc tối thiểu mà mọi mô hình phức tạp hơn phải vượt qua.', slug: 'du-bao-la-gi' },
  { t: 'Forecast error', match: ['sai số dự báo', 'forecast error'], vi: 'Sai số dự báo: khoảng lệch giữa số dự báo và số thực tế; dự báo tốt luôn kèm khoảng sai số, không chỉ một con số.', slug: 'du-bao-la-gi' },
  { t: 'Year-over-year', ab: 'YoY', match: ['year-over-year', 'cùng kỳ', 'yoy'], vi: 'So sánh cùng kỳ năm trước (tháng/quý này năm nay vs năm ngoái) để loại ảnh hưởng mùa vụ.', slug: 'mua-vu-tet-seasonality' },
  { t: 'Lead time', match: ['lead time', 'lead-time'], vi: 'Thời gian từ lúc đặt hàng tới lúc hàng về kho — phải cộng vào khi tính điểm đặt hàng.', slug: 'du-bao-ton-kho-thuc-chien' },
  { t: 'Safety stock', match: ['safety stock', 'tồn an toàn'], vi: 'Tồn an toàn: lượng hàng dự trữ thêm phòng nhu cầu tăng đột biến hoặc giao trễ.', slug: 'du-bao-ton-kho-thuc-chien' },
  { t: 'Reorder point', match: ['reorder', 'điểm đặt hàng', 'ngưỡng đặt hàng lại'], vi: 'Điểm đặt hàng (ngưỡng đặt hàng lại): mức tồn mà khi chạm tới thì phải đặt hàng mới (= nhu cầu trong lead time + tồn an toàn).', slug: 'du-bao-ton-kho-thuc-chien' },
  { t: 'Stockout', match: ['stockout', 'hết hàng', 'cháy hàng'], vi: 'Hết hàng: khách muốn mua mà kho đã cạn — mất đơn ngay lúc đó và có thể mất luôn khách. Mặt trái của tồn chết (ôm mã ế).', slug: 'theo-doi-ton-kho-realtime' },
  { t: 'OEC', ab: 'Overall Evaluation Criterion', match: ['oec', 'north star', 'north-star'], vi: 'Metric chính duy nhất quyết định một thử nghiệm thắng hay thua, chọn trước khi chạy test.', slug: 'thiet-ke-ab-test' },
  { t: 'Controlled experiment', match: ['thử nghiệm có kiểm soát', 'controlled experiment'], vi: 'Thử nghiệm có kiểm soát: chia ngẫu nhiên hai nhóm, chỉ khác một biến, chạy đồng thời để so kết quả.', slug: 'hippo-vs-thu-nghiem' },
  { t: 'Sample size', match: ['cỡ mẫu', 'sample size'], vi: 'Cỡ mẫu: số quan sát trong một thử nghiệm/khảo sát; quá nhỏ thì kết quả dễ do may rủi.', slug: 'mau-va-tong-the' },
  { t: 'Peeking', match: ['peeking'], vi: 'Nhìn lén kết quả test liên tục rồi dừng ngay khi thấy thắng — làm tăng mạnh nguy cơ kết luận sai.', slug: 'doc-ket-qua-ab-test' },
  { t: 'Statistical significance', match: ['ý nghĩa thống kê', 'statistical significance'], vi: 'Ý nghĩa thống kê: khác biệt đủ lớn để khó là do dao động ngẫu nhiên — KHÔNG đồng nghĩa với quan trọng về kinh doanh.', slug: 'do-tin-cay-p-value' },
  { t: 'Sample', match: ['sample', 'mẫu đại diện', 'lấy mẫu'], vi: 'Mẫu: phần lấy ra từ tổng thể để suy luận; phải đại diện và đủ lớn mới đáng tin.', slug: 'mau-va-tong-the' },
  { t: 'Population', match: ['tổng thể', 'population'], vi: 'Tổng thể: toàn bộ đối tượng bạn muốn kết luận (vd tất cả khách), khác với mẫu là phần lấy ra.', slug: 'mau-va-tong-the' },
  { t: 'Law of large numbers', match: ['luật số lớn', 'law of large numbers'], vi: 'Luật số lớn: mẫu càng lớn thì trung bình mẫu càng tiến gần giá trị thật của tổng thể.', slug: 'mau-va-tong-the' },
  { t: 'Selection bias', match: ['thiên lệch chọn mẫu', 'selection bias'], vi: 'Thiên lệch chọn mẫu: mẫu không đại diện vì cách chọn thiên về một nhóm (vd chỉ khảo sát khách còn ở lại).', slug: 'mau-va-tong-the' },
  { t: 'Survivorship bias', match: ['survivorship', 'thiên kiến sống sót', 'sống sót'], vi: 'Thiên kiến sống sót: chỉ nhìn "người còn lại" (khách trụ lại, sản phẩm thành công) mà bỏ qua những cái đã biến mất.', slug: 'mau-va-tong-the' },
  { t: 'p-value', match: ['p-value', 'trị số p'], vi: 'Trị số p: nếu thật ra KHÔNG có khác biệt, đây là khả năng thấy chênh lệch lớn như đã quan sát; p nhỏ = khó do may rủi. KHÔNG phải xác suất bạn đúng.', slug: 'do-tin-cay-p-value' },
  { t: 'Confidence interval', ab: 'CI', match: ['khoảng tin cậy', 'confidence interval'], vi: 'Khoảng tin cậy: dải giá trị hợp lý cho con số thật (vd 3% ± 0,5%); mẫu càng nhỏ khoảng càng rộng.', slug: 'do-tin-cay-p-value' },
  { t: 'Effect size', match: ['effect size', 'độ lớn hiệu ứng'], vi: 'Độ lớn hiệu ứng: mức chênh lệch thực tế lớn cỡ nào — quan trọng ngang việc nó có ý nghĩa thống kê hay không.', slug: 'do-tin-cay-p-value' },
  { t: 'p-hacking', match: ['p-hacking'], vi: 'Thử đi thử lại/cắt lát dữ liệu nhiều cách tới khi ra kết quả "có ý nghĩa" mong muốn — một dạng tự lừa.', slug: 'do-tin-cay-p-value' },
  { t: 'Base rate', match: ['base rate', 'tỉ lệ nền', 'tỷ lệ nền'], vi: 'Tỉ lệ nền: mức phổ biến sẵn có của một hiện tượng trong tổng thể; bỏ quên nó dẫn tới hiểu sai một tín hiệu hay độ chính xác.', slug: 'base-rate-xac-suat-nguoc' },
  { t: 'False positive', match: ['dương tính giả', 'false positive'], vi: 'Dương tính giả: hệ thống báo "có" nhưng thực ra "không" (vd cảnh báo gian lận oan).', slug: 'base-rate-xac-suat-nguoc' },
  { t: 'Bayes (xác suất ngược)', match: ['bayes', 'xác suất ngược'], vi: 'Tư duy Bayes: cập nhật niềm tin theo bằng chứng mới, có tính tới tỉ lệ nền — giải thích vì sao "test dương tính" chưa chắc đúng.', slug: 'base-rate-xac-suat-nguoc' },
  { t: 'Data leakage', match: ['data leakage', 'rò rỉ dữ liệu'], vi: 'Rò rỉ dữ liệu: thông tin tương lai/đáp án lọt vào lúc huấn luyện, làm độ chính xác ảo cao rồi sập khi chạy thật.', slug: 'du-lieu-ban-giet-model' },
  { t: 'Overfit', match: ['overfit', 'quá khớp'], vi: 'Quá khớp: mô hình "học thuộc" dữ liệu cũ (cả nhiễu) nên đúng lúc train nhưng sai khi gặp dữ liệu mới.', slug: 'du-lieu-ban-giet-model' },
  { t: 'IQR', ab: 'Interquartile Range', match: ['iqr', 'tứ phân vị'], vi: 'Khoảng tứ phân vị: khoảng giữa của dữ liệu (phân vị 25%–75%), dùng phát hiện ngoại lai mà không bị giá trị cực đoan kéo lệch.', slug: 'outlier-rac-hay-mo-vang' },
  { t: 'Imputation', match: ['điền khuyết', 'impute', 'imputation'], vi: 'Điền khuyết: thay giá trị thiếu bằng ước lượng (trung vị, theo nhóm…) thay vì xoá dòng — nhưng đôi khi "thiếu" lại là tín hiệu.', slug: 'thieu-du-lieu-cung-la-tin-hieu' },
  { t: 'Missing value', match: ['giá trị khuyết', 'missing value', 'ô trống'], vi: 'Giá trị khuyết: ô trống trong dữ liệu; việc một trường bị trống nhiều khi tự nó mang thông tin.', slug: 'thieu-du-lieu-cung-la-tin-hieu' },
  { t: 'Missing indicator', match: ['missing indicator', 'cột cờ', 'đã trống'], vi: 'Cột cờ "đã thiếu": thêm một cột đánh dấu ô nào bị trống, biến chính sự thiếu vắng thành một đặc trưng cho mô hình.', slug: 'thieu-du-lieu-cung-la-tin-hieu' },
  { t: 'MCAR / MAR / MNAR', match: ['mcar', 'mnar'], vi: 'Ba kiểu dữ liệu khuyết: thiếu ngẫu nhiên hoàn toàn / thiếu có điều kiện / thiếu không ngẫu nhiên — kiểu cuối mang thông tin, nguy hiểm nhất nếu điền bừa.', slug: 'thieu-du-lieu-cung-la-tin-hieu' },
  { t: 'Identity resolution', match: ['identity resolution', 'gộp định danh', 'gộp trùng', 'de-dup', 'dedup'], vi: 'Gộp định danh: nhận ra nhiều bản ghi rời rạc thực ra là cùng một khách (de-dup) trước khi tính LTV/cohort.', slug: 'de-dup-khach-hang-truoc-khi-tinh-ltv' },
  { t: 'Fuzzy match', match: ['fuzzy', 'so khớp mờ'], vi: 'So khớp mờ: ghép các bản ghi gần giống nhau (sai chính tả, khác định dạng) mà không cần trùng khít từng ký tự.', slug: 'de-dup-khach-hang-truoc-khi-tinh-ltv' },
  { t: 'Build-vs-buy', match: ['build-vs-buy', 'build vs buy'], vi: 'Bài toán tự xây vs mua sẵn: cân nhắc chi phí thật, thời gian và rủi ro giữa tự dựng giải pháp và mua công cụ có sẵn.', slug: 'build-vs-buy-bi' },
  { t: 'Schema linking', match: ['schema linking', 'nối lược đồ'], vi: 'Nối lược đồ: bước AI nối từ trong câu hỏi (vd "doanh thu") với đúng bảng và đúng cột trong cấu trúc database, trước khi viết SQL. Nối sai cột thì truy vấn vẫn chạy nhưng trả về số sai.', slug: 'schema-linking' },
  { t: 'Foreign key', match: ['foreign key', 'khóa ngoại', 'khoá ngoại'], vi: 'Khóa ngoại: cột chỉ sang bảng khác (vd orders.customer_id trỏ về customers.id) — tấm bản đồ cho biết các bảng join với nhau ra sao.', slug: 'schema-linking' },
  { t: 'SLA', ab: 'Service Level Agreement', match: ['sla'], vi: 'Cam kết mức dịch vụ: nhà cung cấp đảm bảo thời gian hoạt động/hỗ trợ ở mức đã hứa.', slug: 'vs-looker-studio-pro' },
  { t: 'Connector', match: ['connector', 'đầu nối'], vi: 'Đầu nối: thành phần kết nối công cụ phân tích với một nguồn dữ liệu; nguồn ngoài hệ sinh thái thường cần connector trả phí.', slug: 'vs-looker-studio' },
  { t: 'Looker Studio', ab: 'Google Data Studio', match: ['looker studio', 'data studio'], vi: 'Công cụ dashboard miễn phí của Google (bản trả phí là Looker Studio Pro); cắm tốt hệ Google nhưng vẫn là dashboard dựng sẵn.', slug: 'vs-looker-studio' },
  { t: 'Roll rate', match: ['roll rate', 'tỷ lệ chuyển nhóm', 'tỉ lệ chuyển nhóm', 'phân tích chuyển nhóm', 'chuyển nhóm', 'ma trận chuyển nhóm'], vi: 'Tỷ lệ chuyển nhóm: phần trăm một tập đối tượng dịch chuyển từ nhóm/trạng thái này sang nhóm khác giữa hai kỳ liên tiếp; đọc qua ma trận tô màu — dưới đường chéo là khách đang trượt xuống.', slug: 'roll-rate' },
  { t: 'Bucket', match: ['bucket', 'nhóm trạng thái'], vi: 'Nhóm/khoang: trạng thái mà một đối tượng được xếp vào ở mỗi kỳ (phân khúc RFM, bậc nợ theo DPD…) — đơn vị cơ bản trong phân tích roll rate.', slug: 'roll-rate' },
  { t: 'DPD', ab: 'Days Past Due', match: ['dpd', 'số ngày quá hạn', 'ngày quá hạn'], vi: 'Số ngày quá hạn thanh toán: dùng để xếp khoản vay vào các nhóm nợ (Nhóm 1 đúng hạn → Nhóm 5 nợ xấu); roll rate theo DPD là cảnh báo sớm trong cho vay.', slug: 'roll-rate' },
  { t: 'Survival analysis', match: ['survival analysis', 'phân tích sống sót'], vi: 'Phân tích sống sót: đo thời gian đến một sự kiện (khách rời bỏ, thiết bị hỏng) và vẽ đường cong giảm dần theo tuổi đời. Với SME, nó chính là đường retention của cohort.', slug: 'survival-analysis' },
  { t: 'Survival curve', match: ['survival curve', 'đường cong sống sót'], vi: 'Đường cong sống sót: trục dọc là % còn "sống" (còn hoạt động), trục ngang là tuổi đời từ lúc bắt đầu; xuất phát 100% và chỉ đi xuống. Đồng nhất với đường retention của cohort.', slug: 'survival-analysis' },
  { t: 'Censoring', match: ['censoring', 'cắt cụt', 'dữ liệu cắt cụt'], vi: 'Dữ liệu cắt cụt: khách chưa rời tính tới thời điểm quan sát — ta chỉ biết họ sống ít nhất tới hôm nay, chưa biết tổng tuổi thọ. "Chưa rời" không phải "sẽ ở mãi".', slug: 'survival-analysis' },
  { t: 'Kaplan–Meier', match: ['kaplan', 'kaplan-meier', 'kaplan–meier'], vi: 'Cách dựng đường cong sống sót xử lý đúng phần dữ liệu cắt cụt (censoring). Phương pháp gốc y sinh; Semantix không có module này nhưng dựng được đường cong thực dụng qua cohort.', slug: 'survival-analysis' },
  { t: 'Hazard rate', match: ['hazard rate', 'hazard', 'tỷ lệ rủi ro'], vi: 'Tỷ lệ rủi ro rời bỏ ngay tại một mốc tuổi, với điều kiện đã sống tới đó. Chỗ đường cong dốc nhất là nơi hazard cao nhất — thời điểm nên can thiệp giữ chân.', slug: 'survival-analysis' },
  { t: 'HEART framework', match: ['heart framework', 'khung heart', 'heart'], vi: 'Khung đo trải nghiệm người dùng của Google gồm 5 chiều — Happiness, Engagement, Adoption, Retention, Task success — bù chỗ mù của phễu AARRR: phễu đo số lượng, HEART đo chất lượng trải nghiệm.', slug: 'heart-framework' },
  { t: 'Happiness', match: ['happiness'], vi: 'Chiều "hài lòng" trong HEART: cảm nhận chủ quan của khách về sản phẩm (thích/bực, tin/ngờ), đo qua NPS, đánh giá sao, tỷ lệ phàn nàn.', slug: 'heart-framework' },
  { t: 'Engagement', match: ['engagement', 'gắn kết'], vi: 'Chiều "gắn kết" trong HEART: khách dùng sản phẩm sâu và thường xuyên tới đâu (số phiên/tuần, thời lượng) — coi chừng ép lên bằng thông báo dồn dập làm hỏng Happiness.', slug: 'heart-framework' },
  { t: 'Adoption', match: ['adoption', 'tiếp nhận'], vi: 'Chiều "tiếp nhận" trong HEART: tỷ lệ khách mới bắt đầu dùng một tính năng (vd % kích hoạt trong tuần đầu).', slug: 'heart-framework' },
  { t: 'Task success', match: ['task success', 'hoàn thành tác vụ'], vi: 'Chiều "hoàn thành tác vụ" trong HEART: khách làm xong việc họ định làm trơn tru tới đâu — tỷ lệ thành công, thời gian, số lỗi.', slug: 'heart-framework' },
  { t: 'Goals–Signals–Metrics', match: ['goals-signals-metrics', 'goals–signals–metrics', 'goals signals metrics', 'mục tiêu – tín hiệu – thước đo'], vi: 'Quy trình 3 bước của Google đi kèm HEART: từ Mục tiêu (thành công là gì) → Tín hiệu (hành vi quan sát được) → Thước đo (con số theo dõi); đi từ mục tiêu xuống số, không ngược lại.', slug: 'heart-framework' },
  { t: 'AARRR', ab: 'Acquisition, Activation, Retention, Referral, Revenue', match: ['aarrr', 'phễu hải tặc', 'pirate metrics'], vi: 'Khung "phễu hải tặc" 5 bước đo hành trình khách: thu hút → kích hoạt → giữ chân → giới thiệu → doanh thu. Đo số lượng dọc phễu; cặp với HEART để thấy cả chất lượng.', slug: 'aarrr-pirate-metrics' },
  { t: 'NPS', ab: 'Net Promoter Score', match: ['nps'], vi: 'Chỉ số đo mức khách sẵn lòng giới thiệu sản phẩm cho người khác (thang −100 đến 100) — một thước đo thường dùng cho chiều Happiness của HEART.', slug: 'heart-framework' },
  { t: 'PCA', ab: 'Principal Component Analysis', match: ['pca', 'phân tích thành phần chính'], vi: 'Phân tích thành phần chính: kỹ thuật giảm chiều gộp nhiều chỉ số tương quan thành vài trục mới (thành phần chính) giữ phần lớn thông tin — để nhìn ra cụm/phân khúc ẩn và vẽ được trên 2D.', slug: 'pca-principal-component' },
  { t: 'Dimensionality reduction', match: ['dimensionality reduction', 'giảm chiều'], vi: 'Giảm chiều: rút dữ liệu từ nhiều cột/chiều xuống vài chiều mà mất ít thông tin nhất, để vẽ được và nhìn ra cấu trúc ẩn.', slug: 'pca-principal-component' },
  { t: 'Principal component', match: ['principal component', 'thành phần chính', 'pc1', 'pc2'], vi: 'Thành phần chính: một trục mới do PCA tạo ra, chạy dọc hướng dữ liệu biến thiên nhiều nhất; là tổ hợp của nhiều cột gốc nên khó gọi tên bằng lời.', slug: 'pca-principal-component' },
  { t: 'Variance explained', ab: 'Phương sai giải thích', match: ['variance explained', 'phương sai giải thích', 'lượng phương sai', 'biến thiên'], vi: 'Lượng phương sai mỗi trục PCA giữ lại. PCA xếp các trục theo lượng phương sai giải thích — trục đầu giữ nhiều nhất; vài trục đầu thường gói gần hết thông tin.', slug: 'pca-principal-component' },
  { t: 'Clustering', match: ['clustering', 'gom cụm', 'phân cụm'], vi: 'Gom cụm: nhóm các điểm gần nhau thành phân khúc tự nhiên; thường chạy sau PCA để gán nghĩa cho các cụm hiện ra trên biểu đồ.', slug: 'pca-principal-component' },
  { t: 'Sentiment analysis', match: ['sentiment analysis', 'sentiment', 'phân tích cảm xúc'], vi: 'Phân tích cảm xúc: gán cho mỗi mẩu chữ (review, tin nhắn CSKH, bình luận) một nhãn tích cực / trung tính / tiêu cực, rồi đếm theo thời gian để biến kho chữ thành chỉ số theo dõi được. Tiếng Việt nhiều mỉa mai/sắc thái nên dùng làm tín hiệu xu hướng, không phải con số tuyệt đối.', slug: 'sentiment-analysis' },
  { t: 'NLP', ab: 'Natural Language Processing', match: ['nlp', 'xử lý ngôn ngữ tự nhiên'], vi: 'Xử lý ngôn ngữ tự nhiên: nhánh AI dạy máy đọc hiểu và xử lý chữ người viết — nền tảng cho việc gán nhãn cảm xúc cho từng review.', slug: 'sentiment-analysis' },
  { t: 'Polarity', match: ['polarity', 'cực cảm xúc'], vi: 'Cực cảm xúc: chiều của cảm xúc trong một mẩu chữ, chạy từ tích cực qua trung tính đến tiêu cực — đầu ra cơ bản của sentiment analysis.', slug: 'sentiment-analysis' },
  { t: 'Unstructured data', match: ['unstructured data', 'dữ liệu phi cấu trúc', 'phi cấu trúc'], vi: 'Dữ liệu phi cấu trúc: thông tin dạng chữ tự do (review, tin nhắn, bình luận) không nằm gọn trong cột để tính tổng — cần kỹ thuật như sentiment analysis mới đo được.', slug: 'sentiment-analysis' },
  { t: 'Root cause analysis', match: ['root cause analysis', 'root cause', 'phân tích nguyên nhân gốc', 'nguyên nhân gốc'], vi: 'Phân tích nguyên nhân gốc: truy ngược một kết quả (vd doanh thu giảm) về nguồn thật sự sinh ra nó, thay vì dừng ở triệu chứng bề mặt như "do thị trường".', slug: 'why-analysis' },
  { t: '5 Whys', match: ['5 whys', '5 lần hỏi vì sao', 'năm lần hỏi'], vi: '5 lần hỏi "vì sao": hỏi vì sao liên tiếp, mỗi câu trả lời lại thành câu hỏi tiếp theo, cho tới khi chạm nguyên nhân gốc có thể hành động được.', slug: 'why-analysis' },
  { t: 'Driver', match: ['driver', 'yếu tố tác động'], vi: 'Yếu tố tác động: đại lượng mà khi thay đổi sẽ làm con số tổng đổi theo (giá, lượng khách, cơ cấu sản phẩm) — đơn vị để phân rã khi truy "vì sao".', slug: 'why-analysis' },
  { t: 'Price–volume–mix', match: ['price-volume-mix', 'price–volume–mix', 'price volume mix', 'giá–lượng–cơ cấu', 'giá-lượng-cơ cấu'], vi: 'Giá – lượng – cơ cấu: khung phân rã thay đổi doanh thu thành ba driver — bán đắt/rẻ hơn (price), nhiều/ít hơn (volume), và tỷ trọng giữa các sản phẩm/kênh đổi (mix).', slug: 'why-analysis' },
  { t: 'Scenario analysis', match: ['scenario analysis', 'scenario', 'phân tích kịch bản', 'kịch bản'], vi: 'Phân tích kịch bản: thay vì một con số dự báo duy nhất, dựng vài tương lai khả dĩ (lạc quan / cơ sở / thận trọng) bằng cách đổi các giả định kinh doanh then chốt — để chuẩn bị cho cả dải khả năng thay vì cược vào một điểm.', slug: 'scenario-analysis' },
  { t: 'What-if', match: ['what-if', 'what if'], vi: 'Phân tích "nếu–thì": thử đổi một giả định (giá, lượng khách, chi phí…) rồi xem kết quả rẽ nhánh ra sao — cơ chế cốt lõi của scenario analysis.', slug: 'scenario-analysis' },
  { t: 'Sensitivity analysis', match: ['sensitivity analysis', 'phân tích độ nhạy', 'độ nhạy'], vi: 'Phân tích độ nhạy: nhúc nhích một biến (±10%) rồi đo kết quả lắc bao nhiêu, để biết biến nào lắc kết quả mạnh nhất và đáng đưa vào kịch bản.', slug: 'scenario-analysis' },
  { t: 'Base case', match: ['base case', 'best case', 'worst case', 'kịch bản cơ sở', 'kịch bản tốt nhất', 'kịch bản xấu nhất'], vi: 'Bộ ba kịch bản kinh điển: base case (cơ sở — mọi thứ như dự kiến), best case (tốt nhất — lạc quan) và worst case (xấu nhất — thận trọng), mỗi cái ứng với một câu chuyện giả định khác nhau.', slug: 'scenario-analysis' },
  { t: 'Assumption', match: ['assumption', 'giả định'], vi: 'Giả định: điều ngầm cho là đúng làm nền cho một dự báo/kế hoạch (vd "sức mua giữ nguyên"). Giả định viết ra thì tranh luận được; giả định ẩn thì âm thầm làm hỏng kế hoạch.', slug: 'scenario-analysis' },
  // Bổ sung: series Thiết kế kho dữ liệu + Hiểu chỉ số
  { t: 'Inmon', ab: 'Enterprise Data Warehouse', match: ['inmon', 'edw', 'enterprise data warehouse', 'top-down'], vi: 'Trường phái xây kho dữ liệu từ trên xuống: dựng một kho doanh nghiệp chuẩn hoá làm nguồn sự thật trước, rồi mới rút data mart cho từng phòng. Đối trọng của Kimball, hợp tổ chức lớn/ngành chặt chẽ.', slug: 'inmon-vs-kimball' },
  { t: 'Kimball', match: ['kimball', 'bottom-up'], vi: 'Trường phái xây kho dữ liệu từ dưới lên: dựng từng data mart dạng chiều (star schema) theo đúng câu hỏi cần trả lời, rồi gắn kết dần. Thực dụng, có giá trị sớm, hợp SME.', slug: 'kimball-dimensional-modeling' },
  { t: 'Mô hình hóa chiều', ab: 'Dimensional modeling', match: ['dimensional modeling', 'mo hinh hoa chieu', 'mô hình hóa chiều'], vi: 'Thiết kế dữ liệu xoay quanh câu hỏi phân tích thay vì quanh việc lưu trữ: tách bảng fact (số đo) và dimension (mô tả), cố ý phi chuẩn hoá để mỗi câu hỏi chạm ít bảng nhất.', slug: 'kimball-dimensional-modeling' },
  { t: 'Grain', match: ['grain', 'độ mịn', 'do min'], vi: 'Độ mịn của bảng fact: một dòng đại diện cho cái gì (một đơn? một dòng sản phẩm trong đơn?). Chọn grain trước tiên, mọi thứ khác theo sau — chọn sai là âm thầm mất câu hỏi.', slug: 'kimball-dimensional-modeling' },
  { t: 'Bus matrix', match: ['bus matrix', 'ma trận bus'], vi: 'Bảng đối chiếu các bảng fact với bộ dimension dùng chung giữa chúng — bộ khung để nhiều data mart gắn kết nhất quán thay vì rời rạc mỗi nơi một định nghĩa.', slug: 'kimball-dimensional-modeling' },
  { t: 'Star schema', match: ['star schema', 'lược đồ sao', 'luoc do sao'], vi: 'Lược đồ hình sao: bảng fact ở giữa, các dimension phẳng toả quanh — mỗi câu hỏi chỉ một bước nối, đọc nhanh và người không kỹ thuật cũng hiểu.', slug: 'star-vs-snowflake-schema' },
  { t: 'Snowflake schema', match: ['snowflake schema', 'lược đồ bông tuyết'], vi: 'Lược đồ bông tuyết: như star nhưng mỗi dimension lại tách nhỏ tiếp (chuẩn hoá) — ít trùng dữ liệu hơn nhưng phải join nhiều bảng hơn, hỏi chậm hơn.', slug: 'star-vs-snowflake-schema' },
  { t: 'Dimension table', match: ['dimension table', 'bảng dimension', 'bảng chiều'], vi: '"Dimension" là góc cắt số liệu (theo tỉnh, theo tháng); "dimension table" là cái bảng vật lý lưu mô tả của góc cắt đó. Cùng một từ, hai nghĩa — hay gây cãi nhau.', slug: 'dimension-table-vs-dimension' },
  { t: 'SCD', ab: 'Slowly Changing Dimension', match: ['scd', 'slowly changing dimension', 'chiều thay đổi chậm'], vi: 'Cách xử lý khi một thuộc tính mô tả (vd tỉnh của khách) đổi theo thời gian: Type 1 ghi đè, Type 2 thêm dòng giữ lịch sử, Type 3 giữ một mức cũ. Chọn sai là báo cáo lịch sử lệch.', slug: 'scd-slowly-changing-dimension' },
  { t: 'Snapshot table', match: ['snapshot table', 'bảng chụp', 'periodic snapshot', 'accumulating snapshot'], vi: 'Bảng fact "chụp ảnh" trạng thái theo chu kỳ (vd tồn kho cuối mỗi ngày) thay vì cộng dồn từng giao dịch — trả lời nhanh câu "tại thời điểm đó là bao nhiêu".', slug: 'snapshot-table' },
  { t: 'OLAP cube', match: ['olap cube', 'khối olap', 'slice and dice', 'slice dice'], vi: 'Nhìn dữ liệu như một khối nhiều chiều: drill down (bóc sâu), drill up (cuộn lên), pivot (xoay trục), slice/dice (cắt lát) — cùng một con số xoay được nhiều cách mà không cần nhiều báo cáo.', slug: 'olap-cube-drill-pivot' },
  { t: 'Data mart', match: ['data mart', 'quầy dữ liệu'], vi: 'Một "quầy" dữ liệu nhỏ cắt riêng cho một phòng ban từ kho chung — chỉ chứa bảng và chỉ số phòng đó cần, để khỏi lạc giữa hàng trăm bảng.', slug: 'data-mart-la-gi' },
  { t: 'Data catalog', match: ['data catalog', 'từ điển dữ liệu'], vi: 'Cuốn từ điển cho chính dữ liệu của bạn: ghi rõ mỗi bảng, mỗi cột thực sự chứa gì và ai sở hữu — để tri thức không nằm gọn trong đầu một người rồi bốc hơi khi họ nghỉ.', slug: 'data-catalog-tu-dien-du-lieu' },
  { t: 'Data quality', match: ['data quality', 'chất lượng dữ liệu'], vi: 'Chất lượng dữ liệu đo theo 6 chiều: chính xác, đầy đủ, nhất quán, kịp thời, hợp lệ, duy nhất. "Dữ liệu ổn" theo chiều nào mới là câu hỏi đúng.', slug: 'data-quality-la-gi' },
  { t: 'Thang đo dữ liệu', ab: '4 loại thang đo', match: ['thang đo', 'thang do', 'nominal', 'ordinal', 'interval', 'ratio', 'định danh', 'thứ bậc'], vi: 'Bốn loại thang đo (định danh, thứ bậc, khoảng, tỉ lệ) quyết định phép tính nào có nghĩa — vd "mã sản phẩm trung bình" là vô nghĩa vì mã chỉ là nhãn định danh.', slug: '4-loai-thang-do-du-lieu' },
  { t: 'Chỉ số dòng chảy & điểm', ab: 'Flow vs Stock', match: ['flow metric', 'stock metric', 'dòng chảy', 'chỉ số điểm', 'flow', 'stock'], vi: 'Chỉ số dòng chảy (flow) cộng dồn theo kỳ được (doanh thu cả năm = cộng 12 tháng); chỉ số điểm (stock) là trạng thái tại một thời điểm (tồn kho) — cộng các kỳ lại là sai.', slug: 'chi-so-dong-chay-vs-diem' },
  { t: 'Dòng tiền vs lợi nhuận', match: ['dòng tiền', 'dong tien', 'lợi nhuận', 'cash flow', 'profit'], vi: 'Lợi nhuận là lãi trên sổ sách; dòng tiền là tiền thật ra vào tài khoản. Báo lãi 200 triệu mà vẫn không đủ trả lương là vì hai con số này khác nhau.', slug: 'dong-tien-vs-loi-nhuan' },
  { t: 'Input vs Output metric', match: ['input metric', 'output metric', 'chỉ số đầu vào', 'chỉ số đầu ra'], vi: 'Output (doanh thu) là kết quả bạn không bấm nút đổi được; input (số cuộc gọi, lượt thêm giỏ) là cái lái được hôm nay để dời output ngày mai.', slug: 'input-vs-output-metrics' },
  { t: 'Business vs Customer metric', match: ['business metric', 'customer metric', 'chỉ số doanh nghiệp', 'chỉ số khách hàng'], vi: 'Chỉ số doanh nghiệp (doanh thu, số đơn) đo sức khoẻ công ty; chỉ số khách hàng (hài lòng, quay lại) đo sức khoẻ quan hệ — dashboard xanh mà khách đã âm thầm bỏ đi.', slug: 'business-metrics-vs-customer-metrics' },
  { t: 'Cảnh báo ngưỡng', ab: 'Threshold alert', match: ['threshold alert', 'cảnh báo ngưỡng', 'alert fatigue', 'cảnh báo kpi'], vi: 'Nhắn ngay khi một KPI vượt lằn ranh đặt trước, thay vì đợi báo cáo định kỳ. Đặt quá nhạy thì dính "alert fatigue" — reo nhiều tới mức người ta tắt sạch.', slug: 'canh-bao-kpi' },
];

// Sắp xếp A–Z theo thuật ngữ (không phân biệt hoa thường, bỏ ký tự đầu không phải chữ).
const collator = new Intl.Collator('vi', { sensitivity: 'base' });
terms.sort((a, b) => collator.compare(a.t, b.t));

function letterOf(t: string) {
  const c = t.replace(/[^A-Za-z]/, '').charAt(0).toUpperCase();
  return c || '#';
}

// Gom theo chữ cái đầu.
const groups: { letter: string; items: Term[] }[] = [];
for (const term of terms) {
  const L = letterOf(term.t);
  let g = groups.find(x => x.letter === L);
  if (!g) { g = { letter: L, items: [] }; groups.push(g); }
  g.items.push(term);
}
const letters = groups.map(g => g.letter);
const alphabet = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'.split('');

// "Xuất hiện trong" — tính tự động: quét nội dung mọi bài blog tìm thuật ngữ.
const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const usage = computeUsage(terms, posts);
---
<BaseLayout title="Từ điển thuật ngữ — Semantix Blog" description="Giải nghĩa tiếng Việt các thuật ngữ Data, BI và AI thường gặp: MAU, churn, cohort, RAG, ETL, semantic layer… Sắp xếp theo A–Z.">

<style>
  .glo-hero { padding: 110px 24px 56px; background: linear-gradient(160deg,#0F172A 0%,#1E1B4B 60%,#0F172A 100%); text-align: center; }
  .glo-hero h1 { font-size: clamp(30px,4.5vw,48px); font-weight: 900; color: #fff; letter-spacing: -1.2px; margin-bottom: 14px; }
  .glo-hero p  { font-size: 17px; color: #94A3B8; max-width: 560px; margin: 0 auto; line-height: 1.6; }

  .glo-body { max-width: 820px; margin: 0 auto; padding: 40px 24px 96px; }

  .glo-search { width: 100%; padding: 13px 18px; border-radius: 12px; border: 1px solid var(--border);
    font-size: 15px; background: var(--white); color: var(--dark); outline: none; margin-bottom: 20px; font-family: inherit; }
  .glo-search:focus { border-color: var(--primary); }

  .az-bar { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 36px; position: sticky; top: 72px; z-index: 5;
    background: rgba(255,255,255,.9); backdrop-filter: blur(8px); padding: 10px 0; }
  .az-link { width: 30px; height: 30px; display: flex; align-items: center; justify-content: center;
    border-radius: 8px; font-size: 13px; font-weight: 700; text-decoration: none; color: var(--dark-3);
    background: var(--surface); border: 1px solid var(--border); transition: background .15s, color .15s; }
  .az-link:hover { background: var(--primary); color: #fff; border-color: var(--primary); }
  .az-link.off { opacity: .3; pointer-events: none; }

  .glo-group { margin-bottom: 8px; scroll-margin-top: 130px; }
  .glo-letter { font-size: 22px; font-weight: 900; color: var(--primary); letter-spacing: -0.5px;
    padding-bottom: 8px; border-bottom: 2px solid var(--border); margin: 32px 0 18px; }
  .glo-item { padding: 16px 0; border-bottom: 1px solid var(--border); }
  .glo-term { font-size: 17px; font-weight: 800; color: var(--dark); letter-spacing: -0.2px; }
  .glo-ab { font-size: 13.5px; font-weight: 600; color: var(--muted); margin-left: 8px; }
  .glo-vi { font-size: 15px; color: var(--dark-2); line-height: 1.65; margin-top: 6px; }
  .glo-link { font-size: 13px; font-weight: 600; color: var(--primary); text-decoration: none; margin-top: 8px; display: inline-block; }
  .glo-link:hover { color: var(--primary-dark); text-decoration: underline; }

  .glo-usage { margin-top: 10px; font-size: 12.5px; line-height: 1.7; color: var(--muted); }
  .glo-usage-label { font-weight: 700; color: var(--dark-3); margin-right: 4px; }
  .glo-usage-link { color: var(--muted); text-decoration: none; }
  .glo-usage-link:hover { color: var(--primary); text-decoration: underline; }
  .glo-usage-link.primary { color: var(--primary); font-weight: 600; }
  .glo-sep { color: var(--border); }
  .glo-more { display: none; }
  .glo-usage.expanded .glo-more { display: inline; }
  .glo-usage-toggle { margin-left: 6px; font-size: 12.5px; font-weight: 600; color: var(--primary);
    background: none; border: none; padding: 0; cursor: pointer; font-family: inherit; }
  .glo-usage-toggle:hover { text-decoration: underline; }

  .glo-empty { text-align: center; color: var(--muted); padding: 40px 0; font-size: 15px; display: none; }
  .glo-back { display: inline-flex; align-items: center; gap: 6px; font-size: 14px; font-weight: 600; color: var(--primary); text-decoration: none; margin-bottom: 24px; }
</style>

<div class="glo-hero">
  <div class="badge" style="margin-bottom:18px"><span class="badge-dot"></span>Tra cứu nhanh</div>
  <h1>Từ điển thuật ngữ</h1>
  <p>Giải nghĩa tiếng Việt các thuật ngữ Data, BI và AI thường gặp trong blog — viết cho người làm, không phải người nghiên cứu.</p>
</div>

<div class="glo-body">
  <a href="/blog/" class="glo-back">← Tất cả bài viết</a>

  <input type="search" id="glo-search" class="glo-search" placeholder="Tìm thuật ngữ… (vd: MAU, churn, semantic layer)" autocomplete="off" />

  <div class="az-bar">
    {alphabet.map(L => (
      <a class={`az-link ${letters.includes(L) ? '' : 'off'}`} href={`#letter-${L}`}>{L}</a>
    ))}
  </div>

  {groups.map(g => (
    <section class="glo-group" id={`letter-${g.letter}`} data-letter={g.letter}>
      <div class="glo-letter">{g.letter}</div>
      {g.items.map(term => (
        <div class="glo-item" data-term={`${term.t} ${term.ab ?? ''} ${term.vi}`.toLowerCase()}>
          <div>
            <span class="glo-term">{term.t}</span>
            {term.ab && <span class="glo-ab">{term.ab}</span>}
          </div>
          <div class="glo-vi">{term.vi}</div>
          {usage.get(term.t) && usage.get(term.t)!.length > 0 && (
            <div class="glo-usage">
              <span class="glo-usage-label">Xuất hiện trong ({usage.get(term.t)!.length}):</span>
              {usage.get(term.t)!.map((u, i) => (
                <>
                  {i > 0 && <span class={`glo-sep${i >= 6 ? ' glo-more' : ''}`}> · </span>}
                  <a class={`glo-usage-link${u.primary ? ' primary' : ''}${i >= 6 ? ' glo-more' : ''}`} href={`/blog/${u.slug}/`}>{shortLabel(u.title)}</a>
                </>
              ))}
              {usage.get(term.t)!.length > 6 && (
                <button type="button" class="glo-usage-toggle" data-more={`+${usage.get(term.t)!.length - 6} nữa`}>+{usage.get(term.t)!.length - 6} nữa</button>
              )}
            </div>
          )}
          {(!usage.get(term.t) || usage.get(term.t)!.length === 0) && term.slug && (
            <a class="glo-link" href={`/blog/${term.slug}/`}>→ Đọc bài gần nhất</a>
          )}
        </div>
      ))}
    </section>
  ))}

  <div class="glo-empty" id="glo-empty">Không tìm thấy thuật ngữ nào khớp.</div>
</div>

<script>
  const search = document.getElementById('glo-search') as HTMLInputElement;
  const items = Array.from(document.querySelectorAll<HTMLElement>('.glo-item'));
  const groups = Array.from(document.querySelectorAll<HTMLElement>('.glo-group'));
  const empty = document.getElementById('glo-empty')!;

  // Bỏ dấu để tìm được cả khi gõ thiếu dấu.
  const norm = (s: string) => s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/đ/g, 'd');

  search.addEventListener('input', () => {
    const q = norm(search.value.trim());
    let anyVisible = false;
    items.forEach(it => {
      const match = !q || norm(it.dataset.term || '').includes(q);
      it.style.display = match ? '' : 'none';
      if (match) anyVisible = true;
    });
    // Ẩn nhóm chữ cái không còn mục nào hiện.
    groups.forEach(g => {
      const visible = g.querySelector('.glo-item:not([style*="display: none"])');
      g.style.display = visible ? '' : 'none';
    });
    empty.style.display = anyVisible ? 'none' : 'block';
  });

  // "Xuất hiện trong": chỉ hiện 6 bài đầu, còn lại bấm "+N nữa" để mở.
  document.querySelectorAll<HTMLButtonElement>('.glo-usage-toggle').forEach(btn => {
    btn.addEventListener('click', () => {
      const box = btn.closest('.glo-usage');
      if (!box) return;
      const expanded = box.classList.toggle('expanded');
      btn.textContent = expanded ? 'thu gọn' : (btn.dataset.more || '');
    });
  });
</script>

</BaseLayout>
