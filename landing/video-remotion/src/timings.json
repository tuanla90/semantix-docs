 [{"w": "chốt,", "s": 27.021, "e": 27.337}, {"w": "thì", "s": 27.378, "e": 27.661}, {"w": "không", "s": 27.661, "e": 28.01}, {"w": "gì", "s": 28.01, "e": 28.26}, {"w": "là", "s": 28.26, "e": 28.51}]}, {"text": "then chốt cả.", "start": 28.51, "end": 29.392, "words": [{"w": "then", "s": 28.51, "e": 28.826}, {"w": "chốt", "s": 28.826, "e": 29.142}, {"w": "cả.", "s": 29.142, "e": 29.392}]}], "05": [{"text": "Giờ quay lại phòng họp", "start": 0.1, "end": 1.629, "words": [{"w": "Giờ", "s": 0.1, "e": 0.385}, {"w": "quay", "s": 0.385, "e": 0.705}, {"w": "lại", "s": 0.705, "e": 0.99}, {"w": "phòng", "s": 0.99, "e": 1.343}, {"w": "họp", "s": 1.343, "e": 1.629}]}, {"text": "sáng thứ Hai, đọc lại", "start": 1.629, "end": 3.131, "words": [{"w": "sáng", "s": 1.629, "e": 1.948}, {"w": "thứ", "s": 1.948, "e": 2.233}, {"w": "Hai,", "s": 2.233, "e": 2.519}, {"w": "đọc", "s": 2.56, "e": 2.846}, {"w": "lại", "s": 2.846, "e": 3.131}]}, {"text": "bằng đúng ba từ vựng.", "start": 3.131, "end": 4.593, "words": [{"w": "bằng", "s": 3.131, "e": 3.45}, {"w": "đúng", "s": 3.45, "e": 3.77}, {"w": "ba", "s": 3.77, "e": 4.022}, {"w": "từ", "s": 4.022, "e": 4.274}, {"w": "vựng.", "s": 4.274, "e": 4.593}]}, {"text": "Một:", "start": 4.695, "end": 4.981, "words": [{"w": "Một:", "s": 4.695, "e": 4.981}]}, {"text": "cãi nhau vì metric doanh", "start": 5.083, "end": 6.679, "words": [{"w": "cãi", "s": 5.083, "e": 5.369}, {"w": "nhau", "s": 5.369, "e": 5.688}, {"w": "vì", "s": 5.688, "e": 5.94}, {"w": "metric", "s": 5.94, "e": 6.326}, {"w": "doanh", "s": 6.326, "e": 6.679}]}, {"text": "thu chưa có một định", "start": 6.679, "end": 8.141, "words": [{"w": "thu", "s": 6.679, "e": 6.964}, {"w": "chưa", "s": 6.964, "e": 7.284}, {"w": "có", "s": 7.284, "e": 7.536}, {"w": "một", "s": 7.536, "e": 7.822}, {"w": "định", "s": 7.822, "e": 8.141}]}, {"text": "nghĩa chung.", "start": 8.141, "end": 8.846, "words": [{"w": "nghĩa", "s": 8.141, "e": 8.493}, {"w": "chung.", "s": 8.493, "e": 8.846}]}, {"text": "Hai:", "star