ung", "s": 20.618, "e": 20.8}, {"w": "bình.", "s": 20.844, "e": 21.2}]}, {"text": "Bạn thấy ngay nó vô nghĩa.", "start": 21.245, "end": 22.618, "words": [{"w": "Bạn", "s": 21.245, "e": 21.382}, {"w": "thấy", "s": 21.411, "e": 21.527}, {"w": "ngay", "s": 21.585, "e": 21.818}, {"w": "nó", "s": 21.915, "e": 22.109}, {"w": "vô", "s": 22.182, "e": 22.327}, {"w": "nghĩa.", "s": 22.364, "e": 22.618}]}, {"text": "Nhưng với máy, hai phép tính y hệt nhau.", "start": 22.666, "end": 24.873, "words": [{"w": "Nhưng", "s": 22.666, "e": 22.909}, {"w": "với", "s": 22.964, "e": 23.127}, {"w": "máy,", "s": 23.182, "e": 23.418}, {"w": "hai", "s": 23.491, "e": 23.709}, {"w": "phép", "s": 23.753, "e": 23.927}, {"w": "tính", "s": 23.971, "e": 24.145}, {"w": "y", "s": 24.218, "e": 24.291}, {"w": "hệt", "s": 24.339, "e": 24.509}, {"w": "nhau.", "s": 24.553, "e": 24.873}]}, {"text": "Nó không biết cái nào có nghĩa.", "start": 24.921, "end": 26.364, "words": [{"w": "Nó", "s": 24.921, "e": 25.018}, {"w": "không", "s": 25.055, "e": 25.236}, {"w": "biết", "s": 25.265, "e": 25.382}, {"w": "cái", "s": 25.436, "e": 25.6}, {"w": "nào", "s": 25.636, "e": 25.745}, {"w": "có", "s": 25.794, "e": 25.891}, {"w": "nghĩa.", "s": 25.939, "e": 26.364}]}, {"text": "Nó chỉ thấy số, mà số thì cộng chia được tuốt.", "start": 26.425, "end": 29.236, "words": [{"w": "Nó", "s": 26.425, "e": 26.545}, {"w": "chỉ", "s": 26.582, "e": 26.691}, {"w": "thấy", "s": 26.735, "e": 26.909}, {"w": "số,", "s": 27.006, "e": 27.382}, {"w": "mà", "s": 27.443, "e": 27.564}, {"w": "số", "s": 27.661, "e": 27.855}, {"w": "thì", "s": 27.927, "e": 28.145}, {"w": "cộng", "s": 28.204, "e": 28.436}, {"w": "chia", "s": 28.495, "e": 28.727}, {"w": "được", "s": 28.771, "e": 28.945}, {"w": "tuốt.", "s": 28.994, "e": 29.236}]}], "01": [{"text": "Đây là cái bẫy ít người để ý:", "start": 0.0, "end": 1.673, "words": [{"w": "Đây", "s": 0.124, "e": 0.145}, {"w": "là", "s": 0.194, "e": 0.291}, {"w": "cái", "s": 0.327, "e": 0.436}, {"w": "bẫy", "s": 0.47