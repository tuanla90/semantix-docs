{"w": "gốc.", "s": 25.219, "e": 25.455}]}, {"text": "Loại này đo bằng trung vị, tức giá trị đứng giữa, chứ không phải trung bình.", "start": 25.528, "end": 29.528, "words": [{"w": "Loại", "s": 25.528, "e": 25.746}, {"w": "này", "s": 25.801, "e": 25.965}, {"w": "đo", "s": 26.062, "e": 26.255}, {"w": "bằng", "s": 26.299, "e": 26.474}, {"w": "trung", "s": 26.51, "e": 26.692}, {"w": "vị,", "s": 26.74, "e": 27.055}, {"w": "tức", "s": 27.092, "e": 27.201}, {"w": "giá", "s": 27.292, "e": 27.565}, {"w": "trị", "s": 27.619, "e": 27.783}, {"w": "đứng", "s": 27.826, "e": 28.001}, {"w": "giữa,", "s": 28.045, "e": 28.437}, {"w": "chứ", "s": 28.474, "e": 28.583}, {"w": "không", "s": 28.607, "e": 28.728}, {"w": "phải", "s": 28.772, "e": 28.946}, {"w": "trung", "s": 28.995, "e": 29.237}, {"w": "bình.", "s": 29.281, "e": 29.528}]}], "04": [{"text": "Nấc ba là khoảng.", "start": 0.0, "end": 1.018, "words": [{"w": "Nấc", "s": 0.0, "e": 0.145}, {"w": "ba", "s": 0.194, "e": 0.291}, {"w": "là", "s": 0.388, "e": 0.582}, {"w": "khoảng.", "s": 0.634, "e": 1.018}]}, {"text": "Khoảng cách đã đều thật, nhưng số không chỉ là quy ước.", "start": 1.2, "end": 4.509, "words": [{"w": "Khoảng", "s": 1.2, "e": 1.818}, {"w": "cách", "s": 1.847, "e": 1.964}, {"w": "đã", "s": 2.012, "e": 2.109}, {"w": "đều", "s": 2.164, "e": 2.327}, {"w": "thật,", "s": 2.371, "e": 2.909}, {"w": "nhưng", "s": 2.945, "e": 3.127}, {"w": "số", "s": 3.225, "e": 3.418}, {"w": "không", "s": 3.466, "e": 3.709}, {"w": "chỉ", "s": 3.764, "e": 3.927}, {"w": "là", "s": 3.952, "e": 4.0}, {"w": "quy", "s": 4.055, "e": 4.218}, {"w": "ước.", "s": 4.273, "e": 4.509}]}, {"text": "Nhiệt độ chẳng hạn.", "start": 4.764, "end": 5.818, "words": [{"w": "Nhiệt", "s": 4.764, "e": 5.236}, {"w": "độ", "s": 5.261, "e": 5.309}, {"w": "chẳng", "s": 5.334, "e": 5.455}, {"w": "hạn.", "s": 5.527, "e": 5.818}]}, {"text": "Từ hai mươi lên hai mốt độ đúng bằng từ ba mươi lên ba mốt.", "start": 5.964, "end": 10.0, "words": [{"w": "Từ", "s": 5.964, "e": 6.255}, {"w": "hai", "s": 6.291, "e": 6.4}, {"w": "mươi", "s": 6.473, "e": 6.618}, {"w": "lên", "s": 6.727, "e": 7.055}, {"w": "hai", "s": 7.091, "e": 7.2}, {"w": "mốt", "s": 7.273, "e": 7.491}, {"w": "độ", "s": 7.539, "e": 7.636}, {"w": "đúng", "s": 7.695, "e": 7.927}, {"w": "bằng", "s": 7.971, "e": 8.145}, {"w": "từ", "s": 8.218, "e": 8.364}, {"w": "ba", "s": 8.436, "e": 8.582}, {"w": "mươi", "s": 8.655, "e": 8.8}, {"w": "lên", "s": 8.927, "e": 9.309}, {"w": "ba", "s": 9.334, "e": 9.382}, {"w": "mốt.", "s": 9.455, "e": 10.0}]}, {"text": "Nhưng bốn mươi độ không nóng gấp đôi hai mươi độ, vì không có gốc không thật để mà so gấp mấy lần.", "start": 10.066, "end": 15.927, "words": [{"w": "Nhưng", "s": 10.066, "e": 10.4}, {"w": "bốn", "s": 10.509, "e": 10.836}, {"w": "mươi", "s": 10.873, "e": 10.982}, {"w": "độ", "s": 11.079, "e": 11.273}, {"w": "không", "s": 11.334, "e": 11.636}, {"w": "nóng", "s": 11.68, "e": 11.855}, {"w": "gấp", "s": 11.909, "e": 12.073}, {"w": "đôi", "s": 12.127, "e": 12.291}, {"w": "hai", "s": 12.327, "e": 12.436}, {"w": "mươi", "s": 12.509, "e": 12.691}, {"w": "độ,", "s": 12.727, "e": 12.945}, {"w": "vì", "s": 13.115, "e": 13.455}, {"w": "không", "s": 13.491, "e": 13.673}, {"w": "có", "s": 13.721, "e": 13.818}, {"w": "gốc", "s": 13.873, "e": 14.036}, {"w": "không", "s": 14.073, "e": 14.255}, {"w": "thật", "s": 14.298, "e": 14.473}, {"w": "để", "s": 14.594, "e": 14.836}, {"w": "mà", "s": 14.885, "e": 14.982}, {"w": "so", "s": 15.055, "e": 15.2}, {"w": "gấp", "s": 15.255, "e": 15.418}, {"w": "mấy", "s": 15.455, "e": 15.564}, {"w": "lần.", "s": 15.636, "e": 15.927}]}, {"text": "Nấc trên cùng mới là tỉ lệ:", "start": 16.255, "end": 18.036, "words": [{"w": "Nấc", "s": 16.255, "e": 16.727}, {"w": "trên", "s": 16.756, "e": 16.873}, {"w": "cùng", "s": 16.931, "e": 17.164}, {"w": "mới", "s": 17.236, "e": 17.455}, {"w": "là", "s": 17.503, "e": 17.6}, {"w": "tỉ", "s": 17.648, "e": 17.745}, {"w": "lệ:", "s": 17.818, "e": 18.036}]}, {"text": "có gốc không thật.",