{"00": [{"text": "Đừng tính trung bình mã sản phẩm.", "start": 0.0, "end": 1.309, "words": [{"w": "Đừng", "s": 0.124, "e": 0.145}, {"w": "tính", "s": 0.189, "e": 0.364}, {"w": "trung", "s": 0.388, "e": 0.509}, {"w": "bình", "s": 0.553, "e": 0.727}, {"w": "mã", "s": 0.775, "e": 0.873}, {"w": "sản", "s": 0.927, "e": 1.091}, {"w": "phẩm.", "s": 1.12, "e": 1.309}]}, {"text": "Nghe thì hiển nhiên, đúng không?", "start": 1.406, "end": 2.764, "words": [{"w": "Nghe", "s": 1.406, "e": 1.673}, {"w": "thì", "s": 1.709, "e": 1.818}, {"w": "hiển", "s": 1.862, "e": 2.036}, {"w": "nhiên,", "s": 2.073, "e": 2.4}, {"w": "đúng", "s": 2.429, "e": 2.545}, {"w": "không?", "s": 2.57, "e": 2.764}]}, {"text": "Vậy thử cái này với mình.", "start": 2.873, "end": 4.073, "words": [{"w": "Vậy", "s": 2.873, "e": 3.2}, {"w": "thử", "s": 3.255, "e": 3.418}, {"w": "cái", "s": 3.455, "e": 3.564}, {"w": "này", "s": 3.6, "e": 3.709}, {"w": "với", "s": 3.745, "e": 3.855}, {"w": "mình.", "s": 3.884, "e": 4.073}]}, {"text": "Bôi đen cột mức hài lòng trong ếch xeo, toàn số một tới năm, gõ ơ vơ rịt.", "start": 4.218, "end": 9.236, "words": [{"w": "Bôi", "s": 4.218, "e": 4.436}, {"w": "đen", "s": 4.491, "e": 4.655}, {"w": "cột", "s": 4.691, "e": 4.873}, {"w": "mức", "s": 4.909, "e": 5.018}, {"w": "hài", "s": 5.055, "e": 5.164}, {"w": "lòng", "s": 5.207, "e": 5.382}, {"w": "trong", "s": 5.406, "e": 5.527}, {"w": "ếch", "s": 5.6, "e": 5.673}, {"w": "xeo,", "s": 5.745, "e": 5.964}, {"w": "toàn", "s": 6.022, "e": 6.255}, {"w": "số", "s": 6.327, "e": 6.473}, {"w": "một", "s": 6.527, "e": 6.691}, {"w": "tới", "s": 6.745, "e": 6.909}, {"w": "năm,", "s": 6.945, "e": 7.127}, {"w": "gõ", "s": 7.309, "e": 7.564}, {"w": "ơ", "s": 7.927, "e": 8.145}, {"w": "vơ", "s": 8.327, "e": 8.727}, {"w": "rịt.", "s": 8.873, "e": 9.236}]}, {"text": "Máy nhả ra ba phẩy bốn sao.", "start": 9.309, "end": 10.982, "words": [{"w": "Máy", "s": 9.309, "e": 9.527}, {"w": "nhả", "s": 9.575, "e": 9.745}, {"w": "ra", "s": 9.818, "e": 9.964}, {"