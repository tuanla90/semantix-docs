, "e": 15.891}]}, {"text": "Với loại này bạn chỉ được đếm mỗi nhóm bao nhiêu, và tìm cái xuất hiện nhiều nhất.", "start": 15.991, "end": 20.8, "words": [{"w": "Với", "s": 15.991, "e": 16.291}, {"w": "loại", "s": 16.335, "e": 16.509}, {"w": "này", "s": 16.564, "e": 16.727}, {"w": "bạn", "s": 16.855, "e": 17.236}, {"w": "chỉ", "s": 17.273, "e": 17.382}, {"w": "được", "s": 17.411, "e": 17.527}, {"w": "đếm", "s": 17.575, "e": 17.745}, {"w": "mỗi", "s": 17.818, "e": 18.036}, {"w": "nhóm", "s": 18.095, "e": 18.327}, {"w": "bao", "s": 18.4, "e": 18.618}, {"w": "nhiêu,", "s": 18.655, "e": 18.982}, {"w": "và", "s": 19.103, "e": 19.345}, {"w": "tìm", "s": 19.418, "e": 19.636}, {"w": "cái", "s": 19.691, "e": 19.855}, {"w": "xuất", "s": 19.884, "e": 20.0}, {"w": "hiện", "s": 20.044, "e": 20.218}, {"w": "nhiều", "s": 20.266, "e": 20.509}, {"w": "nhất.", "s": 20.553, "e": 20.8}]}, {"text": "Trung bình thì không bao giờ.", "start": 20.897, "end": 22.691, "words": [{"w": "Trung", "s": 20.897, "e": 21.382}, {"w": "bình", "s": 21.425, "e": 21.6}, {"w": "thì", "s": 21.691, "e": 21.964}, {"w": "không", "s": 22.012, "e": 22.255}, {"w": "bao", "s": 22.291, "e": 22.4}, {"w": "giờ.", "s": 22.455, "e": 22.691}]}], "03": [{"text": "Lên một nấc là thứ bậc.", "start": 0.0, "end": 1.236, "words": [{"w": "Lên", "s": 0.0, "e": 0.145}, {"w": "một", "s": 0.182, "e": 0.291}, {"w": "nấc", "s": 0.364, "e": 0.582}, {"w": "là", "s": 0.63, "e": 0.727}, {"w": "thứ", "s": 0.782, "e": 0.945}, {"w": "bậc.", "s": 1.0, "e": 1.236}]}, {"text": "Và đây đúng chỗ ba phẩy bốn sao bị lật tẩy.", "start": 1.491, "end": 4.365, "words": [{"w": "Và", "s": 1.807, "e": 1.819}, {"w": "đây", "s": 1.892, "e": 2.11}, {"w": "đúng", "s": 2.197, "e": 2.546}, {"w": "chỗ", "s": 2.619, "e": 2.837}, {"w": "ba", "s": 2.935, "e": 3.128}, {"w": "phẩy", "s": 3.176, "e": 3.383}, {"w": "bốn", "s": 3.41, "e": 3.492}, {"w": "sao", "s": 3.565, "e": 3.783}, {"w": "bị", "s": 3.831, "e": 3.928}, {"w": "lật", "s": 3.965, "e": 4.146}, {"w": "tẩy.", "s": 4.183, "e": 4.365}]}, {"text": "Sao hài lòng một tới năm, hạng thành viên đồng bạc vàng kim cương, đều có thứ tự rõ ràng.", "start": 4.455, "end": 9.165, "words": [{"w": "Sao", "s": 4.455, "e": 4.728}, {"w": "hài", "s": 4.765, "e": 4.874}, {"w": "lòng", "s": 4.917, "e": 5.092}, {"w": "một", "s": 5.146, "e": 5.31}, {"w": "tới", "s": 5.365, "e": 5.528}, {"w": "năm,", "s": 5.565, "e": 5.892}, {"w": "hạng", "s": 5.921, "e": 6.037}, {"w": "thành", "s": 6.074, "e": 6.255}, {"w": "viên", "s": 6.285, "e": 6.401}, {"w": "đồng", "s": 6.445, "e": 6.619}, {"w": "bạc", "s": 6.692, "e": 6.91}, {"w": "vàng", "s": 6.983, "e": 7.274}, {"w": "kim", "s": 7.346, "e": 7.565}, {"w": "cương,", "s": 7.601, "e": 7.855}, {"w": "đều", "s": 7.946, "e": 8.219}, {"w": "có", "s": 8.244, "e": 8.292}, {"w": "thứ", "s": 8.346, "e": 8.51}, {"w": "tự", "s": 8.558, "e": 8.655}, {"w": "rõ", "s": 8.728, "e": 8.874}, {"w": "ràng.", "s": 8.917, "e": 9.165}]}, {"text": "Năm sao thì hơn bốn sao, cái đó ai cũng biết.", "start": 9.237, "end": 12.001, "words": [{"w": "Năm", "s": 9.237, "e": 9.455}, {"w": "sao", "s": 9.546, "e": 9.819}, {"w": "thì", "s": 9.874, "e": 10.037}, {"w": "hơn", "s": 10.092, "e": 10.255}, {"w": "bốn", "s": 10.292, "e": 10.401}, {"w": "sao,", "s": 10.492, "e": 10.91}, {"w": "cái", "s": 10.946, "e": 11.055}, {"w": "đó", "s": 11.128, "e": 11.274}, {"w": "ai", "s": 11.346, "e": 11.492}, {"w": "cũng", "s": 11.535, "e": 11.71}, {"w": "biết.", "s": 11.754, "e": 12.001}]}, {"text": "Nhưng khoảng cách giữa các bậc không đều nhau.", "start": 12.062, "end": 14.437, "words": [{"w": "Nhưng", "s": 12.062, "e": 12.365}, {"w": "khoảng", "s": 12.395, "e": 12.583}, {"w": "cách", "s": 12.626, "e": 12.801}, {"w": "giữa", "s": 12.859, "e": 13.092}, {"w": "các", "s": 13.146, "e": 13.31}, {"w": "bậc", "s": 13.365, "e": 13.528}, {"w": "không", "s": 13.576, "e": 13.819}, {"w": "đều", "s": 13.855, "e": 13.965}, {"w": "nhau.", "s": 14.023, "e": 14.437}]}, {"text": "Từ rất ghét lên ghét, trong đầu ông khách