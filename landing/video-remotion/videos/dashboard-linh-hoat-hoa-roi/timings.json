": "đẹp.", "s": 13.073, "e": 13.309}]}, {"text": "Một cái dashboard trả lời được cả nghìn câu hỏi.", "start": 13.382, "end": 15.491, "words": [{"w": "Một", "s": 13.382, "e": 13.6}, {"w": "cái", "s": 13.636, "e": 13.745}, {"w": "dashboard", "s": 13.789, "e": 14.182}, {"w": "trả", "s": 14.218, "e": 14.327}, {"w": "lời", "s": 14.364, "e": 14.473}, {"w": "được", "s": 14.502, "e": 14.618}, {"w": "cả", "s": 14.666, "e": 14.764}, {"w": "nghìn", "s": 14.8, "e": 14.982}, {"w": "câu", "s": 15.036, "e": 15.2}, {"w": "hỏi.", "s": 15.255, "e": 15.491}]}, {"text": "Mình nghĩ mình vừa trao cho họ chiếc chìa khoá vạn năng.", "start": 15.745, "end": 18.545, "words": [{"w": "Mình", "s": 15.745, "e": 16.073}, {"w": "nghĩ", "s": 16.116, "e": 16.291}, {"w": "mình", "s": 16.349, "e": 16.582}, {"w": "vừa", "s": 16.636, "e": 16.8}, {"w": "trao", "s": 16.844, "e": 17.018}, {"w": "cho", "s": 17.055, "e": 17.164}, {"w": "họ", "s": 17.236, "e": 17.382}, {"w": "chiếc", "s": 17.418, "e": 17.6}, {"w": "chìa", "s": 17.648, "e": 17.891}, {"w": "khoá", "s": 17.909, "e": 18.036}, {"w": "vạn", "s": 18.109, "e": 18.255}, {"w": "năng.", "s": 18.298, "e": 18.545}]}], "02": [{"text": "Vấn đề là...", "start": 0.0, "end": 0.727, "words": [{"w": "Vấn", "s": 0.0, "e": 0.182}, {"w": "đề", "s": 0.218, "e": 0.291}, {"w": "là...", "s": 0.412, "e": 0.727}]}, {"text": "chiếc chìa khoá vạn năng đó, đa số người dùng không biết cắm vào ổ nào.", "start": 0.861, "end": 4.509, "words": [{"w": "chiếc", "s": 0.861, "e": 1.527}, {"w": "chìa", "s": 1.575, "e": 1.745}, {"w": "khoá", "s": 1.764, "e": 1.891}, {"w": "vạn", "s": 1.927, "e": 2.036}, {"w": "năng", "s": 2.065, "e": 2.182}, {"w": "đó,", "s": 2.255, "e": 2.691}, {"w": "đa", "s": 2.739, "e": 2.836}, {"w": "số", "s": 2.885, "e": 2.982}, {"w": "người", "s": 3.018, "e": 3.2}, {"w": "dùng", "s": 3.229, "e": 3.345}, {"w": "không", "s": 3.382, "e": 3.564}, {"w": "biết", "s": 3.607, "e": 3.782}, {"w": "cắm", "s": 3.818, "e": 3.927}, {"w": "vào", "s": 3.964, "e": 4.073}, {"w":