{"00": [{"text": "Lái xe bằng", "start": 0.0, "end": 0.89, "words": [{"w": "Lái", "s": 0.0, "e": 0.297}, {"w": "xe", "s": 0.297, "e": 0.593}, {"w": "bằng", "s": 0.593, "e": 0.89}]}, {"text": "gương chiếu hậu.", "start": 0.89, "end": 1.78, "words": [{"w": "gương", "s": 0.89, "e": 1.187}, {"w": "chiếu", "s": 1.187, "e": 1.483}, {"w": "hậu.", "s": 1.483, "e": 1.78}]}, {"text": "Nghe vô lý đúng không?", "start": 1.78, "end": 3.263, "words": [{"w": "Nghe", "s": 1.78, "e": 2.076}, {"w": "vô", "s": 2.076, "e": 2.373}, {"w": "lý", "s": 2.373, "e": 2.67}, {"w": "đúng", "s": 2.67, "e": 2.966}, {"w": "không?", "s": 2.966, "e": 3.263}]}, {"text": "Vậy mà nhiều người", "start": 3.263, "end": 4.449, "words": [{"w": "Vậy", "s": 3.263, "e": 3.56}, {"w": "mà", "s": 3.56, "e": 3.856}, {"w": "nhiều", "s": 3.856, "e": 4.153}, {"w": "người", "s": 4.153, "e": 4.449}]}, {"text": "đang lái cả công", "start": 4.449, "end": 5.636, "words": [{"w": "đang", "s": 4.449, "e": 4.746}, {"w": "lái", "s": 4.746, "e": 5.043}, {"w": "cả", "s": 5.043, "e": 5.339}, {"w": "công", "s": 5.339, "e": 5.636}]}, {"text": "ty y hệt vậy:", "start": 5.636, "end": 6.822, "words": [{"w": "ty", "s": 5.636, "e": 5.933}, {"w": "y", "s": 5.933, "e": 6.229}, {"w": "hệt", "s": 6.229, "e": 6.526}, {"w": "vậy:", "s": 6.526, "e": 6.822}]}, {"text": "mở báo cáo doanh thu", "start": 6.822, "end": 8.306, "words": [{"w": "mở", "s": 6.822, "e": 7.119}, {"w": "báo", "s": 7.119, "e": 7.416}, {"w": "cáo", "s": 7.416, "e": 7.712}, {"w": "doanh", "s": 7.712, "e": 8.009}, {"w": "thu", "s": 8.009, "e": 8.306}]}, {"text": "quý rồi mới quyết.", "start": 8.306, "end": 9.492, "words": [{"w": "quý", "s": 8.306, "e": 8.602}, {"w": "rồi", "s": 8.602, "e": 8.899}, {"w": "mới", "s": 8.899, "e": 9.195}, {"w": "quyết.", "s": 9.195, "e": 9.492}]}, {"text": "Cuối tháng ba, chủ một", "start": 9.492, "end": 10.975, "words": [{"w": "Cuối", "s": 9.492, "e": 9.789}, {"w": "tháng", "s": 9.789, "e": 10.085}, {"w": "ba,", "s": 10.085, "e": 10.382}, {"w": "chủ", "s": 10.382, "e": 10.679}, {"w": "một", "s": 10.679, "e": 10.975}]}, {"text": "chuỗi cà phê ở Hà", "start": 10.975, "end": 12.458, "words": [{"w": "chuỗi", "s": 10.975, "e": 11.272}, {"w": "cà", "s": 11.272, "e": 11.568}, {"w": "phê", "s": 11.568, "e": 11.865}, {"w": "ở", "s": 11.865, "e": 12.162}, {"w": "Hà", "s": 12.162, "e": 12.458}]}, {"text": "Nội thấy doanh thu quý", "start": 12.458, "end": 13.941, "words": [{"w": "Nội", "s": 12.458, "e": 12.755}, {"w": "thấy", "s": 12.755, "e": 13.052}, {"w": "doanh", "s": 13.052, "e": 13.348}, {"w": "thu", "s": 13.348, "e": 13.645}, {"w": "quý", "s": 13.645, "e": 13.941}]}, {"text": "tụt mười tám phần trăm.", "start": 13.941, "end": 15.425, "words": [{"w": "tụt", "s": 13.941, "e": 14.238}, {"w": "mười", "s": 14.238, "e": 14.535}, {"w": "tám", "s": 14.535, "e": 14.831}, {"w": "phần", "s": 14.831, "e": 15.128}, {"w": "trăm.", "s": 15.128, "e": 15.425}]}, {"text": "Anh họp gấp, cắt", "start": 15.425, "end": 16.611, "words": [{"w": "Anh", "s": 15.425, "e": 15.721}, {"w": "họp", "s": 15.721, "e": 16.018}, {"w": "gấp,", "s": 16.018, "e": 16.315}, {"w": "cắt", "s": 16.315, "e": 16.611}]}, {"text": "khuyến mãi, đổi menu.", "start": 16.611, "end": 17.798, "words": [{"w": "khuyến", "s": 16.611, "e": 16.908}, {"w": "mãi,", "s": 16.908, "e": 17.204}, {"w": "đổi", "s": 17.204, "e": 17.501}, {"w": "menu.", "s": 17.501, "e": 17.798}]}, {"text": "Nhưng con số vừa đập", "start": 17.798, "end": 19.281, "words": [{"w": "Nhưng", "s": 17.798, "e": 18.094}, {"w": "con", "s": 18.094, "e": 18.391}, {"w": "số", "s": 18.391, "e": 18.688}, {"w": "vừa", "s": 18.688, "e": 18.984}, {"w": "đập", "s": 18.984, "e": 19.281}]}, {"text": "vào mắt anh, là tin", "start": 19.281, "end": 20.764, "words": [{"w": "vào", "s": 19.281, "e": 19.577}, {"w": "mắt", "s": 19.577, "e": 19.874}, {"w": "anh,", "s": 19.874, "e": 20.171}, {"w": "là", "s": 20.171, "e": 20.467}, {"w": "tin", "s": 20.467, "e": 20.764}]}, {"text": "của ba tháng trước rồi.", "start": 20.764, "end": 22.247, "words": [{"w": "của", "s": 20.764, "e": 21.061}, {"w": "ba", "s": 21.061, "e": 21.357}, {"w": "tháng", "s": 21.357, "e": 21.654}, {"w": "trước", "s": 21.654, "e": 21.95}, {"w": "rồi.", "s": 21.95, "e": 22.247}]}], "01": [{"text": "Khách bắt đầu thưa", "start": 0.0, "end": 1.133, "words": [{"w": "Khách", "s": 0.0, "e": 0.283}, {"w": "bắt", "s": 0.283, "e": 0.566}, {"w": "đầu", "s": 0.566, "e": 0.85}, {"w": "thưa", "s": 0.85, "e": 1.133}]}, {"text": "từ giữa tháng một.", "start": 1.133, "end": 2.266, "words": [{"w": "từ", "s": 1.133, "e": 1.416}, {"w": "giữa", "s": 1.416, "e": 1.699}, {"w": "tháng", "s": 1.699, "e": 1.983}, {"w": "một.", "s": 1.983, "e": 2.266}]}, {"text": "Ghé ít hơn, ngồi ngắn", "start": 2.266, "end": 3.682, "words": [{"w": "Ghé", "s": 2.266, "e": 2.549}, {"w": "ít", "s": 2.549, "e": 2.832}, {"w": "hơn,", "s": 2.832, "e": 3.116}, {"w": "ngồi", "s": 3.116, "e": 3.399}, {"w": "ngắn", "s": 3.399, "e": 3.682}]}, {"text": "hơn, đơn nhỏ lại.", "start": 3.682, "end": 4.815, "words": [{"w": "hơn,", "s": 3.682, "e": 3.965}, {"w": "đơn", "s": 3.965, "e": 4.249}, {"w": "nhỏ", "s": 4.249, "e": 4.532}, {"w": "lại.", "s": 4.532, "e": 4.815}]}, {"text": "Tín hiệu nằm đó", "start": 4.815, "end": 5.948, "words": [{"w": "Tín", "s": 4.815, "e": 5.098}, {"w": "hiệu", "s": 5.098, "e": 5.381}, {"w": "nằm", "s": 5.381, "e": 5.665}, {"w": "đó", "s": 5.665, "e": 5.948}]}, {"text": "suốt mười tuần.", "start": 5.948, "end": 6.798, "words": [{"w": "suốt", "s": 5.948, "e": 6.231}, {"w": "mười", "s": 6.231, "e": 6.514}, {"w": "tuần.", "s": 6.514, "e": 6.798}]}, {"text": "Chỉ là không", "start": 6.798, "end": 7.647, "words": [{"w": "Chỉ", "s": 6.798, "e": 7.081}, {"w": "là", "s": 7.081, "e": 7.364}, {"w": "không", "s": 7.364, "e": 7.647}]}, {"text": "ai đo nó.", "start": 7.647, "end": 8.497, "words": [{"w": "ai", "s": 7.647, "e": 7.931}, {"w": "đo", "s": 7.931, "e": 8.214}, {"w": "nó.", "s": 8.214, "e": 8.497}]}, {"text": "Tới khi doanh thu", "start": 8.497, "end": 9.63, "words": [{"w": "Tới", "s": 8.497, "e": 8.78}, {"w": "khi", "s": 8.78, "e": 9.064}, {"w": "doanh", "s": 9.064, "e": 9.347}, {"w": "thu", "s": 9.347, "e": 9.63}]}, {"text": "quý chốt sổ, cái", "start": 9.63, "end": 10.763, "words": [{"w": "quý", "s": 9.63, "e": 9.913}, {"w": "chốt", "s": 9.913, "e": 10.196}, {"w": "sổ,", "s": 10.196, "e": 10.48}, {"w": "cái", "s": 10.48, "e": 10.763}]}, {"text": "xe đã trôi qua", "start": 10.763, "end": 11.896, "words": [{"w": "xe", "s": 10.763, "e": 11.046}, {"w": "đã", "s": 11.046, "e": 11.329}, {"w": "trôi", "s": 11.329, "e": 11.613}, {"w": "qua", "s": 11.613, "e": 11.896}]}, {"text": "khúc cua từ lâu.", "start": 11.896, "end": 13.029, "words": [{"w": "khúc", "s": 11.896, "e": 12.179}, {"w": "cua", "s": 12.179, "e": 12.462}, {"w": "từ", "s": 12.462, "e": 12.746}, {"w": "lâu.", "s": 12.746, "e": 13.029}]}, {"text": "Cái bẫy nằm", "start": 13.029, "end": 13.879, "words": [{"w": "Cái", "s": 13.029, "e": 13.312}, {"w": "bẫy", "s": 13.312, "e": 13.595}, {"w": "nằm", "s": 13.595, "e": 13.879}]}, {"text": "ở chỗ này:", "start": 13.879, "end": 14.728, "words": [{"w": "ở", "s": 13.879, "e": 14.162}, {"w": "chỗ", "s": 14.162, "e": 14.445}, {"w": "này:", "s": 14.445, "e": 14.728}]}, {"text": "doanh thu quý là", "start": 14.728, "end": 15.861, "words": [{"w": "doanh", "s": 14.728, "e": 15.011}, {"w": "thu", "s": 15.011, "e": 15.295}, {"w": "quý", "s": 15.295, "e": 15.578}, {"w": "là", "s": 15.578, "e": 15.861}]}, {"text": "con số rõ ràng", "start": 15.861, "end": 16.994, "words": [{"w": "con", "s": 15.861, "e": 16.144}, {"w": "số", "s": 16.144, "e": 16.428}, {"w": "rõ", "s": 16.428, "e": 16.711}, {"w": "ràng", "s": 16.711, "e": 16.994}]}, {"text": "nhất, chắc chắn nhất.", "start": 16.994, "end": 18.127, "words": [{"w": "nhất,", "s": 16.994, "e": 17.277}, {"w": "chắc", "s": 17.277, "e": 17.561}, {"w": "chắn", "s": 17.561, "e": 17.844}, {"w": "nhất.", "s": 17.844, "e": 18.127}]}, {"text": "Nên ai cũng", "start": 18.127, "end": 18.977, "words": [{"w": "Nên", "s": 18.127, "e": 18.41}, {"w": "ai", "s": 18.41, "e": 18.694}, {"w": "cũng", "s": 18.694, "e": 18.977}]}, {"text": "dán mắt vào.", "start": 18.977, "end": 19.826, "words": [{"w": "dán", "s": 18.977, "e": 19.26}, {"w": "mắt", "s": 19.26, "e": 19.543}, {"w": "vào.", "s": 19.543, "e": 19.826}]}, {"text": "Nhưng lúc nó rõ, thì", "start": 19.826, "end": 21.243, "words": [{"w": "Nhưng", "s": 19.826, "e": 20.11}, {"w": "lúc", "s": 20.11, "e": 20.393}, {"w": "nó", "s": 20.393, "e": 20.676}, {"w": "rõ,", "s": 20.676, "e": 20.959}, {"w": "thì", "s": 20.959, "e": 21.243}]}, {"text": "đã muộn để làm gì.", "start": 21.243, "end": 22.659, "words": [{"w": "đã", "s": 21.243, "e": 21.526}, {"w": "muộn", "s": 21.526, "e": 21.809}, {"w": "để", "s": 21.809, "e": 22.092}, {"w": "làm", "s": 22.092, "e": 22.376}, {"w": "gì.", "s": 22.376, "e": 22.659}]}], "02": [{"text": "Mọi chỉ số bạn", "start": 0.0, "end": 1.158, "words": [{"w": "Mọi", "s": 0.0, "e": 0.289}, {"w": "chỉ", "s": 0.289, "e": 0.579}, {"w": "số", "s": 0.579, "e": 0.868}, {"w": "bạn", "s": 0.868, "e": 1.158}]}, {"text": "theo dõi rơi vào", "start": 1.158, "end": 2.315, "words": [{"w": "theo", "s": 1.158, "e": 1.447}, {"w": "dõi", "s": 1.447, "e": 1.737}, {"w": "rơi", "s": 1.737, "e": 2.026}, {"w": "vào", "s": 2.026, "e": 2.315}]}, {"text": "một trong hai loại.", "start": 2.315, "end": 3.473, "words": [{"w": "một", "s": 2.315, "e": 2.605}, {"w": "trong", "s": 2.605, "e": 2.894}, {"w": "hai", "s": 2.894, "e": 3.184}, {"w": "loại.", "s": 3.184, "e": 3.473}]}, {"text": "Loại thứ nhất là", "start": 3.473, "end": 4.631, "words": [{"w": "Loại", "s": 3.473, "e": 3.763}, {"w": "thứ", "s": 3.763, "e": 4.052}, {"w": "nhất", "s": 4.052, "e": 4.341}, {"w": "là", "s": 4.341, "e": 4.631}]}, {"text": "cái đã rồi.", "start": 4.631, "end": 5.499, "words": [{"w": "cái", "s": 4.631, "e": 4.92}, {"w": "đã", "s": 4.92, "e": 5.21}, {"w": "rồi.", "s": 5.21, "e": 5.499}]}, {"text": "Doanh thu quý, lợi", "start": 5.499, "end": 6.65