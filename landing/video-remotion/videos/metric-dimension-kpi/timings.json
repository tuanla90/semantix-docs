": 17.1, "e": 17.267}, {"w": "lại", "s": 17.317, "e": 17.467}, {"w": "đứa", "s": 17.533, "e": 17.733}, {"w": "nào", "s": 17.75, "e": 17.8}, {"w": "tính", "s": 17.827, "e": 17.933}, {"w": "sai?", "s": 18.0, "e": 18.267}]}, {"text": "Câu trả lời sẽ làm bạn bất ngờ.", "start": 18.367, "end": 19.867, "words": [{"w": "Câu", "s": 18.367, "e": 18.533}, {"w": "trả", "s": 18.583, "e": 18.733}, {"w": "lời", "s": 18.783, "e": 18.933}, {"w": "sẽ", "s": 18.977, "e": 19.067}, {"w": "làm", "s": 19.117, "e": 19.267}, {"w": "bạn", "s": 19.317, "e": 19.467}, {"w": "bất", "s": 19.5, "e": 19.6}, {"w": "ngờ.", "s": 19.65, "e": 19.867}]}, {"text": "Sự thật là...", "start": 19.967, "end": 20.904, "words": [{"w": "Sự", "s": 20.174, "e": 20.204}, {"w": "thật", "s": 20.244, "e": 20.404}, {"w": "là...", "s": 20.515, "e": 20.904}]}, {"text": "Chẳng ai sai cả.", "start": 20.96, "end": 21.938, "words": [{"w": "Chẳng", "s": 20.96, "e": 21.137}, {"w": "ai", "s": 21.204, "e": 21.338}, {"w": "sai", "s": 21.387, "e": 21.538}, {"w": "cả.", "s": 21.582, "e": 21.938}]}], "01": [{"text": "Lý do hai báo cáo lệch nhau, gần như không bao giờ là cộng sai.", "start": 0.0, "end": 2.933, "words": [{"w": "Lý", "s": 0.0, "e": 0.133}, {"w": "do", "s": 0.177, "e": 0.267}, {"w": "hai", "s": 0.317, "e": 0.467}, {"w": "báo", "s": 0.55, "e": 0.8}, {"w": "cáo", "s": 0.833, "e": 0.933}, {"w": "lệch", "s": 0.978, "e": 1.133}, {"w": "nhau,", "s": 1.173, "e": 1.533}, {"w": "gần", "s": 1.583, "e": 1.733}, {"w": "như", "s": 1.767, "e": 1.867}, {"w": "không", "s": 1.889, "e": 2.0}, {"w": "bao", "s": 2.033, "e": 2.133}, {"w": "giờ", "s": 2.183, "e": 2.333}, {"w": "là", "s": 2.356, "e": 2.4}, {"w": "cộng", "s": 2.44, "e": 2.6}, {"w": "sai.", "s": 2.667, "e": 2.933}]}, {"text": "Mà là ba người đang gọi ba thứ khác nhau, bằng đúng một từ.", "start": 3.167, "end": 6.2, "words": [{"w": "Mà", "s": 3.167, "e": 3.467}, {"w": "là", "s": 3.489, "e": 3.533}, {"w": "ba", "s": 3.6, "e": 3.733}, {"w": "người", "s": 3.789, "e": 4.067}, {"w": 