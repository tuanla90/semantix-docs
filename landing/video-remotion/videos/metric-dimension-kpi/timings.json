{"00": [{"text": "Sáng thứ Hai, phòng họp căng như dây đàn.", "start": 0.0, "end": 1.733, "words": [{"w": "Sáng", "s": 0.0, "e": 0.133}, {"w": "thứ", "s": 0.167, "e": 0.267}, {"w": "Hai,", "s": 0.317, "e": 0.533}, {"w": "phòng", "s": 0.578, "e": 0.8}, {"w": "họp", "s": 0.85, "e": 1.0}, {"w": "căng", "s": 1.044, "e": 1.2}, {"w": "như", "s": 1.233, "e": 1.333}, {"w": "dây", "s": 1.367, "e": 1.467}, {"w": "đàn.", "s": 1.517, "e": 1.733}]}, {"text": "Sếp gõ tay xuống bàn, hỏi đúng một câu:", "start": 1.867, "end": 3.6, "words": [{"w": "Sếp", "s": 1.867, "e": 2.067}, {"w": "gõ", "s": 2.1, "e": 2.2}, {"w": "tay", "s": 2.25, "e": 2.4}, {"w": "xuống", "s": 2.423, "e": 2.533}, {"w": "bàn,", "s": 2.583, "e": 2.867}, {"w": "hỏi", "s": 2.9, "e": 3.0}, {"w": "đúng", "s": 3.027, "e": 3.133}, {"w": "một", "s": 3.167, "e": 3.267}, {"w": "câu:", "s": 3.317, "e": 3.6}]}, {"text": "Chốt lại, doanh thu tháng này bao nhiêu?", "start": 3.711, "end": 5.533, "words": [{"w": "Chốt", "s": 3.711, "e": 4.0}, {"w": "lại,", "s": 4.033, "e": 4.333}, {"w": "doanh", "s": 4.356, "e": 4.467}, {"w": "thu", "s": 4.517, "e": 4.667}, {"w": "tháng", "s": 4.689, "e": 4.8}, {"w": "này", "s": 4.833, "e": 4.933}, {"w": "bao", "s": 4.967, "e": 5.067}, {"w": "nhiêu?", "s": 5.111, "e": 5.533}]}, {"text": "Anh trưởng phòng Sales tự tin đáp:", "start": 5.583, "end": 7.0, "words": [{"w": "Anh", "s": 5.583, "e": 5.733}, {"w": "trưởng", "s": 5.752, "e": 5.867}, {"w": "phòng", "s": 5.9, "e": 6.067}, {"w": "Sales", "s": 6.111, "e": 6.333}, {"w": "tự", "s": 6.4, "e": 6.533}, {"w": "tin", "s": 6.583, "e": 6.733}, {"w": "đáp:", "s": 6.783, "e": 7.0}]}, {"text": "Dạ, bốn phẩy hai tỷ.", "start": 7.167, "end": 8.267, "words": [{"w": "Dạ,", "s": 7.167, "e": 7.467}, {"w": "bốn", "s": 7.533, "e": 7.733}, {"w": "phẩy", "s": 7.778, "e": 7.933}, {"w": "hai", "s": 7.95, "e": 8.0}, {"w": "tỷ.", "s": 8.067, "e": 8.267}]}, {"text": "Chị Kế toán trưởng nhíu mày, vội nhìn lại file:", "start": 8.4, "end": 10.667, "words": [{"w": "Chị", "