}, {"w": "con", "s": 16.383, "e": 16.533}, {"w": "số", "s": 16.6, "e": 16.733}, {"w": "bạn", "s": 16.767, "e": 16.867}, {"w": "đo", "s": 16.911, "e": 17.0}, {"w": "được.", "s": 17.04, "e": 17.267}]}, {"text": "Dimension là cách bạn cắt con số đó ra để nhìn cho rõ.", "start": 17.367, "end": 21.0, "words": [{"w": "Dimension", "s": 17.367, "e": 18.267}, {"w": "là", "s": 18.356, "e": 18.533}, {"w": "cách", "s": 18.587, "e": 18.8}, {"w": "bạn", "s": 18.85, "e": 19.0}, {"w": "cắt", "s": 19.05, "e": 19.2}, {"w": "con", "s": 19.25, "e": 19.4}, {"w": "số", "s": 19.467, "e": 19.6}, {"w": "đó", "s": 19.644, "e": 19.733}, {"w": "ra", "s": 19.8, "e": 19.933}, {"w": "để", "s": 20.044, "e": 20.267}, {"w": "nhìn", "s": 20.307, "e": 20.467}, {"w": "cho", "s": 20.517, "e": 20.667}, {"w": "rõ.", "s": 20.733, "e": 21.0}]}, {"text": "Còn KPI là chính con số đó, nhưng gắn thêm một cái đích phải chạm tới.", "start": 21.233, "end": 25.4, "words": [{"w": "Còn", "s": 21.233, "e": 21.533}, {"w": "KPI", "s": 21.667, "e": 22.2}, {"w": "là", "s": 22.267, "e": 22.4}, {"w": "chính", "s": 22.444, "e": 22.667}, {"w": "con", "s": 22.717, "e": 22.867}, {"w": "số", "s": 22.911, "e": 23.0}, {"w": "đó,", "s": 23.067, "e": 23.4}, {"w": "nhưng", "s": 23.433, "e": 23.6}, {"w": "gắn", "s": 23.683, "e": 23.933}, {"w": "thêm", "s": 23.973, "e": 24.133}, {"w": "một", "s": 24.167, "e": 24.267}, {"w": "cái", "s": 24.3, "e": 24.4}, {"w": "đích", "s": 24.427, "e": 24.533}, {"w": "phải", "s": 24.587, "e": 24.8}, {"w": "chạm", "s": 24.844, "e": 25.0}, {"w": "tới.", "s": 25.067, "e": 25.4}]}], "02": [{"text": "Metric, hiểu đơn giản, là cái thứ bạn đong đếm được thành số.", "start": 0.0, "end": 3.0, "words": [{"w": "Metric,", "s": 0.0, "e": 0.467}, {"w": "hiểu", "s": 0.493, "e": 0.6}, {"w": "đơn", "s": 0.65, "e": 0.8}, {"w": "giản,", "s": 0.84, "e": 1.167}, {"w": "là", "s": 1.223, "e": 1.333}, {"w": "cái", "s": 1.383, "e": 1.533}, {"w": "thứ", "s": 1.583, "e": 1.733}, {"w": "bạn", "s": 1.8, "e": 2.0}, {"w": "đong", "s"