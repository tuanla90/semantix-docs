{"00": [{"text": "Sáng thứ Hai, phòng họp.", "start": 0.0, "end": 1.571, "words": [{"w": "Sáng", "s": 0.0, "e": 0.314}, {"w": "thứ", "s": 0.314, "e": 0.628}, {"w": "Hai,", "s": 0.628, "e": 0.942}, {"w": "phòng", "s": 0.942, "e": 1.257}, {"w": "họp.", "s": 1.257, "e": 1.571}]}, {"text": "Bạn khoe tỷ lệ chốt", "start": 1.571, "end": 3.141, "words": [{"w": "Bạn", "s": 1.571, "e": 1.885}, {"w": "khoe", "s": 1.885, "e": 2.199}, {"w": "tỷ", "s": 2.199, "e": 2.513}, {"w": "lệ", "s": 2.513, "e": 2.827}, {"w": "chốt", "s": 2.827, "e": 3.141}]}, {"text": "đơn nhích từ mười tám", "start": 3.141, "end": 4.712, "words": [{"w": "đơn", "s": 3.141, "e": 3.455}, {"w": "nhích", "s": 3.455, "e": 3.77}, {"w": "từ", "s": 3.77, "e": 4.084}, {"w": "mười", "s": 4.084, "e": 4.398}, {"w": "tám", "s": 4.398, "e": 4.712}]}, {"text": "phần trăm lên hai mươi", "start": 4.712, "end": 6.283, "words": [{"w": "phần", "s": 4.712, "e": 5.026}, {"w": "trăm", "s": 5.026, "e": 5.34}, {"w": "lên", "s": 5.34, "e": 5.654}, {"w": "hai", "s": 5.654, "e": 5.969}, {"w": "mươi", "s": 5.969, "e": 6.283}]}, {"text": "hai phần trăm.", "start": 6.283, "end": 7.225, "words": [{"w": "hai", "s": 6.283, "e": 6.597}, {"w": "phần", "s": 6.597, "e": 6.911}, {"w": "trăm.", "s": 6.911, "e": 7.225}]}, {"text": "Bạn viết trong báo cáo:", "start": 7.225, "end": 8.796, "words": [{"w": "Bạn", "s": 7.225, "e": 7.539}, {"w": "viết", "s": 7.539, "e": 7.853}, {"w": "trong", "s": 7.853, "e": 8.167}, {"w": "báo", "s": 8.167, "e": 8.482}, {"w": "cáo:", "s": 8.482, "e": 8.796}]}, {"text": "tăng bốn phần trăm.", "start": 8.796, "end": 10.052, "words": [{"w": "tăng", "s": 8.796, "e": 9.11}, {"w": "bốn", "s": 9.11, "e": 9.424}, {"w": "phần", "s": 9.424, "e": 9.738}, {"w": "trăm.", "s": 9.738, "e": 10.052}]}, {"text": "Sếp gật gù, thấy thường.", "start": 10.052, "end": 11.623, "words": [{"w": "Sếp", "s": 10.052, "e": 10.366}, {"w": "gật", "s": 10.366, "e": 10.681}, {"w": "gù,", "s": 10.681, "e": 10.995}, {"w": "thấy", "s": 10.995, "e": 11.309}, {"w": "thường.", "s": 11.309, "e": 11.623}]}, {"text": "Nhưng cái nhích đó, viết", "start": 11.623, "end": 13.194, "words": [{"w": "Nhưng", "s": 11.623, "e": 11.937}, {"w": "cái", "s": 11.937, "e": 12.251}, {"w": "nhích", "s": 12.251, "e": 12.565}, {"w": "đó,", "s": 12.565, "e": 12.879}, {"w": "viết", "s": 12.879, "e": 13.194}]}, {"text": "cho đúng, là tăng hơn", "start": 13.194, "end": 14.764, "words": [{"w": "cho", "s": 13.194, "e": 13.508}, {"w": "đúng,", "s": 13.508, "e": 13.822}, {"w": "là", "s": 13.822, "e": 14.136}, {"w": "tăng", "s": 14.136, "e": 14.45}, {"w": "hơn", "s": 14.45, "e": 14.764}]}, {"text": "hai mươi phần trăm.", "start": 14.764, "end": 16.021, "words": [{"w": "hai", "s": 14.764, "e": 15.078}, {"w": "mươi", "s": 15.078, "e": 15.393}, {"w": "phần", "s": 15.393, "e": 15.707}, {"w": "trăm.", "s": 15.707, "e": 16.021}]}, {"text": "Mười tám lên hai", "start": 16.021, "end": 17.277, "words": [{"w": "Mười", "s": 16.021, "e": 16.335}, {"w": "tám", "s": 16.335, "e": 16.649}, {"w": "lên", "s": 16.649, "e": 16.963}, {"w": "hai", "s": 16.963, "e": 17.277}]}, {"text": "mươi hai, không phải", "start": 17.277, "end": 18.534, "words": [{"w": "mươi", "s": 17.277, "e": 17.591}, {"w": "hai,", "s": 17.591, "e": 17.906}, {"w": "không", "s": 17.906, "e": 18.22}, {"w": "phải", "s": 18.22, "e": 18.534}]}, {"text": "tăng mười phần trăm", "start": 18.534, "end": 19.79, "words": [{"w": "tăng", "s": 18.534, "e": 18.848}, {"w": "mười", "s": 18.848, "e": 19.162}, {"w": "phần", "s": 19.162, "e": 19.476}, {"w": "trăm", "s": 19.476, "e": 19.79}]}, {"text": "như nhiều người tưởng.", "start": 19.79, "end": 21.047, "words": [{"w": "như", "s": 19.79, "e": 20.105}, {"w": "nhiều", "s": 20.105, "e": 20.419}, {"w": "người", "s": 20.419, "e": 20.733}, {"w": "tưởng.", "s": 20.733, "e": 21.047}]}, {"text": "Cùng một con số, hai", "start": 21.047, "end": 22.618, "words": [{"w": "Cùng", "s": 21.047, "e": 21.361}, {"w": "một", "s": 21.361, "e": 21.675}, {"w": "con", "s": 21.675, "e": 21.989}, {"w": "số,", "s": 21.989, "e": 22.303}, {"w": "hai", "s": 22.303, "e": 22.618}]}, {"text": "cách nói, hai số phận.", "start": 22.618, "end": 24.188, "words": [{"w": "cách", "s": 22.618, "e": 22.932}, {"w": "nói,", "s": 22.932, "e": 23.246}, {"w": "hai", "s": 23.246, "e": 23.56}, {"w": "số", "s": 23.56, "e": 23.874}, {"w": "phận.", "s": 23.874, "e": 24.188}]}], "01": [{"text": "Vấn đề nằm ở hai", "start": 0.0, "end": 1.399, "words": [{"w": "Vấn", "s": 0.0, "e": 0.28}, {"w": "đề", "s": 0.28, "e": 0.56}, {"w": "nằm", "s": 0.56, "e": 0.839}, {"w": "ở", "s": 0.839, "e": 1.119}, {"w": "hai", "s": 1.119, "e": 1.399}]}, {"text": "thứ khác nhau cùng trốn", "start": 1.399, "end": 2.798, "words": [{"w": "thứ", "s": 1.399, "e": 1.679}, {"w": "khác", "s": 1.679, "e": 1.959}, {"w": "nhau", "s": 1.959, "e": 2.238}, {"w": "cùng", "s": 2.238, "e": 2.518}, {"w": "trốn", "s": 2.518, "e": 2.798}]}, {"text": "trong một chữ, phần trăm.", "start": 2.798, "end": 4.197, "words": [{"w": "trong", "s": 2.798, "e": 3.078}, {"w": "một", "s": 3.078, "e": 3.358}, {"w": "chữ,", "s": 3.358, "e": 3.637}, {"w": "phần", "s": 3.637, "e": 3.917}, {"w": "trăm.", "s": 3.917, "e": 4.197}]}, {"text": "Cách một:", "start": 4.197, "end": 4.757, "words": [{"w": "Cách", "s": 4.197, "e": 4.477}, {"w": "một:", "s": 4.477, "e": 4.757}]}, {"text": "lấy tỷ lệ mới", "start": 4.757, "end": 5.876, "words": [{"w": "lấy", "s": 4.757, "e": 5.036}, {"w": "tỷ", "s": 5.036, "e": 5.316}, {"w": "lệ", "s": 5.316, "e": 5.596}, {"w": "mới", "s": 5.596, "e": 5.876}]}, {"text": "trừ tỷ lệ cũ.", "start": 5.876, "end": 6.995, "words": [{"w": "trừ", "s": 5.876, "e": 6.156}, {"w": "tỷ", "s": 6.156, "e": 6.435}, {"w": "lệ", "s": 6.435, "e": 6.715}, {"w": "cũ.", "s": 6.715, "e": 6.995}]}, {"text": "Hai mươi hai trừ", "start": 6.995, "end": 8.114, "words": [{"w": "Hai", "s": 6.995, "e": 7.275}, {"w": "mươi", "s": 7.275, "e": 7.555}, {"w": "hai", "s": 7.555, "e": 7.834}, {"w": "trừ", "s": 7.834, "e": 8.114}]}, {"text": "mười tám, ra bốn.", "start": 8.114, "end": 9.233, "words": [{"w": "mười", "s": 8.114, "e": 8.394}, {"w": "tám,", "s": 8.394, "e": 8.674}, {"w": "ra", "s": 8.674, "e": 8.954}, {"w": "bốn.", "s": 8.954, "e": 9.233}]}, {"text": "Cái này gọi là", "start": 9.233, "end": 10.353, "words": [{"w": "Cái", "s": 9.233, "e": 9.513}, {"w": "này", "s": 9.513, "e": 9.793}, {"w": "gọi", "s": 9.793, "e": 10.073}, {"w": "là", "s": 10.073, "e": 10.353}]}, {"text": "điểm phần trăm.", "start": 10.353, "end": 11.192, "words": [{"w": "điểm", "s": 10.353, "e": 10.632}, {"w": "phần", "s": 10.632, "e": 10.912}, {"w": "trăm.", "s": 10.912, "e": 11.192}]}, {"text": "Là khoảng cách giữa", "start": 11.192, "end": 12.311, "words": [{"w": "Là", "s": 11.192, "e": 11.472}, {"w": "khoảng", "s": 11.472, "e": 11.752}, {"w": "cách", "s": 11.752, "e": 12.031}, {"w": "giữa", "s": 12.031, "e": 12.311}]}, {"text": "hai tỷ lệ.", "start": 12.311, "end": 13.151, "words": [{"w": "hai", "s": 12.311, "e": 12.591}, {"w": "tỷ", "s": 12.591, "e": 12.871}, {"w": "lệ.", "s": 12.871, "e": 13.151}]}, {"text": "Cách hai:", "start": 13.151, "end": 13.71, "words": [{"w": "Cách", "s": 13.151, "e": 13.43}, {"w": "hai:", "s": 13.43, "e": 13.71}]}, {"text": "bốn đó so với", "start": 13.71, "end": 14.829, "words": [{"w": "bốn", "s": 13.71, "e": 13.99}, {"w": "đó", "s": 13.99, "e": 14.27}, {"w": "so", "s": 14.27, "e": 14.55}, {"w": "với", "s": 14.55, "e": 14.829}]}, {"text": "cái nền mười tám.", "start": 14.829, "end": 15.949, "words": [{"w": "cái", "s": 14.829, "e": 15.109}, {"w": "nền", "s": 15.109, "e": 15.389}, {"w": "mười", "s": 15.389, "e": 15.669}, {"w": "tám.", "s": 15.669, "e": 15.949}]}, {"text": "Bốn chia mười tám, ra", "start": 15.949, "end": 17.348, "words": [{"w": "Bốn", "s": 15.949, "e": 16.228}, {"w": "chia", "s": 16.228, "e": 16.508}, {"w": "mười", "s": 16.508, "e": 16.788}, {"w": "tám,", "s": 16.788, "e": 17.068}, {"w": "ra", "s": 17.068, "e": 17.348}]}, {"text": "hơn hai mươi phần trăm.", "start": 17.348, "end": 18.747, "words": [{"w": "hơn", "s": 17.348, "e": 17.627}, {"w": "hai", "s": 17.627, "e": 17.907}, {"w": "mươi", "s": 17.907, "e": 18.187}, {"w": "phần", "s": 18.187, "e": 18.467}, {"w": "trăm.", "s": 18.467, "e": 18.747}]}, {"text": "Cái này là thay", "start": 18.747, "end": 19.866, "words": [{"w": "Cái", "s": 18.747, "e": 19.026}, {"w": "này", "s": 19.026, "e": 19.306}, {"w": "là", "s": 19.306, "e": 19.586}, {"w": "thay", "s": 19.586, "e": 19.866}]}, {"text": "đổi tương đối.", "start": 19.866, "end": 20.705, "words": [{"w": "đổi", "s": 19.866, "e": 20.146}, {"w": "tương", "s": 20.146, "e": 20.425}, {"w": "đối.", "s": 20.425, "e": 20.705}]}, {"text": "Cả hai đều đúng.", "start": 20.705, "end": 21.824, "words": [{"w": "Cả", "s": 20.705, "e": 20.985}, {"w": "hai", "s": 20.985, "e": 21.265}, {"w": "đều", "s": 21.265, "e": 21.545}, {"w": "đúng.", "s": 21.545, "e": 21.824}]}, {"text": "Nhưng khi bạn nói tăng", "start": 21.824, "end": 23.223, "words": [{"w": "Nhưng", "s": 21.824, "e": 22.104}, {"w": "khi", "s": 22.104, "e": 22.384}, {"w": "bạn", "s": 22.384, "e": 22.664}, {"w": "nói", "s": 22.664, "e": 22.944}, {"w": "tăng", "s": 22.944, "e": 23.223}]}, {"text": "bốn phần trăm, tai người", "start": 23.223, "end": 24.622, "words": [{"w": "bốn", "s": 23.223, "e": 23.503}, {"w": "phần", "s": 23.503, "e": 23.783}, {"w": "trăm,", "s": 23.783, "e": 24.063}, {"w": "tai", "s": 24.063, "e": 24.343}, {"w": "người", "s": 24.343, "e": 24.622}]}, {"text": "nghe hiểu là nhích tí", "start": 24.622, "end": 26.021, "words": [{"w": "nghe", "s": 24.622, "e": 24.902}, {"w": "hiểu", "s": 24.902, "e": 25.182}, {"w": "là", "s": 25.182, "e": 25.462}, {"w": "nhích", "s": 25.462, "e": 25.742}, {"w": "tí", "s": 25.742, "e": 26.021}]}, {"text": "xíu, trong khi tỷ lệ", "start": 26.021, "end": 27.42, "words": [{"w": "xíu,", "s": 26.021, "e": 26.301}, {"w": "trong", "s": 26.301, "e": 26.581}, {"w": "khi", "s": 26.581, "e": 26.861}, {"w": "tỷ", "s": 26.861, "e": 27.141}, {"w": "lệ", "s": 27.141, "e": 27.42}]}, {"te