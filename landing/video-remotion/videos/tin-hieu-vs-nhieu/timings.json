hưng", "s": 5.753, "e": 6.04}, {"w": "bốn", "s": 6.04, "e": 6.328}, {"w": "tuần", "s": 6.328, "e": 6.616}, {"w": "liền", "s": 6.616, "e": 6.903}, {"w": "đều", "s": 6.903, "e": 7.191}]}, {"text": "giảm, mỗi tuần một ít,", "start": 7.191, "end": 8.629, "words": [{"w": "giảm,", "s": 7.191, "e": 7.478}, {"w": "mỗi", "s": 7.478, "e": 7.766}, {"w": "tuần", "s": 7.766, "e": 8.054}, {"w": "một", "s": 8.054, "e": 8.341}, {"w": "ít,", "s": 8.341, "e": 8.629}]}, {"text": "thì khó mà ngẫu nhiên.", "start": 8.629, "end": 10.067, "words": [{"w": "thì", "s": 8.629, "e": 8.917}, {"w": "khó", "s": 8.917, "e": 9.204}, {"w": "mà", "s": 9.204, "e": 9.492}, {"w": "ngẫu", "s": 9.492, "e": 9.779}, {"w": "nhiên.", "s": 9.779, "e": 10.067}]}, {"text": "Giống tung đồng xu ra", "start": 10.067, "end": 11.505, "words": [{"w": "Giống", "s": 10.067, "e": 10.355}, {"w": "tung", "s": 10.355, "e": 10.642}, {"w": "đồng", "s": 10.642, "e": 10.93}, {"w": "xu", "s": 10.93, "e": 11.218}, {"w": "ra", "s": 11.218, "e": 11.505}]}, {"text": "sấp bốn lần liên tiếp.", "start": 11.505, "end": 12.943, "words": [{"w": "sấp", "s": 11.505, "e": 11.793}, {"w": "bốn", "s": 11.793, "e": 12.08}, {"w": "lần", "s": 12.08, "e": 12.368}, {"w": "liên", "s": 12.368, "e": 12.656}, {"w": "tiếp.", "s": 12.656, "e": 12.943}]}, {"text": "Đó là dấu hiệu của", "start": 12.943, "end": 14.382, "words": [{"w": "Đó", "s": 12.943, "e": 13.231}, {"w": "là", "s": 13.231, "e": 13.519}, {"w": "dấu", "s": 13.519, "e": 13.806}, {"w": "hiệu", "s": 13.806, "e": 14.094}, {"w": "của", "s": 14.094, "e": 14.382}]}, {"text": "thay đổi có hệ thống:", "start": 14.382, "end": 15.82, "words": [{"w": "thay", "s": 14.382, "e": 14.669}, {"w": "đổi", "s": 14.669, "e": 14.957}, {"w": "có", "s": 14.957, "e": 15.244}, {"w": "hệ", "s": 15.244, "e": 15.532}, {"w": "thống:", "s": 15.532, "e": 15.82}]}, {"text": "sản phẩm mất sức hút,", "start": 15.82, "end": 17.258, "words": [{"w": "sản", "s": 15.82, "e": 16.107}, {"w": "phẩm", "s": 16.107, "e": 16.395}, {"w": "mất", "s": 16.395, "e": 16.683}, {"w": "sức", "s": 16.683, "e": 16.97}, {"w": "hút,", "s": 16.97, "e": 17.258}]}, {"text": "một kênh chết dần.", "start": 17.258, "end": 18.408, "words": [{"w": "một", "s": 17.258, "e": 17.545}, {"w": "kênh", "s": 17.545, "e": 17.833}, {"w": "chết", "s": 17.833, "e": 18.121}, {"w": "dần.", "s": 18.121, "e": 18.408}]}, {"text": "Trớ trêu là người", "start": 18.408, "end": 19.559, "words": [{"w": "Trớ", "s": 18.408, "e": 18.696}, {"w": "trêu", "s": 18.696, "e": 18.984}, {"w": "là", "s": 18.984, "e": 19.271}, {"w": "người", "s": 19.271, "e": 19.559}]}, {"text": "ta hay làm ngược.", "start": 19.559, "end": 20.709, "words": [{"w": "ta", "s": 19.559, "e": 19.847}, {"w": "hay", "s": 19.847, "e": 20.134}, {"w": "làm", "s": 20.134, "e": 20.422}, {"w": "ngược.", "s": 20.422, "e": 20.709}]}, {"text": "Hoảng vì một cú sốc", "start": 20.709, "end": 22.148, "words": [{"w": "Hoảng", "s": 20.709, "e": 20.997}, {"w": "vì", "s": 20.997, "e": 21.285}, {"w": "một", "s": 21.285, "e": 21.572}, {"w": "cú", "s": 21.572, "e": 21.86}, {"w": "sốc", "s": 21.86, "e": 22.148}]}, {"text": "lẻ, thứ thường tự hồi", "start": 22.148, "end": 23.586, "words": [{"w": "lẻ,", "s": 22.148, "e": 22.435}, {"w": "thứ", "s": 22.435, "e": 22.723}, {"w": "thường", "s": 22.723, "e": 23.01}, {"w": "tự", "s": 23.01, "e": 23.298}, {"w": "hồi", "s": 23.298, "e": 23.586}]}, {"text": "sau một tuần.", "start": 23.586, "end": 24.449, "words": [{"w": "sau", "s": 23.586, "e": 23.873}, {"w": "một", "s": 23.873, "e": 24.161}, {"w": "tuần.", "s": 24.161, "e": 24.449}]}, {"text": "Rồi lại quen dần với", "start": 24.449, "end": 25.887, "words": [{"w": "Rồi", "s": 24.449, "e": 24.736}, {"w": "lại", "s": 24.736, "e": 25.024}, {"w": "quen", "s": 25.024, "e": 25.311}, {"w": "dần", "s": 25.311, "e": 25.599}, {"w": "với", "s": 25.599, "e": 25.887}]}, {"text": "một đà giảm chậm, cho", "start": 25.887, "end": 27.325, "words": [{"w": "một", "s": 25.887, "e": 26.174}, {"w": "đà", "s": 26.174, "e": 26.462},