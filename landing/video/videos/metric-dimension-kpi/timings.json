{"00": [{"text": "Sáng thứ Hai, phòng họp căng như dây đàn.", "start": 0.0, "end": 2.036, "words": [{"w": "Sáng", "s": 0.0, "e": 0.145}, {"w": "thứ", "s": 0.182, "e": 0.291}, {"w": "Hai,", "s": 0.364, "e": 0.8}, {"w": "phòng", "s": 0.836, "e": 1.018}, {"w": "họp", "s": 1.073, "e": 1.236}, {"w": "căng", "s": 1.285, "e": 1.455}, {"w": "như", "s": 1.473, "e": 1.527}, {"w": "dây", "s": 1.564, "e": 1.673}, {"w": "đàn.", "s": 1.745, "e": 2.036}]}, {"text": "Sếp gõ tay xuống bàn, hỏi đúng một câu:", "start": 2.291, "end": 4.509, "words": [{"w": "Sếp", "s": 2.291, "e": 2.618}, {"w": "gõ", "s": 2.655, "e": 2.764}, {"w": "tay", "s": 2.818, "e": 2.982}, {"w": "xuống", "s": 3.006, "e": 3.127}, {"w": "bàn,", "s": 3.2, "e": 3.491}, {"w": "hỏi", "s": 3.582, "e": 3.855}, {"w": "đúng", "s": 3.884, "e": 4.0}, {"w": "một", "s": 4.036, "e": 4.145}, {"w": "câu:", "s": 4.2, "e": 4.509}]}, {"text": "chốt lại, doanh thu tháng này bao nhiêu?", "start": 4.679, "end": 6.618, "words": [{"w": "chốt", "s": 4.679, "e": 5.091}, {"w": "lại,", "s": 5.145, "e": 5.382}, {"w": "doanh", "s": 5.443, "e": 5.745}, {"w": "thu", "s": 5.782, "e": 5.891}, {"w": "tháng", "s": 5.915, "e": 6.036}, {"w": "này", "s": 6.073, "e": 6.182}, {"w": "bao", "s": 6.218, "e": 6.327}, {"w": "nhiêu?", "s": 6.364, "e": 6.618}]}, {"text": "Anh trưởng phòng Sales tự tin đáp:", "start": 6.891, "end": 9.491, "words": [{"w": "Anh", "s": 6.891, "e": 7.709}, {"w": "trưởng", "s": 7.74, "e": 7.927}, {"w": "phòng", "s": 7.964, "e": 8.145}, {"w": "Sales", "s": 8.206, "e": 8.509}, {"w": "tự", "s": 8.582, "e": 8.727}, {"w": "tin", "s": 8.764, "e": 8.873}, {"w": "đáp:", "s": 8.945, "e": 9.491}]}, {"text": "dạ, bốn phẩy hai tỷ.", "start": 9.655, "end": 10.982, "words": [{"w": "dạ,", "s": 9.655, "e": 9.964}, {"w": "bốn", "s": 10.055, "e": 10.327}, {"w": "phẩy", "s": 10.375, "e": 10.545}, {"w": "hai", "s": 10.564, "e": 10.618}, {"w": "tỷ.", "s": 10.715, "e": 10.982}]}, {"text": "Chị kế toán trưởng nhíu mày, nhìn lại file:", "start": 11.297, "en